@page "/investments"
@rendermode InteractiveServer
@using System.Globalization
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@using MiddiFranchi.Domain.Portfolio
@using MiddiFranchi.Domain.Shared
@inject InvestmentWorkspaceService Workspace
@inject NotificationService Notifications
@inject PriceUpdateService PriceUpdates
@inject FilterPreferences Filters
@inject CategoryService CategoriesService
@inject OperationHistoryService History
@inject SectionAppearanceService Appearance

<PageTitle>Investimenti</PageTitle>

<header class="dashboard-header">
    <div>
        <h1 class="account-detail-title">
            <span class="account-avatar investments" aria-hidden="true"><MfIcon Name="@Appearance.Get(AppSection.Investments).Icon" Size="20" /></span>
            Investimenti
        </h1>
    </div>
    <div class="dashboard-header-meta">
        <a class="secondary-button" href="/settings/instruments">
            <MfIcon Name="plus" Size="16" /> Nuovo strumento
        </a>
        <a class="secondary-button" href="/investments/advanced">Statistiche avanzate</a>
    </div>
</header>

@if (_loading)
{
    <section class="card dashboard-loading" aria-live="polite">
        <p class="page-status" role="status">Caricamento degli investimenti…</p>
    </section>
}
else if (_loadError is not null)
{
    <section class="card">
        <p class="alert alert-error" role="alert">@_loadError</p>
        <p class="table-hint">Nessun dato è stato mostrato per evitare valori non affidabili.</p>
        <div class="form-actions">
            <button type="button" class="primary-button" @onclick="LoadAsync">Riprova</button>
        </div>
    </section>
}
else if (_workspace is { } workspace)
{
    @if (workspace.CatalogCount == 0)
    {
        <section class="card">
            <EmptyState Title="Nessuno strumento in catalogo" Icon="chart" />
        </section>
    }
    else
    {
        <div class="investments-kpi-grid five-up investment-summary-grid">
            <StatTile Label="Valore attuale"
                      Hero="@true"
                      Value="@ValueOrUnavailable(workspace.Overview.CurrentValue)" />
            <StatTile Label="Prezzo di carico"
                      Value="@ValueOrUnavailable(workspace.Overview.InvestedCapital)" />
            <StatTile Label="Rendimento"
                      Value="@ResultValue(workspace.Overview.TotalResult)"
                      ValueClass="@ResultClass(workspace.Overview.TotalResult)" />
            <StatTile Label="Rendimento %"
                      Value="@ResultPercentValue(workspace.Overview.TotalResultPercent)"
                      ValueClass="@ResultPercentClass(workspace.Overview.TotalResultPercent)" />
            <StatTile Label="Cedole e dividendi netti"
                      Value="@Format.Money(workspace.NetIncome)" />
        </div>

        @if (workspace.Overview.AssetCount == 0)
        {
            <p class="page-status">
                Nessuna posizione aperta: registra un acquisto per iniziare a calcolare valore e
                rendimento.
            </p>
        }
        else if (!workspace.Overview.IsComplete)
        {
            <div class="alert alert-warning" role="status">
                Il valore complessivo non è calcolabile: mancano dati necessari. Nessun valore è stato
                sostituito con zero.
            </div>
            @if (workspace.Overview.IncompletenessReasons.Count > 0)
            {
                <details class="investment-details">
                    <summary>Motivi dell'incompletezza</summary>
                    <ul class="investment-reasons">
                        @foreach (var reason in workspace.Overview.IncompletenessReasons)
                        {
                            <li>@reason</li>
                        }
                    </ul>
                </details>
            }
        }

        <div class="bento compact-pie-row">
            <InvestmentPerformanceChart Workspace="workspace" ShowPerformanceToggle="false" />

            <section class="card investment-allocation-card" aria-labelledby="investment-allocation-title">
                <div class="section-head">
                    <div>
                        <h2 id="investment-allocation-title"><MfIcon Name="pie" Size="18" /> Per classe di attività</h2>
                    </div>
                </div>

                @if (AllocationSegments.Count == 0)
                {
                    <EmptyState Title="Nessuna posizione valorizzata" Icon="pie" />
                }
                else
                {
                    <div class="alternative-pie-layout">
                        <figure class="alternative-pie-figure">
                            <div class="allocation-donut alternative-pie-donut">
                                <svg viewBox="0 0 42 42" aria-hidden="true" focusable="false"
                                     @onmouseleave="ClearAllocationHover">
                                    <circle class="allocation-track" cx="21" cy="21" r="15.9155"
                                            pathLength="100" />
                                    @foreach (var segment in AllocationSegments)
                                    {
                                        <circle class="expense-pie-segment alternative-pie-segment @(_allocationHover?.Label == segment.Label ? "hovered" : "")"
                                                cx="21" cy="21" r="15.9155"
                                                pathLength="100" transform="rotate(-90 21 21)"
                                                stroke="@segment.Color"
                                                stroke-dasharray="@segment.DashArray"
                                                stroke-dashoffset="@segment.DashOffset"
                                                @onmouseover="() => SetAllocationHover(segment)"
                                                @onclick="() => OpenAllocationDialog(segment)">
                                            <title>@segment.Label: @Format.Money(new Money(segment.Value, Currency.Euro)) (@Format.Percent(segment.Share))</title>
                                        </circle>
                                    }
                                </svg>
                                <div class="allocation-center alternative-pie-center">
                                    @if (_allocationHover is { } hover)
                                    {
                                        <span class="allocation-center-label" style="color: @hover.Color">@hover.Label</span>
                                        <strong class="allocation-center-value">@Format.Money(new Money(hover.Value, Currency.Euro))</strong>
                                        <span class="allocation-center-sub">@Format.Percent(hover.Share)</span>
                                    }
                                    else
                                    {
                                        <span class="allocation-center-label">Totale</span>
                                        <strong class="allocation-center-value">@Format.Money(new Money(AllocationTotal, Currency.Euro))</strong>
                                        <span class="allocation-center-sub">@AllocationSegments.Count classi</span>
                                    }
                                </div>
                            </div>
                            <figcaption class="visually-hidden">
                                Distribuzione del valore attuale per classe di attività.
                            </figcaption>
                        </figure>
                    </div>
                }
            </section>
        </div>

        <section class="card investments-table-card" aria-labelledby="investments-table-title">
            <div class="section-head">
                <div>
                    <h2 id="investments-table-title"><MfIcon Name="list" Size="18" /> Strumenti</h2>
                </div>
                <div class="investment-table-actions">
                    @if (QuotesUpToDate)
                    {
                        <StatusBadge Tone="income" Title="@QuoteStatusTooltip">@QuoteStatusLabel</StatusBadge>
                    }
                    else
                    {
                        <button type="button" class="investment-quote-status-button"
                                title="@QuoteStatusTooltip" aria-haspopup="dialog"
                                @onclick="OpenOutdatedQuotesDialog">
                            <StatusBadge Tone="warning">@QuoteStatusLabel</StatusBadge>
                        </button>
                    }
                    <button type="button" class="secondary-button"
                            disabled="@_updatingAllPrices"
                            @onclick="UpdateAllPricesAsync">
                        <MfIcon Name="refresh" Size="16" />
                        @(_updatingAllPrices ? "Aggiornamento…" : "Aggiorna tutti")
                    </button>
                </div>
            </div>

            <div class="investment-toolbar">
                <div class="category-search investment-search-compact">
                    <MfIcon Name="search" Size="16" />
                    <input type="search" placeholder="Cerca"
                           aria-label="Cerca strumenti" @bind="_search" @bind:event="oninput"
                           @bind:after="PersistFiltersAsync" />
                    @if (!string.IsNullOrWhiteSpace(_search))
                    {
                        <button type="button" class="category-search-clear" aria-label="Azzera ricerca"
                                @onclick="ClearSearch">
                            <MfIcon Name="close" Size="14" />
                        </button>
                    }
                </div>

                <div class="investment-class-pills" role="group" aria-label="Filtra per classe di attività">
                    <button type="button" class="investment-class-pill @(_classFilters.Count == 0 ? "active" : "")"
                            aria-pressed="@(_classFilters.Count == 0 ? "true" : "false")"
                            @onclick="() => SetClassFilter(null)">
                        Tutte
                    </button>
                    @foreach (var assetClass in ClassesPresent)
                    {
                        <button type="button"
                                class="investment-class-pill @(_classFilters.Contains(assetClass) ? "active" : "")"
                                style="@PillStyle(assetClass)"
                                aria-pressed="@(_classFilters.Contains(assetClass) ? "true" : "false")"
                                @onclick="() => SetClassFilter(assetClass)">
                            <span class="investment-class-dot" style="background:@AssetClassPalette.Color(assetClass)"></span>
                            @Format.AssetClassLabel(assetClass)
                        </button>
                    }
                </div>

                <button type="button"
                        class="investment-archived-toggle @(_showArchived ? "active" : "")"
                        aria-pressed="@(_showArchived ? "true" : "false")"
                        @onclick="ToggleShowArchived">
                    @(_showArchived ? "Nascondi archiviati" : "Mostra archiviati")
                </button>
            </div>

            @if (FilteredAssets.Count == 0)
            {
                <EmptyState Title="Nessuno strumento corrisponde ai filtri" Icon="filter" />
            }
            else
            {
                <div class="table-scroll" tabindex="0">
                    <table class="data-table investments-table">
                        <thead>
                            <tr>
                                <th scope="col">
                                    <button type="button" class="investment-sort-button" @onclick="() => ToggleSort(SortColumn.Name)">
                                        Strumento @SortArrow(SortColumn.Name)
                                    </button>
                                </th>
                                <th scope="col" class="num hide-sm">
                                    <button type="button" class="investment-sort-button" @onclick="() => ToggleSort(SortColumn.Quantity)">
                                        Quantità @SortArrow(SortColumn.Quantity)
                                    </button>
                                </th>
                                <th scope="col" class="num hide-sm">
                                    <button type="button" class="investment-sort-button" @onclick="() => ToggleSort(SortColumn.CurrentPrice)">
                                        Prezzo attuale @SortArrow(SortColumn.CurrentPrice)
                                    </button>
                                </th>
                                <th scope="col" class="num hide-sm">
                                    <button type="button" class="investment-sort-button" @onclick="() => ToggleSort(SortColumn.AverageCost)">
                                        Prezzo medio @SortArrow(SortColumn.AverageCost)
                                    </button>
                                </th>
                                <th scope="col" class="num">
                                    <button type="button" class="investment-sort-button" @onclick="() => ToggleSort(SortColumn.CurrentValue)">
                                        Valore attuale @SortArrow(SortColumn.CurrentValue)
                                    </button>
                                </th>
                                <th scope="col" class="num">
                                    <button type="button" class="investment-sort-button" @onclick="() => ToggleSort(SortColumn.TotalResult)">
                                        Rendimento @SortArrow(SortColumn.TotalResult)
                                    </button>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var asset in FilteredAssets)
                            {
                                <tr class="investment-row @(asset.IsArchived ? "archived" : "")">
                                    <td>
                                        <div class="investment-name">
                                            <div class="investment-name-copy">
                                                <a class="investment-name-link"
                                                   href="/investments/instruments/@InstrumentKey(asset.InstrumentId)">
                                                    <strong>@asset.Name</strong>
                                                </a>
                                                <div class="investment-name-meta">
                                                    @if (asset.Symbol is { } symbol)
                                                    {
                                                        <span class="status-chip neutral">@symbol</span>
                                                    }
                                                    <StatusBadge Tone="@AssetClassPalette.Tone(asset.AssetClass)">
                                                        @Format.AssetClassLabel(asset.AssetClass)
                                                    </StatusBadge>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="num hide-sm">@QuantityText(asset)</td>
                                    <td class="num hide-sm">
                                        @if (asset.CurrentUnitPrice is { } currentPrice)
                                        {
                                            <span class="investment-strong">@Format.Money(currentPrice)</span>
                                        }
                                        else
                                        {
                                            <span class="investment-muted">—</span>
                                        }
                                    </td>
                                    <td class="num hide-sm">
                                        @if (asset.AverageCost is { } averageCost)
                                        {
                                            <span class="investment-strong">@Format.Money(averageCost)</span>
                                        }
                                        else
                                        {
                                            <span class="investment-muted">—</span>
                                        }
                                    </td>
                                    <td class="num">
                                        @if (asset.CurrentValue is { } currentValue)
                                        {
                                            <span class="investment-strong">@Format.Money(currentValue)</span>
                                        }
                                        else if (asset.Quantity is not null)
                                        {
                                            <span class="status-chip warning">Non valorizzato</span>
                                        }
                                        else
                                        {
                                            <span class="investment-muted">—</span>
                                        }
                                    </td>
                                    <td class="num">
                                        @if (asset.TotalResult is { } total)
                                        {
                                            <span class="investment-performance @ResultClass(total)">
                                                @Format.MoneySigned(total)
                                                @if (asset.TotalResultPercent is { } percent)
                                                {
                                                    <span class="investment-performance-percent">@Format.SignedPercent(percent)</span>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="investment-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="card investments-table-card investments-coupons-card" aria-labelledby="investments-coupons-title">
            <div class="section-head">
                <div>
                    <h2 id="investments-coupons-title"><MfIcon Name="percent" Size="18" /> Cedole</h2>
                </div>
                @if (_coupons.Count > 0)
                {
                    <StatusBadge Tone="income">@FilteredCoupons.Count</StatusBadge>
                }
            </div>

            @if (_coupons.Count == 0)
            {
                <EmptyState Title="Nessuna cedola registrata" Icon="percent" />
            }
            else
            {
                <div class="investment-toolbar coupons-toolbar">
                    <div class="category-search investment-search-compact">
                        <MfIcon Name="search" Size="16" />
                        <input type="search" placeholder="Cerca cedole"
                               aria-label="Cerca cedole" @bind="_couponSearch" @bind:event="oninput"
                               @bind:after="PersistFiltersAsync" />
                        @if (!string.IsNullOrWhiteSpace(_couponSearch))
                        {
                            <button type="button" class="category-search-clear" aria-label="Azzera ricerca cedole"
                                    @onclick="ClearCouponSearch">
                                <MfIcon Name="close" Size="14" />
                            </button>
                        }
                    </div>
                </div>

                @if (FilteredCoupons.Count == 0)
                {
                    <EmptyState Title="Nessuna cedola corrisponde al filtro" Icon="filter" />
                }
                else
                {
                    <div class="table-scroll" tabindex="0">
                        <table class="data-table investments-coupons-table">
                            <thead>
                                <tr>
                                    <SortableTh OnSort="OnCouponSortChangedAsync" Sort="_couponSort" Column="date" Label="Data" />
                                    <SortableTh OnSort="OnCouponSortChangedAsync" Sort="_couponSort" Column="instrument" Label="Strumento" />
                                    <SortableTh OnSort="OnCouponSortChangedAsync" Sort="_couponSort" Column="gross" Label="Lordo" Numeric="true" />
                                    <SortableTh OnSort="OnCouponSortChangedAsync" Sort="_couponSort" Column="net" Label="Netto" Numeric="true" />
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var coupon in FilteredCoupons)
                                {
                                <tr class="movement-row" tabindex="0" title="Apri e modifica"
                                    @onclick="() => OpenCouponAsync(coupon)"
                                    @onkeydown="args => OnCouponKeyDown(args, coupon)">
                                    <td>@Format.Date(coupon.OperationDate)</td>
                                    <td>@(coupon.InstrumentName ?? "—")</td>
                                    <td class="num">@Format.Money(new Money(CouponGross(coupon), Currency.Euro))</td>
                                    <td class="num">@Format.Money(new Money(CouponNet(coupon), Currency.Euro))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                }
            }
        </section>
    }
}

<OutdatedQuotesDialog Open="_outdatedQuotesOpen"
                      Items="OutdatedQuotes"
                      ValuationDate="@(_workspace?.Overview.ValuationDate ?? DateOnly.FromDateTime(DateTime.Today))"
                      OnClose="CloseOutdatedQuotesDialog" />

<InvestmentClassDialog Open="_allocationDialogOpen"
                       AssetClassName="@AllocationDialogClassName"
                       AssetClassColor="@AllocationDialogColor"
                       Items="AllocationDialogItems"
                       OnClose="CloseAllocationDialog" />

<OperationEditDialog Open="_couponEditOpen"
                     Operation="_editingCoupon"
                     Categories="_categories"
                     Instruments="_instrumentOptions"
                     ShowTax="true"
                     OnClose="CloseCouponEdit"
                     OnSaved="OnCouponSaved" />

<InvestmentOperationDialog Open="_investmentDialogOpen"
                           Asset="_investmentAsset"
                           Operation="_investmentOperation"
                           OnClose="CloseInvestmentDialog"
                           OnSaved="OnInvestmentSaved"
                           OnDeleted="OnInvestmentDeleted" />

@code {
    private static readonly string[] InstrumentColors =
    [
        "#8b5cf6",
        "#0c8fa5",
        "#22c55e",
        "#eab308",
        "#ef4444",
        "#64748b",
        "#06b6d4",
    ];

    private InvestmentWorkspace? _workspace;
    private IReadOnlyDictionary<Guid, string> _routeKeys = new Dictionary<Guid, string>();
    private bool _loading = true;
    private string? _loadError;
    private bool _updatingAllPrices;

    private string _search = "";
    private readonly HashSet<AssetClass> _classFilters = [];
    private bool _showArchived;
    private SortColumn _sortColumn = SortColumn.CurrentValue;
    private bool _sortDescending = true;
    private bool _filtersLoaded;
    private AllocationSegment? _allocationHover;
    private bool _allocationDialogOpen;
    private AssetClass? _allocationDialogClass;

    private bool _outdatedQuotesOpen;

    private IReadOnlyList<OperationHistoryRow> _coupons = [];
    private string _couponSearch = "";
    private TableSort _couponSort = new("date", descending: true);
    private IReadOnlyList<Category> _categories = [];
    private IReadOnlyList<InvestmentOption> _instrumentOptions = [];
    private bool _couponEditOpen;
    private OperationHistoryRow? _editingCoupon;
    private InvestmentAssetRow? _investmentAsset;
    private InvestmentOperationRow? _investmentOperation;
    private bool _investmentDialogOpen;

    private enum SortColumn
    {
        Name,
        Quantity,
        CurrentPrice,
        AverageCost,
        CurrentValue,
        TotalResult,
    }

    private sealed record AllocationSegment(
        string Label,
        string Color,
        decimal Value,
        decimal Share,
        string DashArray,
        string DashOffset,
        AssetClass AssetClass);

    private sealed class FilterState
    {
        public string Search { get; set; } = "";
        public string[] Classes { get; set; } = [];
        public bool ShowArchived { get; set; }
        public string SortColumn { get; set; } = "CurrentValue";
        public bool SortDescending { get; set; } = true;
        public string CouponSearch { get; set; } = "";
        public string CouponSortColumn { get; set; } = "date";
        public bool CouponSortDescending { get; set; } = true;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _filtersLoaded)
        {
            return;
        }

        _filtersLoaded = true;
        var state = await Filters.GetAsync<FilterState>("mf.filters.investments");
        if (state is null)
        {
            return;
        }

        _search = state.Search ?? "";
        _classFilters.Clear();
        foreach (var name in state.Classes)
        {
            if (Enum.TryParse<AssetClass>(name, ignoreCase: true, out var assetClass))
            {
                _classFilters.Add(assetClass);
            }
        }

        _showArchived = state.ShowArchived;
        if (Enum.TryParse<SortColumn>(state.SortColumn, ignoreCase: true, out var column))
        {
            _sortColumn = column;
        }

        _sortDescending = state.SortDescending;
        _couponSearch = state.CouponSearch ?? "";
        _couponSort = new TableSort(
            string.IsNullOrWhiteSpace(state.CouponSortColumn) ? "date" : state.CouponSortColumn,
            state.CouponSortDescending);
        await InvokeAsync(StateHasChanged);
    }

    private Task PersistFiltersAsync() => Filters.SetAsync(
        "mf.filters.investments",
        new FilterState
        {
            Search = _search,
            Classes = _classFilters.Select(assetClass => assetClass.ToString()).ToArray(),
            ShowArchived = _showArchived,
            SortColumn = _sortColumn.ToString(),
            SortDescending = _sortDescending,
            CouponSearch = _couponSearch,
            CouponSortColumn = _couponSort.Column,
            CouponSortDescending = _couponSort.Descending,
        });

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _workspace = null;
        _coupons = [];
        _categories = [];
        _instrumentOptions = [];

        try
        {
            var workspace = await Workspace.LoadAsync();
            _workspace = workspace;
            _categories = await CategoriesService.ListAsync();
            _instrumentOptions = workspace.Assets
                .Where(asset => !asset.IsArchived)
                .OrderBy(asset => asset.Name, StringComparer.CurrentCultureIgnoreCase)
                .Select(asset => new InvestmentOption(asset.InstrumentId, asset.Name))
                .ToArray();
            var history = await History.ListAsync();
            _coupons = history
                .Where(row =>
                    row.Kind == OperationKind.Income &&
                    row.Status == OperationStatus.Registered &&
                    string.Equals(row.CategoryName, "Cedole", StringComparison.CurrentCultureIgnoreCase))
                .OrderByDescending(row => row.OperationDate)
                .ThenByDescending(row => row.RecordedAt)
                .ThenByDescending(row => row.Id)
                .ToArray();
            RefreshRouteKeys();
        }
        catch (InvalidOperationException exception)
            when (exception.Message.Contains("connection string", StringComparison.OrdinalIgnoreCase))
        {
            _loadError = "Il database non è configurato. Impostare la connection string 'ConnectionStrings:DefaultConnection' nelle variabili d'ambiente o nei user secrets.";
        }
        catch (Exception)
        {
            _loadError = "Impossibile caricare gli investimenti. Verificare che PostgreSQL sia raggiungibile e che la connection string sia corretta.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static decimal CouponGross(OperationHistoryRow coupon) =>
        coupon.Amount?.Amount ?? 0m;

    private static decimal CouponNet(OperationHistoryRow coupon) =>
        CouponGross(coupon) - (coupon.Tax?.Amount ?? 0m);

    private IReadOnlyList<OperationHistoryRow> FilteredCoupons
    {
        get
        {
            IEnumerable<OperationHistoryRow> rows = _coupons;
            var term = _couponSearch.Trim();
            if (term.Length > 0)
            {
                rows = rows.Where(coupon =>
                    (coupon.InstrumentName ?? "").Contains(term, StringComparison.CurrentCultureIgnoreCase) ||
                    (coupon.Description ?? "").Contains(term, StringComparison.CurrentCultureIgnoreCase) ||
                    Format.Date(coupon.OperationDate).Contains(term, StringComparison.CurrentCultureIgnoreCase) ||
                    coupon.OperationDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                        .Contains(term, StringComparison.CurrentCultureIgnoreCase));
            }

            return _couponSort.Column switch
            {
                "instrument" => _couponSort.Apply(
                    rows,
                    coupon => coupon.InstrumentName ?? "",
                    StringComparer.CurrentCultureIgnoreCase).ToArray(),
                "gross" => _couponSort.Apply(rows, CouponGross).ToArray(),
                "net" => _couponSort.Apply(rows, CouponNet).ToArray(),
                _ => _couponSort.Apply(rows, coupon => coupon.OperationDate).ToArray(),
            };
        }
    }

    private void ClearCouponSearch()
    {
        _couponSearch = "";
        _ = PersistFiltersAsync();
    }

    private async Task OnCouponSortChangedAsync()
    {
        await PersistFiltersAsync();
        StateHasChanged();
    }

    private async Task OpenCouponAsync(OperationHistoryRow coupon)
    {
        if (coupon.IsInvestment)
        {
            await OpenInvestmentCouponAsync(coupon);
            return;
        }

        _editingCoupon = coupon;
        _couponEditOpen = true;
    }

    private async Task OpenInvestmentCouponAsync(OperationHistoryRow coupon)
    {
        var workspace = _workspace ?? await Workspace.LoadAsync();
        var asset = coupon.InstrumentId is { } instrumentId
            ? workspace.Assets.FirstOrDefault(candidate => candidate.InstrumentId == instrumentId)
            : null;
        var operation = asset?.Operations.FirstOrDefault(candidate => candidate.Id == coupon.Id);
        if (asset is null || operation is null)
        {
            await Notifications.Error("Cedola non trovata.");
            return;
        }

        _investmentAsset = asset;
        _investmentOperation = operation;
        _investmentDialogOpen = true;
    }

