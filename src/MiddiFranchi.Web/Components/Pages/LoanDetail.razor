@page "/accounts/{AccountKey}/loans/{LoanKey}"
@rendermode InteractiveServer
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@using MiddiFranchi.Domain.Shared
@inject LoanService LoansService
@inject AccountService AccountsService
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject ChartPreferences Preferences

<PageTitle>@(_loan?.Loan.Borrower ?? "Prestito")</PageTitle>

@if (_loading)
{
    <p class="page-status">Caricamento in corso…</p>
}
else if (_loadError is not null)
{
    <p class="alert alert-error" role="alert">@_loadError</p>
    <p class="page-status"><a class="primary-link" href="accounts/@AccountLinkKey">Torna al conto Prestiti</a></p>
}
else if (_loan is null)
{
    <EmptyState Title="Il prestito richiesto non esiste"
                Hint="Il link può essere errato oppure il prestito è stato eliminato."
                Icon="loan" Href="@($"accounts/{AccountLinkKey}")" ActionLabel="Torna al conto Prestiti" />
}
else
{
    <nav class="balance-back" aria-label="Navigazione locale">
        <a class="primary-link" href="accounts/@AccountLinkKey">
            <MfIcon Name="loan" Size="16" /> @_loan.Loan.Account.Name
        </a>
    </nav>
    <div class="account-detail-header">
        <h1 class="account-detail-title">
            <span class="account-avatar accounts" aria-hidden="true"><MfIcon Name="loan" Size="18" /></span>
            @if (_renaming)
            {
                <input class="inline-edit" type="text" maxlength="200" aria-label="Nome del prestito" @bind="_borrowerName" />
            }
            else
            {
                @_loan.Loan.Borrower
            }
        </h1>
        <div class="form-actions">
            @if (_renaming)
            {
                <button type="button" class="primary-button" disabled="@_savingName" @onclick="SaveNameAsync">Salva</button>
                <button type="button" class="secondary-button" disabled="@_savingName" @onclick="CancelRename">Annulla</button>
            }
            else
            {
                <button type="button" class="icon-button" aria-label="Rinomina prestito" title="Rinomina prestito" @onclick="StartRename">
                    <MfIcon Name="edit" Size="20" />
                </button>
            }
        </div>
    </div>
    @if (_renameError is not null)
    {
        <p class="alert alert-error" role="alert">@_renameError</p>
    }
    <p class="page-intro">
        Prestito del conto @_loan.Loan.Account.Name.
        @if (!_loan.IsActive)
        {
            <StatusBadge Tone="neutral">Estinto</StatusBadge>
        }
    </p>
    <div class="form-actions loan-detail-actions">
        <button type="button" class="primary-button" @onclick="OpenRepaymentDialog">
            <MfIcon Name="cash" Size="18" /> Registra restituzione
        </button>
    </div>

    <section class="card accounts-chart-card" aria-labelledby="loan-chart-title">
        <div class="section-head">
            <div>
                <h2 id="loan-chart-title"><MfIcon Name="chart" Size="18" /> Importo nel tempo</h2>
            </div>
            <div class="overview-ranges" role="group" aria-label="Intervallo temporale">
                @foreach (var option in ChartRanges.Options)
                {
                    <button type="button" class="@ChartRanges.Class(option.Key, _range)" aria-pressed="@AriaPressed(_range == option.Key)" @onclick="() => SetRangeAsync(option.Key)">@option.Label</button>
                }
            </div>
        </div>

        <div class="account-current">
            <div class="balance-main">
                <span class="balance-label">Importo attuale</span>
                <span class="balance-value">
                    <AmountValue Value="@_loan.CurrentAmount" UnavailableText="Nessuna rilevazione" />
                </span>
                @if (_loan.LatestDate is { } latest)
                {
                    <span class="table-hint">rilevato al @Format.Date(latest)</span>
                }
            </div>
        </div>

        @if (HasChartData)
        {
            <ApexTimeSeriesChart Title=""
                                 Currency="@_loan.Loan.Account.Currency"
                                 Series="@Series"
                                 XAxisLabelMode="month"
                                 ShowHeader="false"
                                 ShowFooter="false"
                                 ShowDataTable="false" />
        }
        else
        {
            <EmptyState Title="Servono almeno due rilevazioni nel periodo"
                        Hint="Scegli un intervallo più ampio o registra una nuova rilevazione."
                        Icon="chart" />
        }
    </section>

    <section class="card">
        <div class="section-head">
            <div>
                <h2>Storico</h2>
            </div>
        </div>

        @if (_loan.Readings.Count == 0)
        {
            <EmptyState Title="Nessuna rilevazione registrata"
                        Hint="Usa il pulsante + per registrare la prima rilevazione del prestito."
                        Icon="clock" />
        }
        else
        {
            <div class="table-scroll" tabindex="0">
                <table class="data-table history-table history-table-loan mobile-cards mobile-cards--sortable">
                    <thead>
                        <tr>
                            <SortableTh OnSort="OnHistorySortChangedAsync" Sort="_historySort" Column="date" Label="Data" />
                            <SortableTh OnSort="OnHistorySortChangedAsync" Sort="_historySort" Column="amount" Label="Importo" Numeric="true" />
                            <SortableTh OnSort="OnHistorySortChangedAsync" Sort="_historySort" Column="note" Label="Nota" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reading in SortedReadings)
                        {
                            <tr class="history-row"
                                tabindex="0"
                                title="Clicca per modificare o eliminare"
                                @onclick="() => OpenEditDialog(reading)"
                                @onkeydown="e => HandleRowKeyDown(e, reading)">
                                <td data-label="Data">@Format.Date(reading.ValidAt)</td>
                                <td class="num" data-label="Importo"><AmountValue Value="@reading.Amount" /></td>
                                <td class="history-note" data-label="Nota">@reading.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card">
        <div class="section-head">
            <div>
                <h2><MfIcon Name="alert" Size="18" /> Elimina prestito</h2>
                <p class="section-sub">Il prestito e le sue rilevazioni saranno rimossi. L'operazione non è reversibile.</p>
            </div>
        </div>
        @if (_confirmingDeleteLoan)
        {
            <div class="alert alert-warning" role="alert">
                <div>Eliminare definitivamente il prestito di «@_loan.Loan.Borrower»?</div>
                <div class="form-actions">
                    <button type="button" class="danger-button" disabled="@_deletingLoan" @onclick="DeleteLoanAsync">
                        <MfIcon Name="trash" Size="16" /> Elimina definitivamente
                    </button>
                    <button type="button" class="secondary-button" disabled="@_deletingLoan" @onclick="CancelDeleteLoan">Annulla</button>
                </div>
            </div>
        }
        else
        {
            <button type="button" class="delete-button" @onclick="StartDeleteLoan">
                <MfIcon Name="trash" Size="16" /> Elimina prestito
            </button>
        }
    </section>

    <button type="button" class="fab-add" aria-label="Nuova rilevazione" @onclick="OpenReadingDialog">
        <MfIcon Name="plus" Size="24" />
    </button>

    <LoanReadingDialog Open="_readingDialogOpen"
                       LoanId="@_loan.Loan.Id"
                       Borrower="@_loan.Loan.Borrower"
                       OnClose="CloseReadingDialog"
                       OnSaved="OnReadingSaved" />

    <LoanRepaymentDialog Open="_repaymentDialogOpen"
                         LoanId="@_loan.Loan.Id"
                         Borrower="@_loan.Loan.Borrower"
                         Currency="@_loan.Loan.Account.Currency"
                         Readings="@_loan.Readings"
                         OnClose="CloseRepaymentDialog"
                         OnSaved="OnRepaymentSaved" />

    <LoanReadingEditDialog Open="_editDialogOpen"
                           Reading="_editingReading"
                           OnClose="CloseEditDialog"
                           OnSaved="OnReadingUpdated"
                           OnDeleted="OnReadingDeleted" />
}

@code {
    [Parameter] public string AccountKey { get; set; } = "";

    [Parameter] public string LoanKey { get; set; } = "";

    private Guid _accountId;
    private Guid _loanId;
    private string _canonicalAccountKey = "";
    private string _canonicalLoanKey = "";
    private string? _loadedRoute;
    private LoanOverview? _loan;
    private bool _loading = true;
    private string? _loadError;
    private string _range = "max";
    private bool _preferencesLoaded;
    private bool _readingDialogOpen;
    private bool _repaymentDialogOpen;
    private bool _renaming;
    private string _borrowerName = "";
    private string? _renameError;
    private bool _savingName;
    private bool _editDialogOpen;
    private LoanReading? _editingReading;
    private TableSort _historySort = new("date");
    private bool _confirmingDeleteLoan;
    private bool _deletingLoan;

    private string AccountLinkKey =>
        string.IsNullOrEmpty(_canonicalAccountKey) ? AccountKey : _canonicalAccountKey;

    private IReadOnlyList<TimeSeriesSeries> Series => BuildSeries();

    private IReadOnlyList<LoanReading> SortedReadings =>
        _loan is null
            ? []
            : _historySort.Column switch
            {
                "amount" => _historySort.Apply(_loan.Readings, reading => reading.Amount.Amount).ToArray(),
                "note" => _historySort.Apply(_loan.Readings, reading => reading.Note ?? "").ToArray(),
                _ => _historySort.Apply(_loan.Readings, reading => reading.ValidAt).ToArray(),
            };

    private bool HasChartData => Series.Count > 0;

    private DateOnly? RangeStart =>
        ChartRanges.Start(_range, DateOnly.FromDateTime(DateTime.UtcNow));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _preferencesLoaded)
        {
            return;
        }

        _preferencesLoaded = true;
        var storedRange = await Preferences.GetAsync("mf.chart.loan.range");
        if (storedRange is not null &&
            ChartRanges.Options.Any(option => option.Key == storedRange))
        {
            _range = storedRange;
        }

        var storedSort = await Preferences.GetAsync("mf.filters.loan.historySort");
        if (storedSort is not null)
        {
            var parts = storedSort.Split('|');
            if (parts.Length == 2 && !string.IsNullOrWhiteSpace(parts[0]))
            {
                _historySort = new TableSort(parts[0], parts[1] == "1");
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SetRangeAsync(string range)
    {
        _range = range;
        await Preferences.SetAsync("mf.chart.loan.range", range);
    }

    private async Task OnHistorySortChangedAsync()
    {
        await Preferences.SetAsync(
            "mf.filters.loan.historySort",
            $"{_historySort.Column}|{(_historySort.Descending ? "1" : "0")}");
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        var route = $"{AccountKey}|{LoanKey}";
        if (string.Equals(_loadedRoute, route, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _loadedRoute = route;
        _loading = true;
        await LoadAsync();
        _loading = false;
    }

    private async Task LoadAsync()
    {
        try
        {
            _loadError = null;

            if (!await ResolveRouteAsync())
            {
                _loan = null;
                _canonicalAccountKey = "";
                _canonicalLoanKey = "";
                return;
            }

            await ReloadAsync();
        }
        catch (InvalidOperationException exception) when (exception.Message.Contains("connection string", StringComparison.OrdinalIgnoreCase))
        {
            _loadError = "Il database non è configurato. Impostare la connection string 'ConnectionStrings:DefaultConnection' nelle variabili d'ambiente o nei user secret.";
        }
        catch (Exception)
        {
            _loadError = "Impossibile contattare il database. Verificare che PostgreSQL sia raggiungibile e che la connection string sia corretta.";
        }
    }

    private async Task<bool> ResolveRouteAsync()
    {
        var accounts = await AccountsService.ListAsync();
        var accountKeys = RouteKey.BuildKeys(
            accounts,
            account => account.Id,
            account => account.Name,
            "conto");

        if (Guid.TryParse(AccountKey, out var accountId))
        {
            _accountId = accountId;
        }
        else
        {
            _accountId = accountKeys
                .FirstOrDefault(pair =>
                    string.Equals(pair.Value, AccountKey, StringComparison.OrdinalIgnoreCase))
                .Key;
        }

        if (_accountId == Guid.Empty)
        {
            return false;
        }

        var loans = await LoansService.ListForAccountAsync(_accountId);
        var loanKeys = RouteKey.BuildKeys(
            loans,
            loan => loan.Loan.Id,
            loan => loan.Loan.Borrower,
            "prestito");

        if (Guid.TryParse(LoanKey, out var loanId))
        {
            _loanId = loanId;
        }
        else
        {
            _loanId = loanKeys
                .FirstOrDefault(pair =>
                    string.Equals(pair.Value, LoanKey, StringComparison.OrdinalIgnoreCase))
                .Key;
        }

        if (_loanId == Guid.Empty)
        {
            return false;
        }

        _canonicalAccountKey = accountKeys.TryGetValue(_accountId, out var accountKey)
            ? accountKey
            : RouteKey.From(AccountKey, "conto");
        _canonicalLoanKey = loanKeys.TryGetValue(_loanId, out var loanKey)
            ? loanKey
            : RouteKey.From(LoanKey, "prestito");
        return true;
    }

    private async Task ReloadAsync()
    {
        _loan = await LoansService.GetAsync(_loanId);

        if (_loan is null)
        {
            _canonicalAccountKey = "";
            _canonicalLoanKey = "";
            return;
        }

        if (_loan.Loan.AccountId != _accountId)
        {
            _loan = null;
            _loadError = "Il prestito non appartiene al conto indicato.";
            return;
        }

        var accounts = await AccountsService.ListAsync();
        var accountKeys = RouteKey.BuildKeys(
            accounts,
            account => account.Id,
            account => account.Name,
            "conto");
        _canonicalAccountKey = accountKeys.TryGetValue(_accountId, out var accountKey)
            ? accountKey
            : RouteKey.From(_loan.Loan.Account.Name, "conto");

        var loans = await LoansService.ListForAccountAsync(_accountId);
        var loanKeys = RouteKey.BuildKeys(
            loans,
            loan => loan.Loan.Id,
            loan => loan.Loan.Borrower,
            "prestito");
        _canonicalLoanKey = loanKeys.TryGetValue(_loanId, out var loanKey)
            ? loanKey
            : RouteKey.From(_loan.Loan.Borrower, "prestito");

        var canonicalRoute = $"{_canonicalAccountKey}|{_canonicalLoanKey}";
        if (!string.Equals(
                canonicalRoute,
                $"{AccountKey}|{LoanKey}",
                StringComparison.OrdinalIgnoreCase))
        {
            _loadedRoute = canonicalRoute;
            Navigation.NavigateTo(
                $"accounts/{_canonicalAccountKey}/loans/{_canonicalLoanKey}",
                replace: true);
        }
    }

    private IReadOnlyList<TimeSeriesSeries> BuildSeries()
    {
        if (_loan is null || _loan.Readings.Count == 0)
        {
            return [];
        }

        var start = RangeStart;
        var dates = _loan.Readings
            .Select(reading => reading.ValidAt)
            .Distinct()
            .Where(date => start is null || date >= start.Value)
            .OrderBy(date => date)
            .ToArray();

        if (dates.Length < 2)
        {
            return [];
        }

        var points = dates
            .Select(date => new TimeSeriesPoint(
                date,
                LoanReadings.LatestOnOrBefore(_loan.Readings, _loan.Loan.Id, date)?.Amount.Amount))
            .ToArray();

        return
        [
            new("Importo", points, Color: "#0ea5e9"),
        ];
    }

    private void HandleRowKeyDown(KeyboardEventArgs args, LoanReading reading)
    {
        if (args.Key is "Enter" or " ")
        {
            OpenEditDialog(reading);
        }
    }

    private void OpenEditDialog(LoanReading reading)
    {
        _editingReading = reading;
        _editDialogOpen = true;
    }

    private void CloseEditDialog()
    {
        _editDialogOpen = false;
        _editingReading = null;
    }

    private async Task OnReadingUpdated(LoanReading reading)
    {
        await Notifications.Success("Rilevazione aggiornata.");
        await ReloadAsync();
    }

    private async Task OnReadingDeleted(LoanReading reading)
    {
        await Notifications.Success("Rilevazione eliminata.");
        await ReloadAsync();
    }

    private void OpenReadingDialog() => _readingDialogOpen = true;

    private void CloseReadingDialog() => _readingDialogOpen = false;

    private async Task OnReadingSaved(LoanReading reading)
    {
        await Notifications.Success($"Rilevazione registrata: {Format.Money(reading.Amount)} al {Format.Date(reading.ValidAt)}.");
        await ReloadAsync();
    }

    private void StartRename()
    {
        _borrowerName = _loan?.Loan.Borrower ?? "";
        _renameError = null;
        _renaming = true;
    }

    private void CancelRename()
    {
        _renaming = false;
        _renameError = null;
    }

    private async Task SaveNameAsync()
    {
        if (_savingName || _loan is null)
        {
            return;
        }

        var name = _borrowerName.Trim();
        if (name.Length == 0)
        {
            _renameError = "Il nome del prestito è obbligatorio.";
            return;
        }

        _savingName = true;
        _renameError = null;
        try
        {
            await LoansService.RenameAsync(_loan.Loan.Id, name);
            _renaming = false;
            await Notifications.Success("Nome del prestito aggiornato.");
            await ReloadAsync();
        }
        catch (ArgumentException exception)
        {
            _renameError = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _renameError = exception.Message;
        }
        catch (Exception)
        {
            _renameError = "Rinomina non riuscita: verificare la connessione al database e riprovare.";
        }
        finally
        {
            _savingName = false;
        }
    }

    private void OpenRepaymentDialog() => _repaymentDialogOpen = true;

    private void CloseRepaymentDialog() => _repaymentDialogOpen = false;

    private async Task OnRepaymentSaved(LoanReading reading)
    {
        await Notifications.Success(reading.Amount.Amount == 0m
            ? $"Restituzione registrata: il prestito di {reading.Loan.Borrower} è estinto."
            : $"Restituzione registrata. Nuovo importo dovuto: {Format.Money(reading.Amount)}.");
        await ReloadAsync();
    }

    private void StartDeleteLoan() => _confirmingDeleteLoan = true;

    private void CancelDeleteLoan() => _confirmingDeleteLoan = false;

    private async Task DeleteLoanAsync()
    {
        if (!_confirmingDeleteLoan || _deletingLoan)
        {
            return;
        }

        _deletingLoan = true;
        try
        {
            await LoansService.DeleteLoanAsync(_loanId);
            Navigation.NavigateTo($"accounts/{AccountLinkKey}");
        }
        catch (InvalidOperationException exception)
        {
            await Notifications.Error(exception.Message);
        }
        catch (Exception)
        {
            await Notifications.Error("Eliminazione non riuscita: verificare la connessione al database e riprovare.");
        }
        finally
        {
            _deletingLoan = false;
        }
    }

    private static string AriaPressed(bool value) => value ? "true" : "false";
}
