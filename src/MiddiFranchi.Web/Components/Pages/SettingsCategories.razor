@page "/settings/categories"
@rendermode InteractiveServer
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@using MiddiFranchi.Web.Components.Shared
@inject CategoryService Categories
@inject CategoryAdminService Admin
@inject OperationHistoryService History

<PageTitle>Categorie</PageTitle>

<a class="section-link settings-back" href="/settings">
    <MfIcon Name="arrow-left" Size="16" /> Configurazione
</a>

<div class="dashboard-header">
    <div>
        <h1 class="account-detail-title">
            <span class="account-avatar amber" aria-hidden="true"><MfIcon Name="tag" Size="18" /></span>
            Categorie
        </h1>
    </div>
    @if (!_loading && _loadError is null)
    {
        <div class="dashboard-header-meta">
            <StatusBadge Tone="brand">@(_incomeGroups.Count + _expenseGroups.Count) categorie</StatusBadge>
        </div>
    }
</div>

@if (_loading)
{
    <p class="page-status" role="status">Caricamento delle categorie…</p>
}
else if (_loadError is not null)
{
    <p class="alert alert-error" role="alert">@_loadError</p>
}
else
{
    @if (_message is not null)
    {
        <p class="alert alert-success" role="status">@_message</p>
    }

    <section class="category-workbench @(_activeType == CategoryType.Income ? "income" : "expense")"
             aria-label="Configurazione categorie">
        <div class="category-workbench-bar">
            <div class="category-type-switch" role="tablist" aria-label="Tipo di categoria">
                <button type="button" role="tab" class="@CategoryTypeTabClass(CategoryType.Income)"
                        aria-selected="@(_activeType == CategoryType.Income ? "true" : "false")"
                        @onclick="() => SelectType(CategoryType.Income)">
                    <span class="category-type-icon" aria-hidden="true"><MfIcon Name="trend" Size="17" /></span>
                    <strong>Entrate</strong>
                    <small class="category-type-count">@_incomeGroups.Count</small>
                </button>
                <button type="button" role="tab" class="@CategoryTypeTabClass(CategoryType.Expense)"
                        aria-selected="@(_activeType == CategoryType.Expense ? "true" : "false")"
                        @onclick="() => SelectType(CategoryType.Expense)">
                    <span class="category-type-icon" aria-hidden="true"><MfIcon Name="trend-down" Size="17" /></span>
                    <strong>Uscite</strong>
                    <small class="category-type-count">@_expenseGroups.Count</small>
                </button>
            </div>

            <div class="category-search">
                <MfIcon Name="search" Size="16" />
                <input type="search"
                       aria-label="Cerca categorie e sottocategorie"
                       placeholder="Cerca categoria o sottocategoria…"
                       @bind="_search"
                       @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(_search))
                {
                    <button type="button" class="category-search-clear" aria-label="Azzera ricerca" @onclick="ClearSearch">
                        <MfIcon Name="close" Size="14" />
                    </button>
                }
            </div>

            <button type="button" class="secondary-button category-create-button" @onclick="() => OpenCreate(_activeType)">
                Nuova categoria
            </button>
        </div>

        <div class="category-workbench-grid @(_mobileDetail ? "show-detail" : "")">
            <aside class="category-catalog" aria-label="Catalogo categorie">
                <div class="category-catalog-head">
                    <div>
                        <span class="category-eyebrow">Catalogo</span>
                        <strong>@(_activeType == CategoryType.Income ? "Entrate" : "Uscite")</strong>
                    </div>
                    <StatusBadge Tone="@(_activeType == CategoryType.Income ? "income" : "expense")">@FilteredGroups.Count</StatusBadge>
                </div>

                @if (ActiveGroups.Count == 0)
                {
                    <div class="category-catalog-empty">
                        <MfIcon Name="tag" Size="24" />
                        <p>Nessuna categoria di @ActiveTypeName.</p>
                        <button type="button" class="category-tool" @onclick="() => OpenCreate(_activeType)">
                            <MfIcon Name="plus" Size="14" /> Crea la prima
                        </button>
                    </div>
                }
                else if (FilteredGroups.Count == 0)
                {
                    <div class="category-catalog-empty">
                        <MfIcon Name="search" Size="24" />
                        <p>Nessun risultato per «@_search».</p>
                        <button type="button" class="category-tool" @onclick="ClearSearch">Azzera ricerca</button>
                    </div>
                }
                else
                {
                    <div class="category-catalog-list">
                        @foreach (var group in FilteredGroups)
                        {
                            <button type="button"
                                    class="@(IsSelected(group) ? "category-catalog-item selected" : "category-catalog-item")"
                                    style="--mf-category-color: @CategoryAppearance.ColorFor(group.Primary.ColorHex)"
                                    aria-current="@(IsSelected(group) ? "true" : null)"
                                    @onclick="() => SelectGroup(group)">
                                <span class="category-catalog-mark" aria-hidden="true">
                                    <MfIcon Name="@CategoryAppearance.IconFor(group.Primary.Icon)" Size="17" />
                                </span>
                                <span class="category-catalog-copy">
                                    <strong>@group.Name</strong>
                                    <span>@group.Meta</span>
                                </span>
                                <MfIcon Name="arrow-right" Size="16" />
                            </button>
                        }
                    </div>
                }
            </aside>

            <section class="category-detail" aria-live="polite">
                @if (SelectedGroup is { } selected)
                {
                    <div class="category-detail-hero" style="--mf-category-color: @CategoryAppearance.ColorFor(selected.Primary.ColorHex)">
                        <button type="button" class="category-back" @onclick="ShowCatalog">
                            <MfIcon Name="arrow-left" Size="16" /> Catalogo
                        </button>

                        <div class="category-hero-top">
                            <span class="category-hero-mark" aria-hidden="true">
                                <MfIcon Name="@CategoryAppearance.IconFor(selected.Primary.Icon)" Size="30" />
                            </span>
                            <div class="category-hero-copy">
                                <h2>@selected.Name</h2>
                                <p class="category-hero-meta">
                                    <span>@OperationLabel(selected.OperationCount)</span>
                                    @if (selected.Type == CategoryType.Expense)
                                    {
                                        <span aria-hidden="true">·</span>
                                        <span>@SubcategoryLabel(selected.SubcategoryCount)</span>
                                    }
                                </p>
                                @if (!string.IsNullOrWhiteSpace(selected.Primary.Description))
                                {
                                    <p class="category-hero-description">@selected.Primary.Description</p>
                                }
                            </div>
                            <div class="category-hero-actions">
                                <button type="button" class="category-tool" @onclick="() => OpenMoveGroup(selected)">
                                    <MfIcon Name="transfer" Size="14" /> Sposta
                                </button>
                                <button type="button" class="delete-button" @onclick="() => OpenDeleteGroup(selected)">
                                    <MfIcon Name="trash" Size="14" /> Elimina
                                </button>
                            </div>
                        </div>
                    </div>

                    <form class="category-panel category-config-card" @onsubmit="SaveInlineGroupAsync">
                        <div class="category-panel-head">
                            <div>
                                <h3>Configurazione</h3>
                            </div>
                        </div>
                        <div class="category-config-body">
                            <div class="category-config-fields">
                                <label class="category-field">
                                    <span>Nome *</span>
                                    <input type="text" maxlength="200" required aria-required="true" @bind="_inlineName" />
                                </label>
                                <label class="category-field">
                                    <span>Descrizione</span>
                                    <input type="text" maxlength="200" @bind="_inlineDescription" />
                                </label>
                            </div>

                            <details class="category-appearance">
                                <summary>
                                    <span class="category-appearance-preview" style="--mf-category-color: @_inlineColor" aria-hidden="true">
                                        <MfIcon Name="@_inlineIcon" Size="17" />
                                    </span>
                                    <span class="category-appearance-copy">
                                        <strong>Icona e colore</strong>
                                        <small>Personalizza l'aspetto della categoria</small>
                                    </span>
                                    <MfIcon Name="chevron-down" Size="16" />
                                </summary>
                                <div class="category-appearance-body">
                                    <div class="icon-picker-field">
                                        <span>Icona</span>
                                        <IconPicker @bind-Value="_inlineIcon" Label="Icona della categoria" />
                                    </div>
                                    <div class="color-picker-field">
                                        <span>Colore</span>
                                        <ColorPicker @bind-Value="_inlineColor" Label="Colore della categoria" />
                                    </div>
                                </div>
                            </details>

                            @if (_inlineError is not null)
                            {
                                <p class="alert alert-error" role="alert">@_inlineError</p>
                            }

                            <div class="form-actions">
                                <button type="submit" class="primary-button" disabled="@_inlineSaving">
                                    @if (_inlineSaving) { <text>Salvataggio…</text> } else { <text>Salva categoria</text> }
                                </button>
                                <button type="button" class="secondary-button" disabled="@_inlineSaving" @onclick="ResetInlineEditor">
                                    Annulla
                                </button>
                            </div>
                        </div>
                    </form>

                    @if (selected.Type == CategoryType.Expense)
                    {
                        <div class="category-panel">
                            <div class="category-panel-head">
                                <div class="category-panel-title">
                                    <h3>Sottocategorie</h3>
                                </div>
                                <div class="category-panel-tools">
                                    <span class="category-subcategory-total"
                                          aria-label="@SubcategoryLabel(selected.SubcategoryCount)"
                                          title="@SubcategoryLabel(selected.SubcategoryCount)">
                                        @selected.SubcategoryCount
                                    </span>
                                    <button type="button" class="category-tool small primary" @onclick="ToggleAddSubcategory">
                                        <MfIcon Name="@(_addingSubcategory ? "close" : "plus")" Size="13" />
                                        @(_addingSubcategory ? "Chiudi" : "Aggiungi")
                                    </button>
                                </div>
                            </div>

                            @if (_addingSubcategory)
                            {
                                <form class="category-subcategory-add" @onsubmit="AddInlineSubcategoryAsync">
                                    <div class="category-subcategory-fields">
                                        <label class="category-field">
                                            <span>Sottocategoria *</span>
                                            <input type="text" maxlength="200" required aria-required="true"
                                                   @bind="_inlineSubcategoryName"
                                                   @bind:after="ClearInlineSubcategoryDuplicate" />
                                        </label>
                                        <label class="category-field">
                                            <span>Descrizione</span>
                                            <input type="text" maxlength="200" @bind="_inlineSubcategoryDescription" />
                                        </label>
                                    </div>

                                    @if (_inlineSubcategoryError is not null)
                                    {
                                        <p class="alert alert-error" role="alert">@_inlineSubcategoryError</p>
                                    }

                                    <DuplicateNamePrompt Suggestion="@_inlineSubcategoryDuplicate"
                                                         Disabled="@_subcategoryWorking"
                                                         OnAccept="ConfirmInlineSubcategoryAsync"
                                                         OnCancel="ClearInlineSubcategoryDuplicate" />

                                    <div class="form-actions">
                                        <button type="submit" class="primary-button" disabled="@_subcategoryWorking">
                                            Aggiungi sottocategoria
                                        </button>
                                        <button type="button" class="secondary-button" disabled="@_subcategoryWorking" @onclick="ToggleAddSubcategory">
                                            Annulla
                                        </button>
                                    </div>
                                </form>
                            }

                            <div class="category-subcategory-list">
                                @foreach (var row in selected.Rows)
                                {
                                    @if (_editingSubcategoryRow?.Category.Id == row.Category.Id)
                                    {
                                        <div class="category-subcategory-item editing">
                                            <form class="category-subcategory-edit" @onsubmit="SaveInlineSubcategoryAsync">
                                                <div class="category-subcategory-fields">
                                                    <label class="category-field">
                                                        <span>Sottocategoria *</span>
                                                        <input type="text" maxlength="200" required aria-required="true"
                                                               @bind="_inlineEditSubcategoryName" />
                                                    </label>
                                                    <label class="category-field">
                                                        <span>Descrizione</span>
                                                        <input type="text" maxlength="200" @bind="_inlineEditSubcategoryDescription" />
                                                    </label>
                                                </div>

                                                @if (_inlineEditSubcategoryError is not null)
                                                {
                                                    <p class="alert alert-error" role="alert">@_inlineEditSubcategoryError</p>
                                                }

                                                <div class="form-actions">
                                                    <button type="submit" class="primary-button" disabled="@_subcategoryWorking">
                                                        Salva sottocategoria
                                                    </button>
                                                    <button type="button" class="secondary-button" disabled="@_subcategoryWorking" @onclick="CancelInlineSubcategoryEdit">
                                                        Annulla
                                                    </button>
                                                    <button type="button" class="secondary-button" disabled="@_subcategoryWorking" @onclick="OpenMoveSubcategoryFromEditor">
                                                        <MfIcon Name="transfer" Size="14" /> Sposta
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="category-subcategory-item">
                                            <div class="category-subcategory-copy">
                                                <strong>@(string.IsNullOrWhiteSpace(row.Category.Subcategory) ? "Senza nome" : row.Category.Subcategory)</strong>
                                                <span>@OperationLabel(row.OperationCount)</span>
                                            </div>
                                            <div class="category-subcategory-actions">
                                                <button type="button" class="category-icon-action"
                                                        title="Modifica sottocategoria"
                                                        aria-label="Modifica sottocategoria"
                                                        @onclick="() => StartInlineSubcategoryEdit(row)">
                                                    <MfIcon Name="settings" Size="15" />
                                                </button>
                                                <button type="button" class="category-icon-action danger"
                                                        title="Elimina sottocategoria"
                                                        aria-label="Elimina sottocategoria"
                                                        @onclick="() => OpenDeleteSubcategory(row)">
                                                    <MfIcon Name="trash" Size="15" />
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="category-detail-empty">
                        <span class="category-empty-mark" aria-hidden="true"><MfIcon Name="tag" Size="26" /></span>
                        <span class="category-eyebrow">Area di lavoro</span>
                        <h2>@(ActiveGroups.Count == 0 ? "Nessuna categoria" : "Seleziona una categoria")</h2>
                        <p>
                            @(ActiveGroups.Count == 0
                                ? $"Crea la prima categoria di {ActiveTypeName} per iniziare."
                                : "Scegli una voce dal catalogo per gestire sottocategorie e operazioni.")
                        </p>
                        @if (ActiveGroups.Count == 0)
                        {
                            <button type="button" class="secondary-button category-create-button" @onclick="() => OpenCreate(_activeType)">
                                Nuova categoria
                            </button>
                        }
                    </div>
                }
            </section>
        </div>
    </section>
}

@if (_editorOpen)
{
    <div class="modal-backdrop" @onclick="CloseEditor">
        <div class="modal-card category-admin-modal" role="dialog" aria-modal="true" aria-labelledby="category-editor-title"
             @onclick:stopPropagation="true">
            <div class="section-head">
                <div>
                    <h2 id="category-editor-title">@EditorTitle</h2>
                    <p class="section-sub">@EditorSubtitle</p>
                </div>
                <button type="button" class="icon-button" aria-label="Chiudi" disabled="@_working" @onclick="CloseEditor">
                    <MfIcon Name="close" Size="18" />
                </button>
            </div>

            @if (_editorError is not null)
            {
                <p class="alert alert-error" role="alert">@_editorError</p>
            }

            <form class="form-grid" @onsubmit="SaveEditorAsync">
                @if (_editorMode is EditorMode.CreateCategory or EditorMode.EditGroup)
                {
                    <label>
                        <span>Nome categoria *</span>
                        <input type="text" maxlength="200" required aria-required="true" @bind="_editName" @bind:after="ClearDuplicateSuggestion" />
                    </label>
                    <label>
                        <span>Descrizione</span>
                        <input type="text" maxlength="200" @bind="_editDescription" />
                    </label>
                    <div class="icon-picker-field">
                        <span>Icona</span>
                        <IconPicker @bind-Value="_editIcon" Label="Icona della categoria" />
                        <p class="table-hint">Serve a riconoscere la categoria a colpo d’occhio.</p>
                    </div>
                    <div class="color-picker-field">
                        <span>Colore</span>
                        <ColorPicker @bind-Value="_editColor" Label="Colore della categoria" />
                    </div>
                }

                @if (_editorMode == EditorMode.CreateCategory && _editorType == CategoryType.Expense)
                {
                    <label>
                        <span>Prima sottocategoria *</span>
                        <input type="text" maxlength="200" required aria-required="true" @bind="_editSubcategory" @bind:after="ClearDuplicateSuggestion" />
                    </label>
                }

                @if (_editorMode is EditorMode.AddSubcategory or EditorMode.EditSubcategory)
                {
                    <label>
                        <span>Sottocategoria *</span>
                        <input type="text" maxlength="200" required aria-required="true" @bind="_editSubcategory" @bind:after="ClearDuplicateSuggestion" />
                    </label>
                    <label>
                        <span>Descrizione</span>
                        <input type="text" maxlength="200" @bind="_editDescription" />
                    </label>
                }

                <DuplicateNamePrompt Suggestion="@_duplicateSuggestion"
                                     Disabled="@_working"
                                     OnAccept="ConfirmDuplicateEditorAsync"
                                     OnCancel="ClearDuplicateSuggestion" />

                <div class="form-actions">
                    <button type="submit" class="primary-button" disabled="@_working">
                        @if (_working) { <text>Salvataggio…</text> } else { <text>Salva</text> }
                    </button>
                    <button type="button" class="secondary-button" disabled="@_working" @onclick="CloseEditor">Annulla</button>
                </div>
            </form>
        </div>
    </div>
}

@if (_moveOpen)
{
    <div class="modal-backdrop" @onclick="CloseMove">
        <div class="modal-card category-admin-modal" role="dialog" aria-modal="true" aria-labelledby="category-move-title"
             @onclick:stopPropagation="true">
            <div class="section-head">
                <div>
                    <h2 id="category-move-title">Sposta operazioni</h2>
                    <p class="section-sub">@MoveDescription</p>
                </div>
                <button type="button" class="icon-button" aria-label="Chiudi" disabled="@_working" @onclick="CloseMove">
                    <MfIcon Name="close" Size="18" />
                </button>
            </div>

            @if (_moveError is not null)
            {
                <p class="alert alert-error" role="alert">@_moveError</p>
            }

            @if (!_moveGroupMode)
            {
                <label class="form-field">
                    <span>Sottocategoria di destinazione</span>
                    <select @bind="_moveDestinationRowId" disabled="@_working">
                        @foreach (var row in MoveSubcategoryDestinations)
                        {
                            <option value="@row.Category.Id">@MoveRowLabel(row)</option>
                        }
                    </select>
                </label>
            }
            else if (_moveGroup is { } group)
            {
                <label class="form-field">
                    <span>Categoria di destinazione</span>
                    <select @bind="_moveDestinationGroup" @bind:after="OnMoveGroupChanged" disabled="@_working">
                        @foreach (var destination in MoveGroupDestinations)
                        {
                            <option value="@destination.Name">@destination.Name</option>
                        }
                    </select>
                </label>

                @if (group.Type == CategoryType.Expense)
                {
                    <label class="form-field">
                        <span>Sottocategoria di destinazione</span>
                        <select @bind="_moveDestinationRowId" disabled="@_working">
                            @foreach (var row in MoveDestinationRows)
                            {
                                <option value="@row.Category.Id">@row.Category.Subcategory</option>
                            }
                        </select>
                    </label>
                }
            }

            @if (_moveError is null && !CanConfirmMove)
            {
                <p class="table-hint">Crea prima una categoria o sottocategoria di destinazione.</p>
            }

            <div class="form-actions">
                <button type="button" class="primary-button" disabled="@(_working || !CanConfirmMove)" @onclick="ConfirmMoveAsync">
                    Sposta operazioni
                </button>
                <button type="button" class="secondary-button" disabled="@_working" @onclick="CloseMove">Annulla</button>
            </div>
        </div>
    </div>
}

@if (_deleteOpen)
{
    <div class="modal-backdrop" @onclick="CloseDelete">
        <div class="modal-card category-admin-modal" role="dialog" aria-modal="true" aria-labelledby="category-delete-title"
             @onclick:stopPropagation="true">
            <div class="section-head">
                <div class="category-delete-heading">
                    <span class="category-delete-icon" aria-hidden="true">
                        <MfIcon Name="trash" Size="18" />
                    </span>
                    <div>
                        <h2 id="category-delete-title">Elimina @(_deleteGroupMode ? "categoria" : "sottocategoria")</h2>
                        <p class="section-sub">@DeleteDescription</p>
                    </div>
                </div>
                <button type="button" class="icon-button" aria-label="Chiudi" disabled="@_working" @onclick="CloseDelete">
                    <MfIcon Name="close" Size="18" />
                </button>
            </div>

            @if (_deleteError is not null)
            {
                <p class="alert alert-error" role="alert">@_deleteError</p>
            }

            <div class="category-delete-body">
                @if (DeleteOperationCount > 0)
                {
                    <p class="alert alert-warning" role="alert">
                        Ci sono @DeleteOperationCount operazioni collegate. Scegli dove spostarle prima di eliminare.
                    </p>

                    <div class="category-delete-fields">
                        @if (!_deleteGroupMode)
                        {
                            <label class="form-field">
                                <span>Sposta le operazioni in</span>
                                <select @bind="_deleteDestinationRowId" disabled="@_working">
                                    @foreach (var row in DeleteSubcategoryDestinations)
                                    {
                                        <option value="@row.Category.Id">@DeleteRowLabel(row)</option>
                                    }
                                </select>
                            </label>
                        }
                        else if (_deleteGroup is { } group)
                        {
                            <label class="form-field">
                                <span>Categoria di destinazione</span>
                                <select @bind="_deleteDestinationGroup" @bind:after="OnDeleteGroupChanged" disabled="@_working">
                                    @foreach (var destination in DeleteGroupDestinations)
                                    {
                                        <option value="@destination.Name">@destination.Name</option>
                                    }
                                </select>
                            </label>

                            @if (group.Type == CategoryType.Expense)
                            {
                                <label class="form-field">
                                    <span>Sottocategoria di destinazione</span>
                                    <select @bind="_deleteDestinationRowId" disabled="@_working">
                                        @foreach (var row in DeleteDestinationRows)
                                        {
                                            <option value="@row.Category.Id">@row.Category.Subcategory</option>
                                        }
                                    </select>
                                </label>
                            }
                        }
                    </div>

                    @if (!CanConfirmDelete)
                    {
                        <p class="table-hint">Crea prima una destinazione disponibile.</p>
                    }
                }
                else
                {
                    <p class="alert alert-info" role="status">
                        Non ci sono operazioni collegate: puoi eliminare senza spostamenti.
                    </p>
                }
            </div>

            <div class="settings-danger-zone category-delete-actions">
                <div class="form-actions">
                    <button type="button" class="danger-button" disabled="@(_working || !CanConfirmDelete)" @onclick="ConfirmDeleteAsync">
                        <MfIcon Name="trash" Size="16" />
                        @if (DeleteOperationCount > 0) { <text>Sposta e elimina</text> } else { <text>Elimina</text> }
                    </button>
                    <button type="button" class="secondary-button" disabled="@_working" @onclick="CloseDelete">Annulla</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _loading = true;
    private bool _working;
    private string? _loadError;
    private string? _message;
    private IReadOnlyList<Category> _categories = [];
    private IReadOnlyDictionary<Guid, int> _operationCounts = new Dictionary<Guid, int>();
    private IReadOnlyList<CategoryAdminGroup> _incomeGroups = [];
    private IReadOnlyList<CategoryAdminGroup> _expenseGroups = [];

    private CategoryType _activeType = CategoryType.Expense;
    private string? _selectedGroupName;
    private string _search = "";
    private bool _mobileDetail;

    private string? _inlineGroupKey;
    private string _inlineName = "";
    private string _inlineDescription = "";
    private string _inlineIcon = CategoryAppearance.DefaultIcon;
    private string _inlineColor = CategoryAppearance.DefaultColor;
    private string? _inlineError;
    private bool _inlineSaving;

    private bool _addingSubcategory;
    private string _inlineSubcategoryName = "";
    private string _inlineSubcategoryDescription = "";
    private string? _inlineSubcategoryError;
    private string? _inlineSubcategoryDuplicate;
    private bool _subcategoryWorking;

    private CategoryAdminRow? _editingSubcategoryRow;
    private string _inlineEditSubcategoryName = "";
    private string _inlineEditSubcategoryDescription = "";
    private string? _inlineEditSubcategoryError;

    private bool _editorOpen;
    private EditorMode _editorMode;
    private CategoryType _editorType;
    private CategoryAdminGroup? _editorGroup;
    private CategoryAdminRow? _editorRow;
    private string _editName = "";
    private string _editSubcategory = "";
