    private void EnsureSelection()
    {
        var groups = GroupsOf(_activeType);
        if (_selectedGroupName is null ||
            !groups.Any(group => Same(group.Name, _selectedGroupName)))
        {
            _selectedGroupName = groups.FirstOrDefault()?.Name;
        }

        SyncInlineEditor();
    }

    private void SyncInlineEditor()
    {
        if (SelectedGroup is not { } group)
        {
            _inlineGroupKey = null;
            return;
        }

        var key = $"{group.Type}:{group.Name}";
        if (string.Equals(_inlineGroupKey, key, StringComparison.Ordinal))
        {
            return;
        }

        _inlineGroupKey = key;
        _inlineName = group.Name;
        _inlineDescription = group.Primary.Description ?? "";
        _inlineIcon = CategoryAppearance.IconFor(group.Primary.Icon);
        _inlineColor = CategoryAppearance.ColorFor(group.Primary.ColorHex);
        _inlineError = null;
        _addingSubcategory = false;
        _inlineSubcategoryName = "";
        _inlineSubcategoryDescription = "";
        _inlineSubcategoryError = null;
        _inlineSubcategoryDuplicate = null;
        _editingSubcategoryRow = null;
        _inlineEditSubcategoryName = "";
        _inlineEditSubcategoryDescription = "";
        _inlineEditSubcategoryError = null;
    }

    private void ResetInlineEditor()
    {
        _inlineGroupKey = null;
        SyncInlineEditor();
    }

    private async Task SaveInlineGroupAsync()
    {
        if (_inlineSaving || SelectedGroup is not { } group)
        {
            return;
        }

        var name = _inlineName.Trim();
        if (name.Length == 0)
        {
            _inlineError = "Il nome della categoria è obbligatorio.";
            return;
        }

        _inlineSaving = true;
        _inlineError = null;
        try
        {
            await Admin.UpdateGroupAsync(
                group.Type,
                group.Name,
                name,
                Clean(_inlineDescription),
                _inlineIcon,
                _inlineColor);
            _message = $"Categoria «{name}» aggiornata.";
            _activeType = group.Type;
            _selectedGroupName = name;
            _inlineGroupKey = null;
            await LoadAsync();
        }
        catch (ArgumentException exception)
        {
            _inlineError = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _inlineError = exception.Message;
        }
        catch (Exception)
        {
            _inlineError = "Salvataggio non riuscito: verificare la connessione al database e riprovare.";
        }
        finally
        {
            _inlineSaving = false;
        }
    }

