        _inlineSubcategoryDuplicate is { } name
            ? AddInlineSubcategoryCoreAsync(name)
            : Task.CompletedTask;

    private async Task AddInlineSubcategoryCoreAsync(string? confirmedName)
    {
        if (_subcategoryWorking || SelectedGroup is not { Type: CategoryType.Expense } group)
        {
            return;
        }

        var name = (confirmedName ?? _inlineSubcategoryName).Trim();
        if (name.Length == 0)
        {
            _inlineSubcategoryError = "Il nome della sottocategoria è obbligatorio.";
            return;
        }

        if (confirmedName is null)
        {
            var suggestion = NameUniqueness.SuggestIfDuplicate(
                name,
                group.Rows.Select(row => row.Category.Subcategory ?? ""));
            if (suggestion is not null)
            {
                _inlineSubcategoryDuplicate = suggestion;
                return;
            }
        }

        _subcategoryWorking = true;
        _inlineSubcategoryError = null;
        try
        {
            await Admin.AddSubcategoryAsync(
                group.Rows[0].Category.Id,
                name,
                Clean(_inlineSubcategoryDescription));
            _message = $"Sottocategoria «{name}» aggiunta.";
            _addingSubcategory = false;
            _inlineSubcategoryName = "";
            _inlineSubcategoryDescription = "";
            _inlineSubcategoryDuplicate = null;
            await LoadAsync();
        }
        catch (ArgumentException exception)
        {
            _inlineSubcategoryError = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _inlineSubcategoryError = exception.Message;
        }
        catch (Exception)
        {
            _inlineSubcategoryError = "Salvataggio non riuscito: verificare la connessione al database e riprovare.";
        }
        finally
        {
            _subcategoryWorking = false;
        }
    }

