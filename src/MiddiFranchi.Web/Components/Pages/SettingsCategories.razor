    private void CloseDelete()
    {
        if (_working)
        {
            return;
        }

        _deleteOpen = false;
        _deleteError = null;
    }

    private void OnDeleteGroupChanged()
    {
        var destination = DeleteGroupDestinations
            .FirstOrDefault(candidate => Same(candidate.Name, _deleteDestinationGroup));
        _deleteDestinationRowId = destination?.Rows[0].Category.Id;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_working || !CanConfirmDelete)
        {
            return;
        }

        _working = true;
        _deleteError = null;
        try
        {
            var destinationRow = ResolveDeleteDestinationRow();
            var moved = _deleteGroupMode && _deleteGroup is not null
                ? await Admin.DeleteCategoryGroupAsync(
                    _deleteGroup.Type,
                    _deleteGroup.Name,
                    destinationRow?.Category.Id)
                : await Admin.DeleteSubcategoryAsync(
                    _deleteRow!.Category.Id,
                    destinationRow?.Category.Id);

            _message = moved > 0
                ? $"{moved} operazioni spostate e {(_deleteGroupMode ? "categoria" : "sottocategoria")} eliminata."
                : $"{(_deleteGroupMode ? "Categoria" : "Sottocategoria")} eliminata.";
            _deleteOpen = false;
            await LoadAsync();
        }
        catch (InvalidOperationException exception)
        {
            _deleteError = exception.Message;
        }
        catch (Exception)
        {
            _deleteError = "Eliminazione non riuscita: verificare la connessione al database e riprovare.";
        }
        finally
        {
            _working = false;
        }
    }

    private bool CanConfirmDelete
    {
        get
        {
            if (DeleteOperationCount == 0)
            {
                return true;
            }

            return ResolveDeleteDestinationRow() is not null;
        }
    }

    private int DeleteOperationCount => _deleteGroupMode
        ? _deleteGroup?.OperationCount ?? 0
        : _deleteRow?.OperationCount ?? 0;

    private string DeleteDescription => _deleteGroupMode
        ? $"Stai eliminando la categoria «{_deleteGroup?.Name}» e tutte le sue sottocategorie."
        : $"Stai eliminando la sottocategoria «{_deleteRow?.Category.Subcategory}».";

    private IReadOnlyList<CategoryAdminGroup> DeleteGroupDestinations => _deleteGroup is null
        ? []
        : GroupsOf(_deleteGroup.Type)
            .Where(group => !Same(group.Name, _deleteGroup.Name))
            .ToArray();

    private IReadOnlyList<CategoryAdminRow> DeleteDestinationRows
    {
        get
        {
            var group = DeleteGroupDestinations.FirstOrDefault(candidate => Same(candidate.Name, _deleteDestinationGroup));
            return group?.Rows ?? [];
        }
    }

    private IReadOnlyList<CategoryAdminRow> DeleteSubcategoryDestinations => _deleteRow is null
        ? []
        : _expenseGroups
            .SelectMany(group => group.Rows)
            .Where(row => row.Category.Id != _deleteRow.Category.Id)
            .OrderBy(row => row.Category.Name, StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(row => row.Category.Subcategory, StringComparer.CurrentCultureIgnoreCase)
            .ToArray();

    private CategoryAdminRow? ResolveDeleteDestinationRow()
    {
        if (!_deleteGroupMode)
        {
            return _deleteDestinationRowId is { } id
                ? DeleteSubcategoryDestinations.FirstOrDefault(row => row.Category.Id == id)
                : null;
        }

        if (_deleteGroup is { Type: CategoryType.Income })
        {
            return _deleteDestinationGroup is null
                ? null
                : DeleteGroupDestinations
                    .FirstOrDefault(group => Same(group.Name, _deleteDestinationGroup))
                    ?.Rows[0];
        }

        return _deleteDestinationRowId is { } rowId
            ? DeleteDestinationRows.FirstOrDefault(row => row.Category.Id == rowId)
            : null;
    }

    private static string DeleteRowLabel(CategoryAdminRow row) =>
        $"{row.Category.Name} · {row.Category.Subcategory}";

    private IReadOnlyList<CategoryAdminGroup> GroupsOf(CategoryType type) =>
        type == CategoryType.Income ? _incomeGroups : _expenseGroups;

    private CategoryAdminGroup? FindGroup(CategoryAdminRow row) =>
        GroupsOf(row.Category.Type)
            .FirstOrDefault(group => Same(group.Name, row.Category.Name));

    private static string? Clean(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static bool Same(string? left, string? right) =>
        string.Equals(left, right, StringComparison.CurrentCultureIgnoreCase);
}
