@page "/Error"
@using System.Diagnostics

<PageTitle>Errore</PageTitle>
<h1><MfIcon Name="alert" Size="24" /> Errore</h1>
<p class="page-intro">Si è verificato un problema durante l'elaborazione della richiesta.</p>
<p><a class="primary-link" href="/">Torna alla dashboard</a></p>

@if (ShowRequestId)
{
    <section class="card">
        <p><strong>Request ID:</strong> <code>@RequestId</code></p>
    </section>
}

<div class="card section-note">
    <h3>Modalità di sviluppo</h3>
    <p>
        Passando all'ambiente <strong>Development</strong> vengono mostrate informazioni più dettagliate
        sull'errore.
    </p>
    <p>
        L'ambiente <strong>Development</strong> non va abilitato in produzione: può esporre agli utenti
        informazioni sensibili provenienti dalle eccezioni.
        Per il debug locale, abilitare l'ambiente <strong>Development</strong> impostando la variabile
        d'ambiente <strong>ASPNETCORE_ENVIRONMENT</strong> e riavviando l'app.
    </p>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
