@page "/movements"
@rendermode InteractiveServer
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@using MiddiFranchi.Domain.Shared
@inject MovementService MovementsService
@inject AccountService AccountsService

<PageTitle>Movimenti</PageTitle>
<h1>Movimenti</h1>
<p class="page-intro">
    Vista economica corrente delle operazioni registrate: le operazioni eliminate sono escluse.
    Applica filtri per conto o per periodo.
</p>

@if (_loadError is not null)
{
    <p class="alert alert-error" role="alert">@_loadError</p>
}
else
{
    <form class="form-grid form-inline" @onsubmit="ApplyFiltersAsync" aria-label="Filtri dei movimenti">
        <label>
            <span>Conto</span>
            <select @bind="_accountId">
                <option value="">Tutti i conti</option>
                @foreach (var account in _accountOptions)
                {
                    <option value="@account.Id">@account.Name</option>
                }
            </select>
        </label>
        <label>
            <span>Data da</span>
            <input type="date" @bind="_fromDate" />
        </label>
        <label>
            <span>Data a</span>
            <input type="date" @bind="_toDate" />
        </label>
        <div class="form-actions">
            <button type="submit" class="primary-button">Applica filtri</button>
        </div>
    </form>

    @if (_loading)
    {
        <p class="page-status">Caricamento in corso…</p>
    }
    else if (_queryError is not null)
    {
        <p class="alert alert-error" role="alert">@_queryError</p>
    }
    else if (_rows.Count == 0)
    {
        <EmptyState Title="Nessun movimento per i filtri richiesti"
                    Hint="Registra un'entrata, un'uscita o un trasferimento per popolare la vista."
                    Icon="list" Href="operations" ActionLabel="Registra un'operazione" />
    }
    else
    {
        <section class="card">
            <div class="table-scroll" tabindex="0">
                <table class="data-table">
                    <caption class="table-hint">Ordine deterministico per data, operazione e posting; importi con segno in EUR.</caption>
                    <thead>
                        <tr>
                            <th scope="col">Data</th>
                            <th scope="col">Conto</th>
                            <th scope="col">Tipo</th>
                            <th scope="col">Descrizione</th>
                            <th scope="col" class="num">Importo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PageRows)
                        {
                            <tr>
                                <td>@Format.Date(row.Posting.OperationDate)</td>
                                <td>@AccountLabelFor(row.Posting.AccountId)</td>
                                <td>@Format.PostingKindLabel(row.Posting.Kind)</td>
                                <td>@(row.Posting.Operation.Description ?? "-")</td>
                                <td class="num">
                                    <AmountValue Value="@(new Money(row.Posting.SignedAmount, row.Posting.Currency))" Signed="true" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <nav class="pagination" aria-label="Paginazione dei movimenti">
                <span class="pagination-info">@PageSummary</span>
                @if (PageCount > 1)
                {
                    <div class="pagination-actions">
                        <button type="button" class="secondary-button" disabled="@(!HasPrevious)" @onclick="PreviousPage">Precedente</button>
                        <span class="pagination-info">Pagina @_page di @PageCount</span>
                        <button type="button" class="secondary-button" disabled="@(!HasNext)" @onclick="NextPage">Successiva</button>
                    </div>
                }
            </nav>
        </section>
    }
}

@code {
    private sealed record MovementRow(AccountPosting Posting, string AccountLabel);

    private IReadOnlyList<Account> _accountOptions = [];
    private Dictionary<Guid, string> _accountLabels = new();
    private List<MovementRow> _rows = [];
    private const int PageSize = 20;
    private int _page = 1;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)PageSize));
    private IReadOnlyList<MovementRow> PageRows => _rows
        .Skip((_page - 1) * PageSize)
        .Take(PageSize)
        .ToArray();
    private bool HasPrevious => _page > 1;
    private bool HasNext => _page < PageCount;
    private string PageSummary =>
        $"{((_page - 1) * PageSize) + 1}–{Math.Min(_page * PageSize, _rows.Count)} di {_rows.Count} movimenti";
    private bool _loading = true;
    private string? _loadError;
    private string? _queryError;
    private string _accountId = "";
    private DateOnly? _fromDate;
    private DateOnly? _toDate;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _loadError = null;
            var accounts = await AccountsService.ListAsync();
            _accountOptions = accounts;
            _accountLabels = accounts.ToDictionary(account => account.Id, account => account.Name);
            await LoadRowsAsync();
        }
        catch (InvalidOperationException exception) when (exception.Message.Contains("connection string", StringComparison.OrdinalIgnoreCase))
        {
            _loadError = "Il database non è configurato. Impostare la connection string 'ConnectionStrings:DefaultConnection' nelle variabili d'ambiente o nei user secrets.";
        }
        catch (Exception)
        {
            _loadError = "Impossibile contattare il database. Verificare che PostgreSQL sia raggiungibile e che la connection string sia corretta.";
        }

        _loading = false;
    }

    private async Task ApplyFiltersAsync()
    {
        _loading = true;
        _page = 1;
        await LoadRowsAsync();
        _loading = false;
    }

    private async Task LoadRowsAsync()
    {
        _queryError = null;
        try
        {
            Guid? accountId = string.IsNullOrWhiteSpace(_accountId)
                ? null
                : Guid.Parse(_accountId);
            var postings = await MovementsService.ListAsync(accountId, _fromDate, _toDate);
            _rows = postings
                .Select(posting => new MovementRow(
                    posting,
                    _accountLabels.GetValueOrDefault(posting.AccountId, "Conto " + posting.AccountId)))
                .ToList();
            _page = Math.Clamp(_page, 1, PageCount);
        }
        catch (Exception exception)
        {
            _queryError = $"Impossibile leggere i movimenti: {exception.Message}";
        }
    }

    private void PreviousPage()
    {
        if (HasPrevious)
        {
            _page--;
        }
    }

    private void NextPage()
    {
        if (HasNext)
        {
            _page++;
        }
    }

    private string AccountLabelFor(Guid accountId) => _accountLabels.GetValueOrDefault(accountId, "Conto " + accountId);
}
