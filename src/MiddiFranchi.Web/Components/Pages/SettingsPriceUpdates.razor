@page "/settings/price-updates"
@rendermode InteractiveServer
@using System.Globalization
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Portfolio
@using MiddiFranchi.Domain.Shared
@inject IPriceUpdateStore PriceUpdateStore
@inject PriceUpdateService PriceUpdates
@inject InvestmentWorkspaceService Workspace
@inject NotificationService Notifications
@inject IJSRuntime JS

<PageTitle>Aggiornamento prezzi</PageTitle>

<a class="section-link settings-back" href="/settings">
    <MfIcon Name="arrow-left" Size="16" /> Configurazione
</a>

<div class="dashboard-header">
    <div>
        <h1 class="account-detail-title">
            <span class="account-avatar investments" aria-hidden="true"><MfIcon Name="refresh" Size="18" /></span>
            Aggiornamento prezzi
        </h1>
    </div>
</div>

@if (_loading)
{
    <p class="page-status" role="status">Caricamento dello stato del servizio…</p>
}
else if (_loadError is not null)
{
    <p class="alert alert-error" role="alert">@_loadError</p>
}
else
{
    <section class="settings-status-card @PriceStatusTone" aria-labelledby="price-status-title">
        @{
            var updateSettings = PriceUpdateStore.GetSettings();
            var updateStatus = PriceUpdateStore.GetStatus();
            var nextRun = PriceUpdateScheduler.GetNextScheduledTime(
                updateSettings,
                PriceUpdateScheduler.ResolveNow(updateSettings));
            var failures = updateStatus.Results.Where(result => !result.Success).ToArray();
            var successCount = updateStatus.Results.Count - failures.Length;
            var statusIcon = updateStatus.IsRunning
                ? "clock"
                : !updateSettings.Enabled
                    ? "refresh"
                    : updateStatus.LastError is null
                        ? "check"
                        : "alert";
            var statusTitle = updateStatus.IsRunning
                ? "Aggiornamento in corso"
                : !updateSettings.Enabled
                    ? "Aggiornamento automatico disattivato"
                    : updateStatus.LastError is null
                        ? "Servizio operativo"
                        : "Ultimo aggiornamento con errori";
            var activeAssets = AllAssets.Count(asset => !asset.IsArchived);
            var activeWithIsin = AllAssets.Count(asset =>
                !asset.IsArchived && !string.IsNullOrWhiteSpace(asset.Isin));
            var skippedWithoutIsin = activeAssets - activeWithIsin;
        }

        <span class="settings-status-orb" aria-hidden="true">
            <MfIcon Name="@statusIcon" Size="26" />
        </span>
        <span class="settings-status-copy">
            <span class="settings-status-eyebrow">Aggiornamento prezzi</span>
            <strong id="price-status-title">@statusTitle</strong>
            <span class="settings-status-detail">
                @if (updateStatus.LastRunAt is null)
                {
                    <span>Nessuna esecuzione registrata.</span>
                }
                else
                {
                    <span>Ultima esecuzione <LocalTimestamp Value="updateStatus.LastRunAt.Value" /> · Ultimo successo </span>
                    @if (updateStatus.LastSuccessAt is { } lastSuccess)
                    {
                        <LocalTimestamp Value="lastSuccess" />
                    }
                    else
                    {
                        <span>Mai</span>
                    }
                    <span> · Prossima </span>
                    @if (nextRun is { } next)
                    {
                        <LocalTimestamp Value="next" />
                    }
                    else
                    {
                        <span>—</span>
                    }
                }
            </span>
        </span>
        <span class="settings-status-metrics">
            <span class="settings-status-metric">
                <strong>@(updateStatus.Results.Count > 0 ? successCount.ToString() : "—")</strong>
                <small>ok</small>
            </span>
            <span class="settings-status-metric @(failures.Length > 0 ? "negative" : "")">
                <strong>@(updateStatus.Results.Count > 0 ? failures.Length.ToString() : "—")</strong>
                <small>errori</small>
            </span>
        </span>
        <button type="button" class="secondary-button"
                disabled="@_updatingAll"
                @onclick="UpdateAllNowAsync">
            <MfIcon Name="refresh" Size="16" />
            @(_updatingAll ? "Aggiornamento…" : "Aggiorna tutti ora")
        </button>
    </section>

    @if (skippedWithoutIsin > 0)
    {
        <p class="alert alert-info" role="status">
            @(skippedWithoutIsin == 1
                ? "1 strumento attivo non ha un ISIN e non viene aggiornato."
                : $"{skippedWithoutIsin} strumenti attivi non hanno un ISIN e non vengono aggiornati.")
        </p>
    }

    @if (updateStatus.LastError is not null)
    {
        <p class="alert alert-error" role="alert">@updateStatus.LastError</p>
    }

    @if (failures.Length > 0)
    {
        <ul class="settings-price-failures" aria-label="Errori dell'ultimo aggiornamento">
            @foreach (var failure in failures)
            {
                <li>
                    <strong>@(string.IsNullOrWhiteSpace(failure.Name) ? "Aggiornamento" : failure.Name)</strong>
                    <span>@failure.Error</span>
                </li>
            }
        </ul>
    }
    else if (updateStatus.Results.Count > 0)
    {
        <p class="table-hint">
            Tutti gli strumenti dell'ultima esecuzione sono stati aggiornati correttamente.
        </p>
    }

    <section class="card settings-price-plan" aria-labelledby="price-plan-title">
        <div class="section-head">
            <div>
                <h2 id="price-plan-title"><MfIcon Name="settings" Size="18" /> Pianificazione</h2>
                <p class="section-sub">Orario, frequenza e mercato usati dal servizio automatico.</p>
            </div>
        </div>

        <form class="form-grid settings-price-form" @onsubmit="SavePriceSettings">
            <label>
                <span>Ora (locale)</span>
                <input type="time" @bind="_updateTime" />
            </label>
            <label>
                <span>Frequenza</span>
                <select @bind="_updateFrequency">
                    @foreach (var frequency in Enum.GetValues<PriceUpdateFrequency>())
                    {
                        <option value="@frequency">@FrequencyLabel(frequency)</option>
                    }
                </select>
            </label>
            <label class="settings-price-enabled">
                <input type="checkbox" @bind="_updateEnabled" />
                <span>Aggiornamento automatico</span>
            </label>
            <div class="form-actions">
                <button type="submit" class="primary-button">
                    <MfIcon Name="check" Size="16" /> Salva impostazioni
                </button>
            </div>
        </form>
    </section>

    <section class="card settings-price-history" aria-labelledby="price-history-title">
        <div class="section-head">
            <div>
                <h2 id="price-history-title"><MfIcon Name="clock" Size="18" /> Ultime rilevazioni</h2>
                <p class="section-sub">Le ultime 10 esecuzioni, manuali e automatiche.</p>
            </div>
        </div>

        @if (History.Count == 0)
        {
            <p class="page-status">Nessuna rilevazione registrata.</p>
        }
        else
        {
            <div class="table-scroll" tabindex="0">
                <table class="data-table settings-price-history-table mobile-cards">
                    <thead>
                        <tr>
                            <th scope="col">Data e ora</th>
                            <th scope="col">Tipo</th>
                            <th scope="col">Ambito</th>
                            <th scope="col" class="num">Prezzo</th>
                            <th scope="col">Esito</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var run in History)
                        {
                            var singleResult = RunInstrumentResult(run);
                            <tr>
                                <td data-label="Data e ora"><LocalTimestamp Value="run.RunAt" /></td>
                                <td data-label="Tipo">
                                    <StatusBadge Tone="neutral">
                                        @(run.Trigger == PriceUpdateTrigger.Automatic ? "Automatica" : "Manuale")
                                    </StatusBadge>
                                </td>
                                <td data-label="Ambito">@RunScopeLabel(run)</td>
                                <td data-label="Prezzo" class="num">
                                    @if (run.Scope == PriceUpdateScope.All)
                                    {
                                        @if (run.Results is { Count: > 0 })
                                        {
                                            <button type="button" class="price-run-details-button"
                                                    title="Dettagli" aria-label="Dettagli"
                                                    @onclick="() => OpenRunDetails(run)">
                                                <MfIcon Name="list" Size="16" />
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="investment-muted">—</span>
                                        }
                                    }
                                    else if (singleResult is { Price: not null })
                                    {
                                        <span class="price-run-price">@PriceText(singleResult)</span>
                                    }
                                    else
                                    {
                                        <span class="investment-muted">—</span>
                                    }
                                </td>
                                <td data-label="Esito">
                                    <StatusBadge Tone="@RunTone(run)" Title="@RunTitle(run)">
                                        @RunResultLabel(run)
                                    </StatusBadge>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@if (_detailRun is { } detail)
{
    <div class="modal-backdrop" @onclick="CloseRunDetails">
        <div class="modal-card price-run-details-modal" role="dialog" aria-modal="true"
             aria-labelledby="price-run-details-title" @onclick:stopPropagation="true">
            <div class="section-head">
                <div>
                    <h2 id="price-run-details-title">Rilevazioni di tutti gli strumenti</h2>
                    <p class="section-sub">
                        <LocalTimestamp Value="detail.RunAt" /> ·
                        @(detail.Trigger == PriceUpdateTrigger.Automatic ? "Automatica" : "Manuale") ·
                        @RunResultLabel(detail)
                    </p>
                </div>
                <button type="button" class="icon-button" aria-label="Chiudi" @onclick="CloseRunDetails">
                    <MfIcon Name="close" Size="18" />
                </button>
            </div>

            @if (detail.Results is { Count: > 0 } results)
            {
                <div class="table-scroll" tabindex="0">
                    <table class="data-table price-run-details-table mobile-cards">
                        <thead>
                            <tr>
                                <th scope="col">Strumento</th>
                                <th scope="col" class="num">Prezzo</th>
                                <th scope="col">Rilevazione</th>
                                <th scope="col">Esito</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in results)
                            {
                                <tr>
                                    <td data-label="Strumento" title="@result.Name">
                                        @InstrumentLabel(result)
                                    </td>
                                    <td data-label="Prezzo" class="num">@(result.Price is null ? "—" : PriceText(result))</td>
                                    <td data-label="Rilevazione">@(result.PriceDate is { } priceDate ? Format.Date(priceDate) : "—")</td>
                                    <td data-label="Esito">
                                        <StatusBadge Tone="@(result.Success ? "income" : "expense")">
                                            @(result.Success ? "OK" : "Errore")
                                        </StatusBadge>
                                        @if (!result.Success && !string.IsNullOrWhiteSpace(result.Error))
                                        {
                                            <span class="investment-muted"> @result.Error</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="page-status">Dettaglio non disponibile per questa esecuzione.</p>
            }
        </div>
    </div>
}

@code {
    private InvestmentWorkspace? _workspace;
    private bool _loading = true;
    private string? _loadError;

    private bool _updateEnabled = true;
    private TimeOnly _updateTime = new(12, 0);
    private PriceUpdateFrequency _updateFrequency = PriceUpdateFrequency.Daily;
    private bool _updatingAll;
    private PriceUpdateRun? _detailRun;

    private IReadOnlyList<InvestmentAssetRow> AllAssets =>
        _workspace?.Assets ?? [];

    private IReadOnlyList<PriceUpdateRun> History => PriceUpdateStore.GetHistory();

    private string PriceStatusTone
    {
        get
        {
            var settings = PriceUpdateStore.GetSettings();
            var status = PriceUpdateStore.GetStatus();
            return status.IsRunning
                ? "warning"
                : !settings.Enabled
                    ? "neutral"
                    : status.LastError is null
                        ? "income"
                        : "expense";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        LoadPriceSettings();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var settings = PriceUpdateStore.GetSettings();
            if (!string.IsNullOrWhiteSpace(settings.TimeZoneId))
            {
                return;
            }

            var timeZoneId = await JS.InvokeAsync<string>("mfGetTimeZone");
            if (string.IsNullOrWhiteSpace(timeZoneId))
            {
                return;
            }

            PriceUpdateStore.SaveSettings(settings with { TimeZoneId = timeZoneId });
            await InvokeAsync(StateHasChanged);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _workspace = null;

        try
        {
            _workspace = await Workspace.LoadAsync();
        }
        catch (InvalidOperationException exception)
            when (exception.Message.Contains("connection string", StringComparison.OrdinalIgnoreCase))
        {
            _loadError = "Il database non è configurato. Impostare la connection string 'ConnectionStrings:DefaultConnection' nelle variabili d'ambiente o nei user secrets.";
        }
        catch (Exception)
        {
            _loadError = "Impossibile caricare gli strumenti. Verificare che PostgreSQL sia raggiungibile e che la connection string sia corretta.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _workspace = await Workspace.LoadAsync();
            _loadError = null;
        }
        catch (Exception)
        {
            await Notifications.Error("Impossibile aggiornare gli strumenti. Verificare la connessione al database e riprovare.");
        }
    }

    private void LoadPriceSettings()
    {
        var settings = PriceUpdateStore.GetSettings();
        _updateEnabled = settings.Enabled;
        _updateTime = settings.TimeOfDay;
        _updateFrequency = settings.Frequency;
    }

    private async Task SavePriceSettings()
    {
        var timeZoneId = await ResolveTimeZoneAsync();
        PriceUpdateStore.SaveSettings(new PriceUpdateSettings(
            _updateEnabled,
            _updateTime,
            _updateFrequency,
            "XMIL",
            timeZoneId));
        await Notifications.Success("Impostazioni di aggiornamento salvate.");
    }

    private async Task<string> ResolveTimeZoneAsync()
    {
        try
        {
            var timeZoneId = await JS.InvokeAsync<string>("mfGetTimeZone");
            if (!string.IsNullOrWhiteSpace(timeZoneId))
            {
                return timeZoneId;
            }
        }
        catch (JSDisconnectedException)
        {
        }

        return PriceUpdateStore.GetSettings().TimeZoneId;
    }

    private async Task UpdateAllNowAsync()
    {
        if (_updatingAll)
        {
            return;
        }

        _updatingAll = true;
        try
        {
            var results = await PriceUpdates.UpdateAllAsync();
            var failures = results.Where(result => !result.Success).ToArray();
            await Notifications.Success(failures.Length == 0
                ? $"{results.Count} strumenti aggiornati."
                : $"{results.Count - failures.Length} aggiornati, {failures.Length} errori.");
            if (failures.Length > 0)
            {
                await Notifications.Error(string.Join(
                    " ",
                    failures.Select(result =>
                        $"{(string.IsNullOrWhiteSpace(result.Name) ? "Aggiornamento" : result.Name)}: {result.Error}")));
            }

            await ReloadAsync();
        }
        finally
        {
            _updatingAll = false;
        }
    }

    private static string RunScopeLabel(PriceUpdateRun run) =>
        run.Scope == PriceUpdateScope.All
            ? "Tutti gli strumenti"
            : string.IsNullOrWhiteSpace(run.InstrumentName)
                ? "Singolo strumento"
                : run.InstrumentName;

    private static PriceUpdateResult? RunInstrumentResult(PriceUpdateRun run) =>
        run.Scope == PriceUpdateScope.Instrument
            ? run.Results?.FirstOrDefault(result => result.InstrumentId == run.InstrumentId)
              ?? run.Results?.FirstOrDefault()
            : null;

    private static string PriceText(PriceUpdateResult result) =>
        result.Price is not { } price
            ? "—"
            : result.PriceUnit == PriceUnit.PercentOfNominal
                ? $"{price.ToString("N2", CultureInfo.GetCultureInfo("it-IT"))} %"
                : Format.Money(new Money(price, Currency.Euro));

    private string InstrumentLabel(PriceUpdateResult result)
    {
        var symbol = result.Symbol;
        if (string.IsNullOrWhiteSpace(symbol))
        {
            symbol = AllAssets
                .FirstOrDefault(asset => asset.InstrumentId == result.InstrumentId)
                ?.Symbol;
        }

        if (!string.IsNullOrWhiteSpace(symbol))
        {
            return symbol;
        }

        return string.IsNullOrWhiteSpace(result.Name) ? "—" : result.Name;
    }

    private void OpenRunDetails(PriceUpdateRun run) => _detailRun = run;

    private void CloseRunDetails() => _detailRun = null;

    private static string RunResultLabel(PriceUpdateRun run) =>
        run.Error is not null
            ? "Errore"
            : run.FailureCount > 0
                ? run.FailureCount == 1 ? "1 errore" : $"{run.FailureCount} errori"
                : run.SuccessCount > 0
                    ? "OK"
                    : "Nessuno strumento";

    private static string RunTone(PriceUpdateRun run) =>
        run.HasErrors ? "expense" : run.SuccessCount > 0 ? "income" : "neutral";

    private static string RunTitle(PriceUpdateRun run)
    {
        if (run.Error is not null)
        {
            return run.Error;
        }

        var parts = new List<string>(2);
        if (run.SuccessCount > 0)
        {
            parts.Add($"{run.SuccessCount} aggiornati");
        }

        if (run.FailureCount > 0)
        {
            parts.Add(run.FailureCount == 1 ? "1 errore" : $"{run.FailureCount} errori");
        }

        return string.Join(", ", parts);
    }

    private static string FrequencyLabel(PriceUpdateFrequency frequency) => frequency switch
    {
        PriceUpdateFrequency.Daily => "Ogni giorno",
        PriceUpdateFrequency.Weekdays => "Solo giorni feriali",
        PriceUpdateFrequency.Every12Hours => "Ogni 12 ore",
        PriceUpdateFrequency.Every6Hours => "Ogni 6 ore",
        _ => frequency.ToString(),
    };
}
