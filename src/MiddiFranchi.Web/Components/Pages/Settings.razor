@page "/settings"
@rendermode InteractiveServer
@using System.Reflection
@inject SectionAppearanceService Appearance

<PageTitle>Configurazione</PageTitle>

<div class="settings-page">
    <div class="dashboard-header">
        <div>
            <h1 class="account-detail-title">
                <span class="account-avatar sidebar-tone" aria-hidden="true"><MfIcon Name="@Appearance.Get(AppSection.Settings).Icon" Size="18" /></span>
                Configurazione
            </h1>
        </div>
    </div>

<div class="settings-hub-grid">
    <a class="settings-hub-card accounts" href="/settings/accounts">
        <span class="settings-hub-icon accounts" aria-hidden="true"><MfIcon Name="@Appearance.Get(AppSection.Accounts).Icon" Size="24" /></span>
        <span class="settings-hub-copy">
            <strong>Conti</strong>
            <span>Anagrafica, stato, colore, icona e conti speciali.</span>
        </span>
        <span class="settings-hub-arrow" aria-hidden="true"><MfIcon Name="arrow-right" Size="16" /></span>
    </a>

    <a class="settings-hub-card categories" href="/settings/categories">
        <span class="settings-hub-icon amber" aria-hidden="true"><MfIcon Name="tag" Size="24" /></span>
        <span class="settings-hub-copy">
            <strong>Categorie</strong>
            <span>Entrate, uscite, sottocategorie, spostamento operazioni ed eliminazione sicura.</span>
        </span>
        <span class="settings-hub-arrow" aria-hidden="true"><MfIcon Name="arrow-right" Size="16" /></span>
    </a>

    <a class="settings-hub-card instruments" href="/settings/instruments">
        <span class="settings-hub-icon instruments" aria-hidden="true"><MfIcon Name="@Appearance.Get(AppSection.Investments).Icon" Size="24" /></span>
        <span class="settings-hub-copy">
            <strong>Strumenti finanziari</strong>
            <span>Azioni, obbligazioni, monetario e altro: anagrafica, link e stato.</span>
        </span>
        <span class="settings-hub-arrow" aria-hidden="true"><MfIcon Name="arrow-right" Size="16" /></span>
    </a>

    <a class="settings-hub-card prices" href="/settings/price-updates">
        <span class="settings-hub-icon prices" aria-hidden="true"><MfIcon Name="refresh" Size="24" /></span>
        <span class="settings-hub-copy">
            <strong>Aggiornamento prezzi</strong>
            <span>Stato del servizio, orario, frequenza e aggiornamento manuale delle quotazioni.</span>
        </span>
        <span class="settings-hub-arrow" aria-hidden="true"><MfIcon Name="arrow-right" Size="16" /></span>
    </a>

    <a class="settings-hub-card data" href="/settings/data">
        <span class="settings-hub-icon data" aria-hidden="true"><MfIcon Name="package" Size="24" /></span>
        <span class="settings-hub-copy">
            <strong>Dati e backup</strong>
            <span>Eliminazione selettiva, esportazione e ripristino completo dei dati.</span>
        </span>
        <span class="settings-hub-arrow" aria-hidden="true"><MfIcon Name="arrow-right" Size="16" /></span>
    </a>

    <a class="settings-hub-card appearance" href="/settings/appearance">
        <span class="settings-hub-icon appearance" aria-hidden="true"><MfIcon Name="palette" Size="24" /></span>
        <span class="settings-hub-copy">
            <strong>Aspetto sezioni</strong>
            <span>Icona e colore di Dashboard, Conti, Investimenti, Movimenti e Configurazione.</span>
        </span>
        <span class="settings-hub-arrow" aria-hidden="true"><MfIcon Name="arrow-right" Size="16" /></span>
    </a>
</div>

<footer class="settings-version" aria-label="Informazioni sulla versione">
    <span>MiddiFranchi @AppVersion</span>
    <span aria-hidden="true">·</span>
    <span>Build @BuildDate</span>
</footer>
</div>

@code {
    private static readonly string AppVersion = ResolveAppVersion();
    private static readonly string BuildDate = ResolveBuildDate();

    private static string ResolveAppVersion()
    {
        var assembly = typeof(Settings).Assembly;
        var informational = assembly
            .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>()?
            .InformationalVersion;

        if (!string.IsNullOrWhiteSpace(informational))
        {
            return informational.Split('+')[0];
        }

        return assembly.GetName().Version?.ToString(3) ?? "n/d";
    }

    private static string ResolveBuildDate()
    {
        var location = typeof(Settings).Assembly.Location;
        return string.IsNullOrWhiteSpace(location) || !File.Exists(location)
            ? "n/d"
            : File.GetLastWriteTime(location).ToString("dd/MM/yyyy");
    }
}
