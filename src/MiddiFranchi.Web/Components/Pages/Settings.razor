@page "/settings"
@rendermode InteractiveServer
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@inject AccountOverviewService Overview
@inject AccountService AccountsService

<PageTitle>Configurazione</PageTitle>
<h1>Configurazione</h1>
<p class="page-intro">
    Gestisci i conti e le categorie dell'applicazione in un unico posto.
</p>

@if (_loading)
{
    <p class="page-status" role="status">Caricamento in corso…</p>
}
else if (_loadError is not null)
{
    <p class="alert alert-error" role="alert">@_loadError</p>
}
else
{
    <div class="bento">
        <div class="sp-7">
            <section class="card" aria-labelledby="settings-accounts-title">
                <div class="section-head">
                    <div class="section-title-row">
                        <h2 id="settings-accounts-title"><MfIcon Name="wallet" Size="18" /> Conti</h2>
                        <StatusBadge Tone="accounts">@AccountCountLabel</StatusBadge>
                    </div>
                </div>

                @if (_createdMessage is not null)
                {
                    <p class="alert alert-success" role="status">@_createdMessage</p>
                }
                @if (_rows.Count == 0)
                {
                    <EmptyState Title="Nessun conto registrato"
                                Hint="Aggiungi il primo conto dal modulo accanto."
                                Icon="wallet" />
                }
                else
                {
                    <div class="table-scroll" tabindex="0">
                        <table class="data-table settings-accounts-table">
                            <thead>
                                <tr>
                                    <th scope="col">Conto</th>
                                    <th scope="col">Stato</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _rows)
                                {
                                    <tr>
                                        <td>
                                            <button type="button"
                                                    class="settings-account-link"
                                                    aria-label="@($"Impostazioni di {row.Name}")"
                                                    title="Apri impostazioni conto"
                                                    @onclick="() => OpenSettings(row)">
                                                <AccountAvatar Name="@row.Name" Type="@row.Type" IconDataUrl="@row.IconDataUrl" />
                                                <span class="settings-account-name-text">@row.Name</span>
                                                @if (IsSpecialAccount(row.AccountId))
                                                {
                                                    <StatusBadge Tone="brand">Speciale</StatusBadge>
                                                }
                                            </button>
                                        </td>
                                        <td>
                                            <StatusBadge Tone="@(row.Status == AccountStatus.Active ? "income" : "neutral")">
                                                @Format.AccountStatusLabel(row.Status)
                                            </StatusBadge>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="table-hint">
                        I conti speciali Cash e Prestiti non possono essere eliminati; possono essere
                        disattivati dalle impostazioni. Un conto con operazioni registrate non può essere eliminato.
                    </p>
                }
            </section>
        </div>

        <div class="sp-5">
            <section class="card">
                <div class="section-head">
                    <div>
                        <h2><MfIcon Name="plus" Size="18" /> Aggiungi conto</h2>
                    </div>
                </div>
                @if (_createError is not null)
                {
                    <p class="alert alert-error" role="alert">@_createError</p>
                }
                <div class="preset-grid" aria-label="Conti predefiniti">
                    @foreach (var preset in AccountPresets)
                    {
                        <button type="button"
                                class="@(IsSelectedPreset(preset) ? "preset-tile selected" : "preset-tile")"
                                title="@preset"
                                aria-pressed="@IsSelectedPreset(preset)"
                                @onclick="() => SelectPreset(preset)">
                            <AccountAvatar Name="@preset" Type="AccountType.Checking" />
                            <span class="preset-name">@preset</span>
                        </button>
                    }
                    <button type="button"
                            class="@(_customAccount ? "preset-tile new selected" : "preset-tile new")"
                            title="Nuovo conto"
                            aria-pressed="@_customAccount"
                            @onclick="SelectCustom">
                        <span class="preset-plus"><MfIcon Name="plus" Size="16" /></span>
                        <span class="preset-name">Nuovo conto</span>
                    </button>
                </div>

                @if (_customAccount)
                {
                    <form class="form-grid" @onsubmit="CreateAccountAsync">
                        <label>
                            <span>Nome *</span>
                            <input type="text" maxlength="200" required aria-required="true" @bind="_name" />
                        </label>
                        <div class="form-actions">
                            <button type="submit" class="primary-button" disabled="@_creating">
                                <MfIcon Name="plus" Size="18" /> Aggiungi conto
                            </button>
                        </div>
                    </form>
                }
                else if (_selectedPreset is { } selectedPreset)
                {
                    <p class="preset-summary">
                        <span>Selezionato:</span>
                        <strong>@selectedPreset</strong>
                    </p>
                    <div class="form-actions">
                        <button type="button" class="primary-button" disabled="@_creating" @onclick="CreateAccountAsync">
                            <MfIcon Name="plus" Size="18" /> Aggiungi conto
                        </button>
                    </div>
                }
                else
                {
                    <p class="table-hint">Scegli un conto predefinito oppure seleziona «Nuovo conto».</p>
                }

                <p class="table-hint">
                    Dopo la creazione puoi configurare nome, stato, colore e icona dall'ingranaggio.
                </p>
            </section>
        </div>
    </div>

    <h2 class="settings-subtitle"><MfIcon Name="tag" Size="18" /> Categorie</h2>
    <CategoryManagementPanel />

    @if (_settingsRow is { } selected)
    {
        <AccountSettingsDialog Open="_settingsOpen"
                               AccountId="@selected.AccountId"
                               Name="@selected.Name"
                               Type="@selected.Type"
                               Status="@selected.Status"
                               ColorHex="@selected.ColorHex"
                               IconDataUrl="@selected.IconDataUrl"
                               CanDelete="@(!IsSpecialAccount(selected.AccountId))"
                               OnClose="CloseSettings"
                               OnSaved="OnAccountSettingsSaved"
                               OnDeleted="OnAccountDeleted" />
    }
}

@code {
    private static readonly string[] AccountPresets =
    [
        "BBVA",
        "Banco di Sardegna",
        "Directa",
        "ING",
        "Intesa San Paolo",
        "PayPal",
        "PostePay",
        "Revolut",
        "Unicredit",
    ];

    private IReadOnlyList<AccountOverviewRow> _rows = [];
    private bool _loading = true;
    private string? _loadError;
    private string _name = "";
    private string? _selectedPreset;
    private bool _customAccount;
    private bool _creating;
    private string? _createError;
    private string? _createdMessage;
    private AccountOverviewRow? _settingsRow;
    private bool _settingsOpen;

    private string AccountCountLabel =>
        _rows.Count == 1 ? "1 conto" : $"{_rows.Count} conti";

    private static bool IsSpecialAccount(Guid accountId) =>
        accountId == SpecialAccountsSeeder.CashAccountId ||
        accountId == SpecialAccountsSeeder.LoansAccountId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
        _loading = false;
    }

    private async Task LoadAccountsAsync()
    {
        try
        {
            _loadError = null;
            _rows = await Overview.ListAsync();
        }
        catch (InvalidOperationException exception) when (exception.Message.Contains("connection string", StringComparison.OrdinalIgnoreCase))
        {
            _loadError = "Il database non è configurato. Impostare la connection string 'ConnectionStrings:DefaultConnection' nelle variabili d'ambiente o nei user secrets.";
        }
        catch (Exception)
        {
            _loadError = "Impossibile contattare il database. Verificare che PostgreSQL sia raggiungibile e che la connection string sia corretta.";
        }
    }

    private bool IsSelectedPreset(string preset) =>
        !_customAccount && string.Equals(_selectedPreset, preset, StringComparison.Ordinal);

    private void SelectPreset(string preset)
    {
        _selectedPreset = preset;
        _customAccount = false;
        _createError = null;
        _name = preset;
    }

    private void SelectCustom()
    {
        _selectedPreset = null;
        _customAccount = true;
        _createError = null;
        _name = "";
    }

    private async Task CreateAccountAsync()
    {
        if (_creating)
        {
            return;
        }

        _createError = null;
        _createdMessage = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _createError = "Il nome del conto è obbligatorio.";
            return;
        }

        _creating = true;
        try
        {
            var created = await AccountsService.CreateAsync(
                new NewAccount(_name, AccountType.Checking));
            _createdMessage = $"Conto «{created.Name}» registrato.";
            _name = "";
            _selectedPreset = null;
            _customAccount = false;
            await LoadAccountsAsync();
        }
        catch (ArgumentException exception)
        {
            _createError = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _createError = exception.Message;
        }
        catch (Exception)
        {
            _createError = "Creazione non riuscita: verificare la connessione al database e riprovare.";
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task OnAccountDeleted()
    {
        _createdMessage = "Conto eliminato.";
        await LoadAccountsAsync();
    }

    private void OpenSettings(AccountOverviewRow row)
    {
        _settingsRow = row;
        _settingsOpen = true;
    }

    private void CloseSettings()
    {
        _settingsOpen = false;
        _settingsRow = null;
    }

    private async Task OnAccountSettingsSaved(Account account)
    {
        _createdMessage = "Impostazioni conto aggiornate.";
        await LoadAccountsAsync();
    }
}
