@page "/accounts"
@rendermode InteractiveServer
@using System.Globalization
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@using MiddiFranchi.Domain.Shared
@inject AccountOverviewService Overview
@inject ManualBalanceService ManualBalanceSvc
@inject NotificationService Notifications
@inject ChartPreferences Preferences
@inject SectionAppearanceService Appearance

<PageTitle>Conti</PageTitle>

<div class="dashboard-header">
    <h1 class="account-detail-title">
        <span class="account-avatar accounts" aria-hidden="true"><MfIcon Name="@Appearance.Get(AppSection.Accounts).Icon" Size="18" /></span>
        Conti
    </h1>
    <div class="dashboard-header-meta">
        <a class="secondary-button" href="/settings/accounts">
            <MfIcon Name="settings" Size="16" /> Gestisci conti
        </a>
    </div>
</div>

@if (_loading)
{
    <section class="card dashboard-loading" aria-live="polite">
        <p class="page-status" role="status">Caricamento in corso…</p>
    </section>
}
else if (_loadError is not null)
{
    <section class="card">
        <p class="alert alert-error" role="alert">@_loadError</p>
        <div class="form-actions">
            <button type="button" class="secondary-button" @onclick="LoadRowsAsync">Riprova</button>
        </div>
    </section>
}
else
{
    @if (_rows is { Count: > 0 })
    {
        <div class="bento">
            <div class="sp-12">
                <section class="card accounts-chart-card" aria-labelledby="accounts-history-title">
                    <div class="section-head">
                        <div>
                            <h2 id="accounts-history-title"><MfIcon Name="chart" Size="18" /> Valore conti</h2>
                        </div>
                        <div class="accounts-chart-controls">
                            <div class="overview-ranges" role="group" aria-label="Intervallo temporale">
                                @foreach (var option in ChartRangeOptions)
                                {
                                    <button type="button" class="@ChartRanges.Class(option.Key, _range)" aria-pressed="@AriaPressed(_range == option.Key)" @onclick="() => SetRangeAsync(option.Key)">@option.Label</button>
                                }
                            </div>
                            <div class="overview-ranges" role="group" aria-label="Tipo di grafico">
                                @foreach (var option in ChartKindOptions)
                                {
                                    <button type="button" class="@ChartRanges.Class(option.Key, ChartKindKey)" aria-pressed="@AriaPressed(ChartKindKey == option.Key)" @onclick="() => SetChartKindAsync(option.Kind)">@option.Label</button>
                                }
                            </div>
                            <details class="filter-menu-wrap accounts-chart-filter">
                                <summary class="filter-trigger @(HasChartAccountFilter ? "active" : "")">
                                    <MfIcon Name="filter" Size="15" />
                                    <span>@ChartAccountsLabel</span>
                                    <MfIcon Name="chevron-down" Size="13" />
                                </summary>
                                <div class="filter-panel accounts-chart-panel">
                                    <button type="button"
                                            class="filter-option @(_chartAccountIds.Count == 0 ? "selected" : "")"
                                            @onclick="SelectAllChartAccountsAsync">
                                        Tutti i conti
                                    </button>
                                    @foreach (var row in ChartAccountOptions)
                                    {
                                        <label class="filter-check">
                                            <input type="checkbox"
                                                   checked="@_chartAccountIds.Contains(row.AccountId)"
                                                   @onchange="args => ToggleChartAccountAsync(row.AccountId, args)" />
                                            <span>@row.Name</span>
                                        </label>
                                    }
                                </div>
                            </details>
                        </div>
                    </div>

                    <div class="accounts-current">
                        <div class="balance-main">
                            <span class="balance-value">
                                <AmountValue Value="@CurrentAccountsTotal" UnavailableText="Non calcolabile" />
                            </span>
                            @if (AccountsWithoutBalanceCount > 0)
                            {
                                <span class="table-hint">
                                    @if (AccountsWithoutBalanceCount == 1)
                                    {
                                        <text>1 conto senza saldo escluso dal totale.</text>
                                    }
                                    else
                                    {
                                        <text>@AccountsWithoutBalanceCount conti senza saldo esclusi dal totale.</text>
                                    }
                                </span>
                            }
                        </div>
                        @if (CurrentAccountsTotal is not null && AccountsWithoutBalanceCount > 0)
                        {
                            <StatusBadge Tone="warning">Parziale</StatusBadge>
                        }
                    </div>

                    @if (HasChartData)
                    {
                        <ApexTimeSeriesChart Title=""
                                             Currency="@_rows[0].Currency"
                                             Series="@ChartSeries"
                                             Stacked="@(_chartKind != AccountsChartKind.Line)"
                                             ShowStackedTotal="false"
                                             ShowHeader="false"
                                             ShowFooter="false"
                                             ShowDataTable="false"
                                             ShowMarkers="false"
                                             XAxisLabelMode="month" />

                        @if (ChartStatistics is { } statistics)
                        {
                            <dl class="chart-stats">
                                <div>
                                    <dt>Valore massimo</dt>
                                    <dd><AmountValue Value="@statistics.Maximum" Tone="balance" /></dd>
                                </div>
                                <div>
                                    <dt>Valore minimo</dt>
                                    <dd><AmountValue Value="@statistics.Minimum" Tone="balance" /></dd>
                                </div>
                                <div>
                                    <dt>Valore medio</dt>
                                    <dd><AmountValue Value="@statistics.Average" Tone="balance" /></dd>
                                </div>
                                <div>
                                    <dt>Variazione media mensile</dt>
                                    <dd><AmountValue Value="@statistics.AverageMonthlyChange" Signed="true" Tone="@Tone(statistics.AverageMonthlyChange)" /></dd>
                                </div>
                                <div>
                                    <dt>Variazione media annuale</dt>
                                    <dd><AmountValue Value="@statistics.AverageAnnualChange" Signed="true" Tone="@Tone(statistics.AverageAnnualChange)" /></dd>
                                </div>
                            </dl>
                        }
                    }
                    else
                    {
                        <EmptyState Title="Nessuna rilevazione nel periodo"
                                    Hint="Scegli un intervallo più ampio o registra una nuova rilevazione."
                                    Icon="chart" />
                    }
                </section>
            </div>
        </div>
    }

    <div class="bento compact-pie-row">
        <div class="chart-panel">
            <section class="card" aria-labelledby="accounts-list-title">
                <div class="section-head">
                    <div class="section-title-row">
                        <h2 id="accounts-list-title"><MfIcon Name="wallet" Size="18" /> Elenco dei conti</h2>
                        @if (_rows is { Count: > 0 })
                        {
                            <StatusBadge Tone="accounts">@AccountCountLabel</StatusBadge>
                        }
                    </div>
                    @if (_rows is { Count: > 0 })
                    {
                        <button type="button" class="small-toggle" aria-pressed="@_hideClosedAccounts" @onclick="ToggleHideClosedAccounts">
                            @(_hideClosedAccounts ? "Mostra chiusi" : "Nascondi chiusi")
                        </button>
                    }
                </div>

                @if (_rows is null || _rows.Count == 0)
                {
                    <EmptyState Title="Nessun conto registrato"
                                Hint="I conti esistenti compaiono qui."
                                Icon="wallet" />
                }
                else if (VisibleAccountRows.Count == 0)
                {
                    <EmptyState Title="Nessun conto visibile"
                                Hint="I conti chiusi sono nascosti. Usa «Mostra chiusi» per visualizzarli."
                                Icon="wallet" />
                }
                else
                {
                    <ul class="account-summary-list">
                        @foreach (var row in VisibleAccountRows)
                        {
                            <li class="account-summary-row">
                                <AccountAvatar Name="@row.Name" Type="@row.Type" IconDataUrl="@row.IconDataUrl" />
                                <div class="account-summary-main">
                                    <a class="account-summary-name" href="accounts/@AccountKey(row.AccountId)" title="@row.Name">
                                        @row.Name
                                    </a>
                                    <span class="account-summary-meta">
                                        @if (row.ManualReading is not null)
                                        {
                                            <span>@Format.Date(row.ManualReading.ValidAt)</span>
                                        }
                                        @if (row.Status == AccountStatus.Closed)
                                        {
                                            <StatusBadge Tone="neutral">@Format.AccountStatusLabel(row.Status)</StatusBadge>
                                        }
                                    </span>
                                </div>
                                <div class="account-summary-balance">
                                    @if (row.ManualBalance is null)
                                    {
                                        <span class="account-balance-missing">
                                            <MfIcon Name="alert" Size="14" /> Saldo non registrato
                                        </span>
                                    }
                                    else
                                    {
                                        <AmountValue Value="@row.ManualBalance" />
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                    @if (AccountsWithoutBalanceCount > 0)
                    {
                        <p class="account-note">
                            <MfIcon Name="alert" Size="14" />
                            @(AccountsWithoutBalanceCount == 1
                                ? "1 conto senza saldo manuale: escluso dal totale parziale."
                                : $"{AccountsWithoutBalanceCount} conti senza saldo manuale: esclusi dal totale parziale.")
                        </p>
                    }
                }
            </section>
        </div>

        <div class="pie-panel">
            <section class="card accounts-distribution-card" aria-labelledby="accounts-distribution-title">
                <div class="section-head">
                    <div>
                        <h2 id="accounts-distribution-title"><MfIcon Name="pie" Size="18" /> Distribuzione del totale</h2>
                    </div>
                </div>

                @if (AccountSlices.Count > 0)
                {
                    <div class="alternative-pie-layout">
                        <figure class="alternative-pie-figure">
                            <div class="allocation-donut alternative-pie-donut">
                                <svg viewBox="0 0 42 42" aria-hidden="true" focusable="false" @onmouseleave="ClearAccountHover">
                                    <circle class="allocation-track" cx="21" cy="21" r="15.9155" pathLength="100" />
                                    @foreach (var slice in AccountSlices)
                                    {
                                        <circle class="expense-pie-segment alternative-pie-segment @(_accountHoverSlice?.Label == slice.Label ? "hovered" : "")"
                                                cx="21" cy="21" r="15.9155"
                                                pathLength="100" transform="rotate(-90 21 21)"
                                                stroke="@slice.Color"
                                                stroke-dasharray="@DashArray(slice.Share)"
                                                stroke-dashoffset="@DashOffset(slice.Offset)"
                                                @onmouseover="() => SetAccountHover(slice)">
                                            <title>@slice.Label: @Format.Money(slice.Amount) (@Format.Percent(slice.Share))</title>
                                        </circle>
                                    }
                                </svg>
                                <div class="allocation-center alternative-pie-center">
                                    @if (_accountHoverSlice is { } hover)
                                    {
                                        <span class="allocation-center-label" style="color: @hover.Color">@hover.Label</span>
                                        <strong class="allocation-center-value">@Format.Money(hover.Amount)</strong>
                                        <span class="allocation-center-sub">@Format.Percent(hover.Share)</span>
                                    }
                                    else
                                    {
                                        <span class="allocation-center-label">Totale</span>
                                        <strong class="allocation-center-value">@Format.Money(AccountSlicesTotal.GetValueOrDefault())</strong>
                                        <span class="allocation-center-sub">@AccountSlices.Count conti</span>
                                    }
                                </div>
                            </div>
                            <figcaption class="visually-hidden">@AccountDistributionDescription</figcaption>
                        </figure>
                    </div>

                    @if (AccountsExcludedFromDistribution > 0)
                    {
                        <p class="account-note">
                            <MfIcon Name="alert" Size="14" />
                            @(AccountsExcludedFromDistribution == 1
                                ? "1 conto senza saldo positivo è escluso dalla ripartizione."
                                : $"{AccountsExcludedFromDistribution} conti senza saldo positivo sono esclusi dalla ripartizione.")
                        </p>
                    }
                }
                else
                {
                    <EmptyState Title="Ripartizione non disponibile"
                                Hint="Registra almeno un saldo manuale positivo per visualizzare la distribuzione tra i conti."
                                Icon="pie" />
                }
            </section>
        </div>
    </div>

    @if (_rows is { Count: > 0 })
    {
        <button type="button" class="fab-add" aria-label="Nuova rilevazione" @onclick="OpenReadingDialog">
            <MfIcon Name="plus" Size="24" />
        </button>
    }

    <ManualBalanceDialog Open="_readingDialogOpen"
                         Accounts="@ReadingAccountChoices"
                         OnClose="CloseReadingDialog"
                         OnSaved="OnReadingSaved" />
}

@code {
    private IReadOnlyList<AccountOverviewRow>? _rows;
    private IReadOnlyDictionary<Guid, string> _routeKeys = new Dictionary<Guid, string>();
    private IReadOnlyList<ManualBalance> _allReadings = [];
    private AccountsChartKind _chartKind = AccountsChartKind.Both;
    private readonly HashSet<Guid> _chartAccountIds = [];
    private static readonly (string Key, string Label, AccountsChartKind Kind)[] ChartKindOptions =
    [
        ("both", "Barre e linea", AccountsChartKind.Both),
        ("bars", "Barre", AccountsChartKind.Bars),
        ("line", "Linea", AccountsChartKind.Line),
    ];
    private bool _loading = true;
    private bool _hideClosedAccounts = true;
    private string _range = "max";
    private bool _preferencesLoaded;
    private bool _readingDialogOpen;
    private string? _loadError;
    private CategoryBreakdownItem? _accountHoverSlice;

    private int AccountsWithoutBalanceCount =>
        _rows?.Count(row => row.ManualBalance is null) ?? 0;

    private IReadOnlyList<AccountOverviewRow> VisibleAccountRows
    {
        get
        {
            if (_rows is null)
            {
                return [];
            }

            var rows = _hideClosedAccounts
                ? _rows.Where(row => row.Status == AccountStatus.Active)
                : _rows;
            return rows.OrderBy(row => AccountGroupOrder(row.Type)).ToArray();
        }
    }

    private string AccountKey(Guid accountId) =>
        _routeKeys.TryGetValue(accountId, out var key) ? key : accountId.ToString();

    private static int AccountGroupOrder(AccountType type) => type switch
    {
        AccountType.Cash => 1,
        AccountType.Loans => 2,
        _ => 0,
    };

    private string AccountChartColor(AccountOverviewRow row)
    {
        if (!string.IsNullOrWhiteSpace(row.ColorHex))
        {
            return row.ColorHex;
        }

        var index = 0;
        if (_rows is { } rows)
        {
            for (var position = 0; position < rows.Count; position++)
            {
                if (rows[position].AccountId == row.AccountId)
                {
                    index = position;
                    break;
                }
            }
        }

        return ChartPalette.Colors[index % ChartPalette.Colors.Length];
    }

    private IReadOnlyList<CategoryBreakdownItem> AccountSlices
    {
        get
        {
            var rows = VisibleAccountRows
                .Where(row => row.ManualBalance is { Amount: > 0m })
                .ToArray();
            var total = rows.Sum(row => row.ManualBalance!.Value.Amount);
            if (total <= 0m)
            {
                return [];
            }

            var slices = new List<CategoryBreakdownItem>(rows.Length);
            var offset = 0m;
            for (var index = 0; index < rows.Length; index++)
            {
                var row = rows[index];
                var amount = row.ManualBalance!.Value;
                var share = amount.Amount / total;
                slices.Add(new CategoryBreakdownItem(
                    row.Name,
                    amount,
                    share,
                    AccountChartColor(row),
                    offset));
                offset += share;
            }

            return slices;
        }
    }

    private Money? AccountSlicesTotal => AccountSlices.Count == 0
        ? null
        : new Money(AccountSlices.Sum(slice => slice.Amount.Amount), AccountCurrency);

    private int AccountsExcludedFromDistribution =>
        VisibleAccountRows.Count(row => row.ManualBalance is not { Amount: > 0m });

    private Currency AccountCurrency =>
        _rows is { Count: > 0 } ? _rows[0].Currency : Currency.Euro;

    private string AccountDistributionDescription => AccountSlices.Count == 0
        ? string.Empty
        : $"Distribuzione del totale tra i conti: {string.Join(", ", AccountSlices.Select(slice => $"{slice.Label} {Format.Money(slice.Amount)} ({Format.Percent(slice.Share)})"))}. " +
          $"Totale {Format.Money(AccountSlicesTotal.GetValueOrDefault())}.";

    private string AccountCountLabel =>
        VisibleAccountRows.Count == 1 ? "1 conto" : $"{VisibleAccountRows.Count} conti";

    private IReadOnlyList<ManualBalanceDialog.AccountChoice> ReadingAccountChoices =>
        _rows?
            .Where(row => row.Type != AccountType.Loans)
            .Select(row => new ManualBalanceDialog.AccountChoice(row.AccountId, row.Name, row.Type, row.IconDataUrl))
            .ToArray() ?? [];

    private IReadOnlyList<TimeSeriesSeries> ChartSeries
    {
        get
        {
            var series = BuildChartSeries();
            return _chartKind == AccountsChartKind.Bars
                ? series.Where(item => item.Label != "Totale").ToArray()
                : series;
        }
    }

    private string ChartKindKey => ChartKindOptions
        .First(option => option.Kind == _chartKind)
        .Key;

    private bool HasChartAccountFilter => _chartAccountIds.Count > 0;

    private string ChartAccountsLabel => _chartAccountIds.Count == 0
        ? "Tutti i conti"
        : _chartAccountIds.Count == 1
            ? "1 conto"
            : $"{_chartAccountIds.Count} conti";

    private IReadOnlyList<AccountOverviewRow> ChartAccountOptions => _rows?
        .Where(row => _allReadings.Any(reading => reading.AccountId == row.AccountId))
        .OrderBy(row => row.Name, StringComparer.CurrentCultureIgnoreCase)
        .ToArray() ?? [];

    private bool HasChartData =>
        ChartSeries.Any(series => series.Points.Any(point => point.Value is not null));

    private Money? CurrentAccountsTotal
    {
        get
        {
            if (_rows is null)
            {
                return null;
            }

            Money? total = null;
            foreach (var row in _rows)
            {
                if (row.ManualBalance is { } balance)
                {
                    total = total is null ? balance : total.Value + balance;
                }
            }

            return total;
        }
    }

    private AccountChartStatistics? ChartStatistics
    {
        get
        {
            if (_rows is null)
            {
                return null;
            }

            var series = BuildChartSeries().FirstOrDefault(candidate => candidate.Label == "Totale");
            if (series is null)
            {
                return null;
            }

            var values = series.Points
                .Where(point => point.Value is not null)
                .Select(point => point.Value!.Value)
                .ToArray();

            if (values.Length == 0)
            {
                return null;
            }

            var currency = _rows[0].Currency;
            Money? monthlyChange = null;
            Money? annualChange = null;

            if (values.Length >= 2)
            {
                var averageMonthly = (values[^1] - values[0]) / (values.Length - 1);
                monthlyChange = new Money(averageMonthly, currency);
                annualChange = new Money(averageMonthly * 12m, currency);
            }

            return new AccountChartStatistics(
                new Money(values.Max(), currency),
                new Money(values.Min(), currency),
                new Money(values.Average(), currency),
                monthlyChange,
                annualChange);
        }
    }

    private IReadOnlyList<(string Key, string Label)> ChartRangeOptions
    {
        get
        {
            var years = _allReadings
                .Select(reading => reading.ValidAt.Year)
                .Distinct()
                .OrderByDescending(year => year)
                .ToArray();
            var options = new List<(string Key, string Label)>
            {
                ("year", "Anno"),
                ("max", "Max"),
            };
            options.AddRange(years.Select(year => (year.ToString(), year.ToString())));
            return options;
        }
    }

    private DateOnly? RangeStart
    {
        get
        {
            if (int.TryParse(_range, out var year))
            {
                return new DateOnly(year, 1, 1);
            }

            return ChartRanges.Start(_range, DateOnly.FromDateTime(DateTime.UtcNow));
        }
    }

    private DateOnly? RangeEnd =>
        int.TryParse(_range, out var year) ? new DateOnly(year, 12, 31) : null;

    protected override async Task OnInitializedAsync()
    {
        await LoadRowsAsync();
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _preferencesLoaded)
        {
            return;
        }

        _preferencesLoaded = true;
        var storedHideClosed = await Preferences.GetAsync("mf.filters.accounts.hideClosed");
        if (storedHideClosed is "0")
        {
            _hideClosedAccounts = false;
        }
        else if (storedHideClosed is "1")
        {
            _hideClosedAccounts = true;
        }

        var storedRange = await Preferences.GetAsync("mf.chart.accounts.range");
        if (storedRange is not null &&
            (storedRange == "year" ||
             storedRange == "max" ||
             int.TryParse(storedRange, out _)))
        {
            _range = storedRange;
        }

        var storedKind = await Preferences.GetAsync("mf.chart.accounts.kind");
        if (Enum.TryParse<AccountsChartKind>(storedKind, ignoreCase: true, out var kind) &&
            Enum.IsDefined(kind))
        {
            _chartKind = kind;
        }

        var storedAccounts = await Preferences.GetAsync("mf.chart.accounts.selected");
        if (!string.IsNullOrWhiteSpace(storedAccounts) && _rows is not null)
        {
            var validIds = _rows.Select(row => row.AccountId).ToHashSet();
            foreach (var part in storedAccounts.Split(',', StringSplitOptions.RemoveEmptyEntries))
            {
                if (Guid.TryParse(part, out var accountId) && validIds.Contains(accountId))
                {
                    _chartAccountIds.Add(accountId);
                }
            }
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task SetRangeAsync(string range)
    {
        _range = range;
        await Preferences.SetAsync("mf.chart.accounts.range", range);
    }

    private async Task SetChartKindAsync(AccountsChartKind kind)
    {
        _chartKind = kind;
        await Preferences.SetAsync("mf.chart.accounts.kind", ChartKindKey);
    }

    private async Task ToggleChartAccountAsync(Guid accountId, ChangeEventArgs args)
    {
        if (args.Value is bool selected)
        {
            if (selected)
            {
                _chartAccountIds.Add(accountId);
            }
            else
            {
                _chartAccountIds.Remove(accountId);
            }
        }

        await SaveChartAccountsAsync();
    }

    private async Task SelectAllChartAccountsAsync()
    {
        _chartAccountIds.Clear();
        await SaveChartAccountsAsync();
    }

    private Task SaveChartAccountsAsync() =>
        Preferences.SetAsync("mf.chart.accounts.selected", string.Join(",", _chartAccountIds));

    private async Task LoadRowsAsync()
    {
        try
        {
            _loadError = null;
            _accountHoverSlice = null;
            _allReadings = [];
            _rows = await Overview.ListAsync();
            _routeKeys = RouteKey.BuildKeys(_rows, row => row.AccountId, row => row.Name, "conto");
            _allReadings = await ManualBalanceSvc.ListAllAsync();
        }
        catch (InvalidOperationException exception) when (exception.Message.Contains("CONNECTION", StringComparison.OrdinalIgnoreCase) || exception.Message.Contains("connection string", StringComparison.OrdinalIgnoreCase))
        {
            _loadError = "Il database non è configurato. Impostare la connection string 'ConnectionStrings:DefaultConnection' nelle variabili d'ambiente o nei user secret.";
        }
        catch (InvalidOperationException exception)
        {
            _loadError = $"Impossibile leggere i conti: {exception.Message}";
        }
        catch (Exception)
        {
            _loadError = "Impossibile contattare il database. Verificare che PostgreSQL sia raggiungibile e che la connection string sia corretta.";
        }
    }

    private IReadOnlyList<TimeSeriesSeries> BuildChartSeries()
    {
        if (_rows is null || _allReadings.Count == 0)
        {
            return [];
        }

        var start = RangeStart;
        var end = RangeEnd;
        var months = MonthEnds(
                _allReadings.Min(reading => reading.ValidAt),
                _allReadings.Max(reading => reading.ValidAt))
            .Where(monthEnd => start is null || monthEnd >= start.Value)
            .Where(monthEnd => end is null || monthEnd <= end.Value)
            .ToArray();

        if (months.Length == 0)
        {
            return [];
        }

        var chartRows = _rows
            .Where(row => _chartAccountIds.Count == 0 || _chartAccountIds.Contains(row.AccountId))
            .ToArray();
        var readingsByAccount = chartRows.ToDictionary(
            row => row.AccountId,
            row => _allReadings.Where(reading => reading.AccountId == row.AccountId).ToArray());

        var series = new List<TimeSeriesSeries>();
        foreach (var row in chartRows)
        {
            var readings = readingsByAccount[row.AccountId];
            if (readings.Length == 0)
            {
                continue;
            }

            var points = months
                .Select(monthEnd => new TimeSeriesPoint(
                    monthEnd,
                    ManualBalances.LatestOnOrBefore(readings, row.AccountId, monthEnd)?.Amount.Amount))
                .ToArray();
            if (points.All(point => point.Value is null))
            {
                continue;
            }

            series.Add(new TimeSeriesSeries(
                row.Name,
                points,
                AccountChartColor(row),
                TimeSeriesSeriesKind.Bar));
        }

        if (series.Count == 0)
        {
            return [];
        }

        var totalPoints = months
            .Select(monthEnd =>
            {
                decimal? total = null;
                foreach (var (accountId, readings) in readingsByAccount)
                {
                    if (readings.Length == 0)
                    {
                        continue;
                    }

                    var value = ManualBalances
                        .LatestOnOrBefore(readings, accountId, monthEnd)?.Amount.Amount;
                    if (value is not null)
                    {
                        total = (total ?? 0m) + value.Value;
                    }
                }

                return new TimeSeriesPoint(monthEnd, total);
            })
            .ToArray();

        if (totalPoints.Any(point => point.Value is not null))
        {
            series.Add(new TimeSeriesSeries("Totale", totalPoints, Color: "#94a3b8"));
        }

        return series;
    }

    /// <summary>Un punto per mese, alla data di fine mese: l'ultima rilevazione disponibile nel mese.</summary>
    private static IEnumerable<DateOnly> MonthEnds(DateOnly from, DateOnly to)
    {
        var cursor = new DateOnly(from.Year, from.Month, 1);
        var last = new DateOnly(to.Year, to.Month, 1);
        while (cursor <= last)
        {
            yield return new DateOnly(
                cursor.Year,
                cursor.Month,
                DateTime.DaysInMonth(cursor.Year, cursor.Month));
            cursor = cursor.AddMonths(1);
        }
    }

    private static string AriaPressed(bool value) => value ? "true" : "false";

    private void SetAccountHover(CategoryBreakdownItem slice) => _accountHoverSlice = slice;

    private void ClearAccountHover() => _accountHoverSlice = null;

    private static string DashArray(decimal share)
    {
        var value = Math.Clamp(share, 0m, 1m) * 100m;
        return $"{Invariant(value)} {Invariant(100m - value)}";
    }

    private static string DashOffset(decimal offset) =>
        Invariant(-Math.Clamp(offset, 0m, 1m) * 100m);

    private static string Invariant(decimal value) =>
        value.ToString("0.###", CultureInfo.InvariantCulture);

    private async Task ToggleHideClosedAccounts()
    {
        _hideClosedAccounts = !_hideClosedAccounts;
        await Preferences.SetBoolAsync("mf.filters.accounts.hideClosed", _hideClosedAccounts);
    }

    private static string Tone(Money? value) => value switch
    {
        { Amount: > 0m } => "income",
        { Amount: < 0m } => "expense",
        _ => "neutral",
    };

