@page "/"
@rendermode InteractiveServer
@using System.Globalization
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@using MiddiFranchi.Domain.Shared
@inject FinancialDashboardService DashboardService
@inject DashboardOverviewService OverviewService
@inject CategoryService CategoriesService
@inject InvestmentWorkspaceService Investments
@inject NotificationService Notifications
@inject NavigationManager Navigation
@inject SectionAppearanceService Appearance

<PageTitle>Dashboard — MiddiFranchi</PageTitle>

<div class="dashboard-header">
    <div>
        <h1 class="account-detail-title">
            <span class="account-avatar brand" aria-hidden="true"><MfIcon Name="@Appearance.Get(AppSection.Dashboard).Icon" Size="18" /></span>
            Dashboard
        </h1>
    </div>
</div>

@if (_loading)
{
    <section class="card dashboard-loading" aria-live="polite">
        <p class="page-status" role="status">Caricamento della dashboard…</p>
    </section>
}
else if (_loadError is not null)
{
    <section class="card">
        <p class="alert alert-error" role="alert">@_loadError</p>
        <p class="table-hint">Nessun dato è stato mostrato per evitare valori non affidabili.</p>
        <div class="form-actions">
            <button type="button" class="primary-button" @onclick="LoadAsync">Riprova</button>
        </div>
    </section>
}
else if (_dashboard is { } dashboard)
{
    <div class="bento home-layout">
        <div class="home-overview-column">
            @if (_overview is { } overview)
            {
                <DashboardOverviewPanel Data="@overview" />
            }
        </div>
        <div class="home-allocation-column">
            @if (_overview is { } allocation)
            {
                <section class="card dashboard-allocation" aria-labelledby="allocation-title">
                    <div class="section-head">
                        <div>
                            <h2 id="allocation-title"><MfIcon Name="pie" Size="18" /> Patrimonio</h2>
                        </div>
                    </div>

                    @if (AllocationTotal is { } allocationTotal && CanShowAllocation)
                    {
                        <div class="home-allocation-donut-layout">
                            <figure class="allocation-figure">
                                <div class="allocation-donut home-allocation-donut">
                                    <svg viewBox="0 0 42 42" role="group" aria-label="Ripartizione del patrimonio" @onmouseleave="ClearAllocationHover">
                                        <circle class="allocation-track" cx="21" cy="21" r="15.9155" pathLength="100" />
                                        <circle class="allocation-segment investments clickable @(_allocationHover == "investments" ? "hovered" : "")"
                                                cx="21" cy="21" r="15.9155"
                                                pathLength="100" transform="rotate(-90 21 21)"
                                                stroke-dasharray="@DashArray(InvestmentShare)"
                                                role="button" tabindex="0" aria-label="Apri dettaglio investimenti"
                                                @onmouseover="SetAllocationInvestmentsHover"
                                                @onclick="OpenInvestments"
                                                @onkeydown="e => HandleAllocationKeyDown(e, true)" />
                                        <circle class="allocation-segment accounts clickable @(_allocationHover == "accounts" ? "hovered" : "")"
                                                cx="21" cy="21" r="15.9155"
                                                pathLength="100" transform="rotate(-90 21 21)"
                                                stroke-dasharray="@DashArray(AccountsShare)"
                                                stroke-dashoffset="@DashOffset(InvestmentShare)"
                                                role="button" tabindex="0" aria-label="Apri dettaglio conti"
                                                @onmouseover="SetAllocationAccountsHover"
                                                @onclick="OpenAccounts"
                                                @onkeydown="e => HandleAllocationKeyDown(e, false)" />
                                    </svg>
                                    <div class="allocation-center">
                                        @if (_allocationHover == "investments")
                                        {
                                            <span class="allocation-center-label">Investimenti</span>
                                            <strong class="allocation-center-value">@Format.Money(AllocationInvestments.GetValueOrDefault())</strong>
                                            <span class="allocation-center-sub">@Format.Percent(InvestmentShare)</span>
                                        }
                                        else if (_allocationHover == "accounts")
                                        {
                                            <span class="allocation-center-label">Conti</span>
                                            <strong class="allocation-center-value">@Format.Money(AllocationAccounts.GetValueOrDefault())</strong>
                                            <span class="allocation-center-sub">@Format.Percent(AccountsShare)</span>
                                        }
                                        else
                                        {
                                            <span class="allocation-center-label">Totale</span>
                                            <strong class="allocation-center-value">@Format.Money(allocationTotal)</strong>
                                        }
                                    </div>
                                </div>
                                <figcaption class="visually-hidden">@AllocationDescription</figcaption>
                            </figure>
                        </div>

                        @if (!allocation.Investments.IsComplete || !allocation.Accounts.IsComplete)
                        {
                            <p class="allocation-note">
                                <MfIcon Name="alert" Size="14" />
                                Alcuni saldi o valori non sono disponibili: le percentuali considerano solo i dati registrati e non stimano ciò che manca.
                            </p>
                        }
                    }
                    else
                    {
                        <EmptyState Title="Ripartizione non calcolabile" Hint="@AllocationHint" Icon="pie" />
                        <div class="allocation-actions">
                            <a class="section-link" href="investments">Investimenti <MfIcon Name="arrow-right" Size="16" /></a>
                            <a class="section-link" href="accounts">Conti <MfIcon Name="arrow-right" Size="16" /></a>
                        </div>
                    }
                </section>
            }
        </div>

        <div class="home-movements-column">
            <section class="card dashboard-movements-card" aria-labelledby="movements-title">
                <div class="section-head">
                    <div>
                        <h2 id="movements-title"><MfIcon Name="receipt" Size="18" /> Movimenti</h2>
                        <p class="section-sub">@Format.MonthPeriod(dashboard.Month.PeriodStart, dashboard.Month.PeriodEnd)</p>
                    </div>
                    <a class="section-link" href="operations">Tutti i movimenti <MfIcon Name="arrow-right" Size="16" /></a>
                </div>

                <div class="movements-summary">
                    @if (!dashboard.Month.HasIncomeExpense)
                    {
                        @if (dashboard.Month.HasMovements)
                        {
                            <EmptyState Title="Nessuna entrata o uscita nel mese"
                                        Hint="@($"{dashboard.Month.OtherOperationCount} trasferimenti o operazioni d'investimento non sono conteggiati nei totali economici.")"
                                        Icon="swap" />
                        }
                        else
                        {
                            <EmptyState Title="Nessun movimento nel mese"
                                        Hint="Registra un'entrata o un'uscita per popolare il riepilogo del periodo."
                                        Icon="swap" />
                        }
                    }
                    else
                    {
                        @foreach (var flow in dashboard.Month.Flows)
                        {
                            <div class="month-flow">
                                <div class="month-metrics">
                                    <div class="month-metric">
                                        <span class="month-metric-label">Saldo del periodo</span>
                                        <AmountValue Value="@(new Money(flow.Net, flow.Currency))" Signed="true" />
                                    </div>
                                    <div class="month-metric">
                                        <span class="month-metric-label">Entrate</span>
                                        <AmountValue Value="@(new Money(flow.Income, flow.Currency))" Tone="income" />
                                    </div>
                                    <div class="month-metric">
                                        <span class="month-metric-label">Uscite</span>
                                        <AmountValue Value="@(new Money(flow.Expense, flow.Currency))" Tone="expense" />
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="movements-recent">
                    <div class="movements-subhead">
                        <h3>Ultimi movimenti</h3>
                        <StatusBadge Tone="brand">@dashboard.Month.MovementCount movimenti nel mese</StatusBadge>
                    </div>

                    @if (dashboard.RecentMovements.Count == 0)
                    {
                        <EmptyState Title="Nessun movimento registrato"
                                    Hint="Le operazioni registrate compaiono qui e nella pagina Operazioni."
                                    Icon="list" Href="operations" ActionLabel="Vai ai movimenti" />
                    }
                    else
                    {
                        <ul class="activity-list" aria-label="Ultime operazioni registrate">
                            @foreach (var movement in dashboard.RecentMovements)
                            {
                                <li class="activity-row">
                                    <span class="activity-icon category" style="--mf-category-color: @CategoryColor(movement)" aria-hidden="true">
                                        <MfIcon Name="@CategoryIcon(movement)" Size="18" />
                                    </span>
                                    <div class="activity-main">
                                        <span class="activity-title">@MovementCategoryLabel(movement)</span>
                                        <span class="activity-meta">
                                            @Format.Date(movement.Date)
                                            @if (!string.IsNullOrWhiteSpace(movement.AccountLabel))
                                            {
                                                <span aria-hidden="true">·</span>
                                                <span>@movement.AccountLabel</span>
                                            }
                                        </span>
                                    </div>
                                    <div class="activity-amounts">
                                        <AmountValue Value="@movement.Amount" Signed="true" />
                                        @if (movement.CounterAmount is { } counterAmount)
                                        {
                                            <span class="activity-counter">
                                                <MfIcon Name="arrow-right" Size="16" />
                                                <AmountValue Value="@counterAmount" Signed="true" />
                                            </span>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </section>
        </div>
    </div>
}

<button type="button" class="fab-add" aria-label="Nuova operazione" @onclick="OpenOperationDialog">
    <MfIcon Name="plus" Size="24" />
</button>

<OperationDialog Open="_operationDialogOpen"
                 Categories="_categories"
                 Instruments="_instrumentOptions"
                 OnClose="CloseOperationDialog"
                 OnSaved="OnOperationSaved" />

<InvestmentClassDialog Open="_allocationDialogOpen"
                       AssetClassName="@_allocationDialogTitle"
                       AssetClassColor="@_allocationDialogColor"
                       Items="_allocationDialogItems"
                       ItemsLabel="@_allocationDialogItemsLabel"
                       OnClose="CloseAllocationDialog" />

@code {
    private FinancialDashboard? _dashboard;
    private DashboardOverview? _overview;
    private bool _loading = true;
    private string? _loadError;
    private string? _allocationHover;
    private bool _allocationDialogOpen;
    private string _allocationDialogTitle = "";
    private string _allocationDialogColor = "#64748b";
    private string _allocationDialogItemsLabel = "strumenti";
    private IReadOnlyList<InvestmentAllocationItem> _allocationDialogItems = [];
    private bool _operationDialogOpen;
    private bool _operationOptionsLoading;
    private IReadOnlyList<Category> _categories = [];
    private IReadOnlyList<InvestmentOption> _instrumentOptions = [];

    private static readonly string[] AllocationPalette =
    [
        "#4f5bd5",
        "#0ea5e9",
        "#1d7047",
        "#b86b35",
        "#8a8780",
        "#7d4a7a",
        "#b34432",
        "#2f6f7d",
    ];

    private Money? AllocationInvestments => _overview?.Investments.CurrentValue;

    private Money? AllocationAccounts => _overview?.Accounts.CurrentValue;

    private Money? AllocationTotal =>
        AllocationInvestments is { } investments && AllocationAccounts is { } accounts
            ? investments + accounts
            : null;

    /// <summary>La torta esiste solo con valori non negativi e un totale positivo: nessun valore assoluto o stimato.</summary>
    private bool CanShowAllocation =>
        AllocationInvestments is { Amount: >= 0m } investments &&
        AllocationAccounts is { Amount: >= 0m } accounts &&
        investments.Amount + accounts.Amount > 0m;

    private decimal InvestmentShare =>
        CanShowAllocation && AllocationTotal is { Amount: > 0m } total
            ? AllocationInvestments.GetValueOrDefault().Amount / total.Amount
            : 0m;

    private decimal AccountsShare => 1m - InvestmentShare;

    private string AllocationHint
    {
        get
        {
            if (AllocationInvestments is null && AllocationAccounts is null)
            {
                return "Servono un valore completo degli investimenti e un saldo dei conti per calcolare la ripartizione.";
            }

            if (AllocationInvestments is null)
            {
                return "Gli investimenti non sono valorizzati completamente: la ripartizione non viene stimata.";
            }

            if (AllocationAccounts is null)
            {
                return "Nessun conto ha un saldo registrato: la ripartizione non viene stimata.";
            }

            return "Il totale dei valori disponibili è nullo o negativo: non c'è una ripartizione da mostrare.";
        }
    }

    private string AllocationDescription => AllocationTotal is { } total
        ? $"Ripartizione del patrimonio al {Format.Date(_overview!.ValuationDate)}: " +
          $"investimenti {Format.Money(AllocationInvestments.GetValueOrDefault())} ({Format.Percent(InvestmentShare)}), " +
          $"conti {Format.Money(AllocationAccounts.GetValueOrDefault())} ({Format.Percent(AccountsShare)}). " +
          $"Totale {Format.Money(total)}."
        : string.Empty;

    private static string DashArray(decimal share)
    {
        var value = Math.Clamp(share, 0m, 1m) * 100m;
        return $"{Invariant(value)} {Invariant(100m - value)}";
    }

    private static string DashOffset(decimal share) =>
        Invariant(-Math.Clamp(share, 0m, 1m) * 100m);

    private void SetAllocationInvestmentsHover() => _allocationHover = "investments";

    private void SetAllocationAccountsHover() => _allocationHover = "accounts";

    private void ClearAllocationHover() => _allocationHover = null;

    private void OpenInvestments() => OpenAllocationDialog(investments: true);

    private void OpenAccounts() => OpenAllocationDialog(investments: false);

    private void OpenAllocationDialog(bool investments)
    {
        if (_dashboard is null)
        {
            return;
        }

        var entries = new List<(string Name, Money Value, string? Color)>();
        if (investments)
        {
            foreach (var position in _dashboard.Investments.Positions)
            {
                if (position.Value is { Amount: > 0m } value)
                {
                    entries.Add((
                        string.IsNullOrWhiteSpace(position.Symbol)
                            ? position.InstrumentName
                            : position.Symbol!,
                        value,
                        null));
                }
            }
        }
        else
        {
            foreach (var account in _dashboard.Accounts)
            {
                if (account.ManualBalance is { Amount: > 0m } value)
                {
                    entries.Add((account.Name, value, account.ColorHex));
                }
            }
        }

        if (entries.Count == 0)
        {
            return;
        }

        var ordered = entries
            .OrderByDescending(entry => entry.Value.Amount)
            .ToArray();
        var total = ordered.Sum(entry => entry.Value.Amount);
        if (total <= 0m)
        {
            return;
        }

        var items = new List<InvestmentAllocationItem>(ordered.Length);
        var offset = 0m;
        for (var index = 0; index < ordered.Length; index++)
        {
            var entry = ordered[index];
            var share = entry.Value.Amount / total;
            items.Add(new InvestmentAllocationItem(
                entry.Name,
                entry.Value,
                share,
                offset,
                entry.Color ?? AllocationPalette[index % AllocationPalette.Length],
                null));
            offset += share;
        }

        var appearance = Appearance.Get(investments ? AppSection.Investments : AppSection.Accounts);
        _allocationDialogTitle = investments ? "Investimenti" : "Conti";
        _allocationDialogColor = appearance.Color;
        _allocationDialogItemsLabel = investments ? "strumenti" : "conti";
        _allocationDialogItems = items;
        _allocationDialogOpen = true;
    }

    private void CloseAllocationDialog() => _allocationDialogOpen = false;

    private async Task OpenOperationDialog()
    {
        if (_operationOptionsLoading)
        {
            return;
        }

        _operationOptionsLoading = true;
        try
        {
            _categories = await CategoriesService.ListAsync();
            var workspace = await Investments.LoadAsync();
            _instrumentOptions = workspace.Assets
                .Where(asset => !asset.IsArchived)
                .OrderBy(asset => asset.Name, StringComparer.CurrentCultureIgnoreCase)
                .Select(asset => new InvestmentOption(asset.InstrumentId, asset.Name))
                .ToArray();
            _operationDialogOpen = true;
        }
        catch (Exception)
        {
            await Notifications.Error("Impossibile aprire il modulo della nuova operazione.");
        }
        finally
        {
            _operationOptionsLoading = false;
        }
    }

    private void CloseOperationDialog() => _operationDialogOpen = false;

    private async Task OnOperationSaved(string message)
    {
        _operationDialogOpen = false;
        await Notifications.Success(message);
        await LoadAsync();
    }

    private void HandleAllocationKeyDown(KeyboardEventArgs args, bool investments)
    {
        if (args.Key is "Enter" or " ")
        {
            OpenAllocationDialog(investments);
        }
    }

    private static string Invariant(decimal value) =>
        value.ToString("0.###", CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _dashboard = null;
        _overview = null;
        _allocationHover = null;

        try
        {
            _dashboard = await DashboardService.LoadAsync();
            _overview = await OverviewService.LoadAsync();
        }
        catch (InvalidOperationException exception)
            when (exception.Message.Contains("connection string", StringComparison.OrdinalIgnoreCase))
        {
            _loadError = "Il database non è configurato. Impostare la connection string 'ConnectionStrings:DefaultConnection' nelle variabili d'ambiente o nei user secrets.";
        }
        catch (Exception)
        {
            _loadError = "Impossibile caricare la dashboard. Verificare che PostgreSQL sia raggiungibile e che la connection string sia corretta.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string CategoryIcon(DashboardMovement movement) =>
        string.IsNullOrWhiteSpace(movement.CategoryIcon) ? "tag" : movement.CategoryIcon;

    private static string CategoryColor(DashboardMovement movement) =>
        CategoryAppearance.ColorFor(movement.CategoryColor);

    private static string MovementCategoryLabel(DashboardMovement movement) =>
        movement.CategoryLabel
        ?? (string.IsNullOrWhiteSpace(movement.Description) ? "Movimento" : movement.Description);
}
