    private async Task OpenEdit(OperationHistoryRow row)
    {
        if (row.IsInvestment)
        {
            await OpenInvestmentCouponAsync(row);
            return;
        }

        _editingRow = row;
        _editDialogOpen = true;
    }

    private async Task OpenInvestmentCouponAsync(OperationHistoryRow row)
    {
        _workspace = await Investments.LoadAsync();
        var asset = row.InstrumentId is { } instrumentId
            ? _workspace.Assets.FirstOrDefault(candidate => candidate.InstrumentId == instrumentId)
            : null;
        var operation = asset?.Operations.FirstOrDefault(candidate => candidate.Id == row.Id);
        if (asset is null || operation is null)
        {
            await Notifications.Error("Cedola non trovata.");
            return;
        }

        _investmentAsset = asset;
        _investmentOperation = operation;
        _investmentDialogOpen = true;
    }

