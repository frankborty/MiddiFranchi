@page "/operations"
@rendermode InteractiveServer
@using System.Globalization
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@using MiddiFranchi.Domain.Shared
@inject CategoryService CategoriesService
@inject OperationHistoryService History
@inject InvestmentWorkspaceService Investments
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject NotificationService Notifications
@inject ChartPreferences Preferences
@inject FilterPreferences Filters
@inject SectionAppearanceService Appearance

<PageTitle>Movimenti</PageTitle>

<div class="dashboard-header">
    <div>
        <h1 class="account-detail-title">
            <span class="account-avatar amber" aria-hidden="true"><MfIcon Name="@Appearance.Get(AppSection.Operations).Icon" Size="18" /></span>
            Movimenti
        </h1>
    </div>
    <div class="dashboard-header-meta">
        <StatusBadge Tone="amber">@PeriodLabel</StatusBadge>
    </div>
</div>

@if (_loading)
{
    <section class="card dashboard-loading" aria-live="polite">
        <p class="page-status" role="status">Caricamento delle operazioni…</p>
    </section>
}
else if (_loadError is not null)
{
    <section class="card">
        <p class="alert alert-error" role="alert">@_loadError</p>
        <div class="form-actions">
            <button type="button" class="secondary-button" @onclick="LoadAsync">Riprova</button>
        </div>
    </section>
}
else
{
    <section class="period-bar" aria-label="Seleziona il periodo">
        <div class="period-year">
            <button type="button" class="period-arrow" disabled="@(_periodYear <= MinPeriodYear)"
                    @onclick="() => ChangePeriodYear(-1)" aria-label="Anno precedente">
                <MfIcon Name="arrow-left" Size="16" />
            </button>
            <button type="button" class="period-year-label @(_periodMode == PeriodMode.Year ? "active" : "")"
                    @onclick="SelectYear" title="Mostra tutto il @_periodYear">
                @_periodYear
            </button>
            <button type="button" class="period-arrow" disabled="@(_periodYear >= MaxPeriodYear)"
                    @onclick="() => ChangePeriodYear(1)" aria-label="Anno successivo">
                <MfIcon Name="arrow-right" Size="16" />
            </button>
        </div>

        <div class="period-months" @ref="_periodMonthsRef" role="group" aria-label="Mesi">
            @for (var month = 1; month <= 12; month++)
            {
                var currentMonth = month;
                <button type="button"
                        class="period-month @(_periodMode == PeriodMode.Month && _periodMonth == currentMonth ? "active" : "")"
                        @onclick="() => SelectMonth(currentMonth)"
                        title="@MonthButtonTitle(currentMonth)">
                    <span class="period-month-name">@MonthShortName(currentMonth)</span>
                    @if (_periodMode == PeriodMode.Month && _periodMonth == currentMonth)
                    {
                        <span class="period-month-amount">@MonthNetLabel(currentMonth)</span>
                    }
                </button>
            }
        </div>

        <button type="button" class="period-all @(_periodMode == PeriodMode.All ? "active" : "")"
                @onclick="SelectAll" title="Mostra tutti i movimenti senza filtro sulla data">
            Tutti
        </button>
    </section>

    <div class="bento">
        <div class="sp-4">
            <div class="stat-tile operation-stat income">
                <span class="stat-label">@IncomeCardLabel</span>
                <span class="operation-stat-value">
                    <AmountValue Value="@_periodIncome" Tone="income" />
                </span>
                <span class="stat-hint">@PeriodIncomeHint</span>
            </div>
        </div>
        <div class="sp-4">
            <div class="stat-tile operation-stat expense">
                <span class="stat-label">@ExpenseCardLabel</span>
                <span class="operation-stat-value">
                    <AmountValue Value="@_periodExpense" Tone="expense" />
                </span>
                <span class="stat-hint">@PeriodExpenseHint</span>
            </div>
        </div>
        <div class="sp-4">
            <div class="stat-tile operation-stat balance">
                <span class="stat-label">@BalanceCardLabel</span>
                <span class="operation-stat-value">
                    <AmountValue Value="@_periodNet" Signed="true" Tone="@Tone(_periodNet)" />
                </span>
                <span class="stat-hint">Entrate meno uscite</span>
            </div>
        </div>
    </div>

    @if (_periodMode != PeriodMode.Month)
    {
        <div class="bento">
            <div class="sp-4">
                <div class="stat-tile operation-stat income">
                    <span class="stat-label">@AverageIncomeLabel</span>
                    <span class="operation-stat-value">
                        <AmountValue Value="@_averageIncome" Tone="income" />
                    </span>
                    <span class="stat-hint">@AverageHint</span>
                </div>
            </div>
            <div class="sp-4">
                <div class="stat-tile operation-stat expense">
                    <span class="stat-label">@AverageExpenseLabel</span>
                    <span class="operation-stat-value">
                        <AmountValue Value="@_averageExpense" Tone="expense" />
                    </span>
                    <span class="stat-hint">@AverageHint</span>
                </div>
            </div>
            <div class="sp-4">
                <div class="stat-tile operation-stat balance">
                    <span class="stat-label">@AverageBalanceLabel</span>
                    <span class="operation-stat-value">
                        <AmountValue Value="@_averageNet" Signed="true" Tone="@Tone(_averageNet)" />
                    </span>
                    <span class="stat-hint">@AverageHint</span>
                </div>
            </div>
        </div>
    }

    

    <div class="bento compact-pie-row">
        <div class="chart-panel">
            <section class="@TrendCardClass" aria-labelledby="trend-title">
                <div class="section-head">
                    <div>
                        <h2 id="trend-title"><MfIcon Name="chart" Size="18" /> @TrendTitle</h2>
                        <p class="section-sub">@TrendSubtitle</p>
                    </div>
                    <div class="trend-toggle" role="group" aria-label="Tipo di grafico">
                        <button type="button" class="@TrendToggleClass(TrendKind.Income)"
                                aria-pressed="@(_trendKind == TrendKind.Income)" @onclick="() => SelectTrend(TrendKind.Income)">
                            Entrate
                        </button>
                        <button type="button" class="@TrendToggleClass(TrendKind.Expense)"
                                aria-pressed="@(_trendKind == TrendKind.Expense)" @onclick="() => SelectTrend(TrendKind.Expense)">
                            Uscite
                        </button>
                        <button type="button" class="@TrendToggleClass(TrendKind.Delta)"
                                aria-pressed="@(_trendKind == TrendKind.Delta)" @onclick="() => SelectTrend(TrendKind.Delta)">
                            Delta
                        </button>
                    </div>
                </div>

                @if (TrendHasData)
                {
                    <ApexTimeSeriesChart Title="@TrendTitle"
                                         Currency="@Currency.Euro"
                                         Series="@TrendSeries"
                                         Stacked="true"
                                         ShowStackedTotal="false"
                                         ShowHeader="false"
                                         ShowFooter="false"
                                         ShowDataTable="false"
                                         ShowMarkers="false"
                                         ColorPointsBySign="@(_trendKind == TrendKind.Delta)"
                                         Height="@("100%")"
                                         XAxisLabelMode="@TrendLabelMode" />
                }
                else
                {
                    <EmptyState Title="Nessun dato nel periodo"
                                Hint="Registra un'entrata o un'uscita per popolare il grafico."
                                Icon="chart" />
                }
            </section>
        </div>

        <div class="pie-panel">
            <section class="@PieCardClass" aria-labelledby="pie-title">
                <div class="section-head">
                    <div>
                        <h2 id="pie-title"><MfIcon Name="pie" Size="18" /> @PieTitle</h2>
                        <p class="section-sub">@PeriodLabel</p>
                    </div>
                    <div class="trend-toggle" role="group" aria-label="Tipo di ripartizione">
                        <button type="button" class="@PieToggleClass(PieKind.Income)"
                                aria-pressed="@(_pieKind == PieKind.Income)" @onclick="() => SelectPie(PieKind.Income)">
                            Entrate
                        </button>
                        <button type="button" class="@PieToggleClass(PieKind.Expense)"
                                aria-pressed="@(_pieKind == PieKind.Expense)" @onclick="() => SelectPie(PieKind.Expense)">
                            Uscite
                        </button>
                    </div>
                </div>

                @if (PieSlices.Count > 0)
                {
                    <div class="alternative-pie-layout">
                        <figure class="alternative-pie-figure">
                            <div class="allocation-donut alternative-pie-donut">
                                <svg viewBox="0 0 42 42" aria-hidden="true" focusable="false" @onmouseleave="ClearAlternativeHover">
                                    <circle class="allocation-track" cx="21" cy="21" r="15.9155" pathLength="100" />
                                    @foreach (var slice in PieSlices)
                                    {
                                        <circle class="@PieSliceClass(slice)"
                                                cx="21" cy="21" r="15.9155"
                                                pathLength="100" transform="rotate(-90 21 21)"
                                                stroke="@slice.Color"
                                                stroke-dasharray="@DashArray(slice.Share)"
                                                stroke-dashoffset="@DashOffset(slice.Offset)"
                                                @onmouseover="() => SetAlternativeHover(slice)"
                                                @onclick="() => OpenCategoryBreakdown(slice)">
                                            <title>@slice.Label: @Format.Money(slice.Amount) (@Format.Percent(slice.Share))</title>
                                        </circle>
                                    }
                                </svg>
                                <div class="allocation-center alternative-pie-center">
                                    @if (_altHoverSlice is { } hover)
                                    {
                                        <span class="allocation-center-label" style="color: @hover.Color">@hover.Label</span>
                                        <strong class="allocation-center-value">@Format.Money(hover.Amount)</strong>
                                        <span class="allocation-center-sub">@Format.Percent(hover.Share)</span>
                                    }
                                    else
                                    {
                                        <span class="allocation-center-label">Totale</span>
                                        <strong class="allocation-center-value">@Format.Money(PieTotal.GetValueOrDefault())</strong>
                                        <span class="allocation-center-sub">@PieSlices.Count categorie</span>
                                    }
                                </div>
                            </div>
                            <figcaption class="visually-hidden">@PieDescription</figcaption>
                        </figure>
                    </div>
                }
                else
                {
                    <EmptyState Title="@PieEmptyTitle" Hint="@PieEmptyHint" Icon="pie" />
                }
            </section>
        </div>
    </div>

    <div class="bento">
        <div class="sp-12">
            <section class="card operations-history-card" aria-labelledby="history-title">
                <div class="section-head movements-list-head">
                    <div class="section-title-row">
                        <h2 id="history-title"><MfIcon Name="list" Size="18" /> Lista</h2>
                        <StatusBadge Tone="brand">@FilteredHistory.Count di @PeriodHistory.Count</StatusBadge>
                    </div>
                </div>

                @if (_openFilterMenu is not null)
                {
                    <div class="filter-scrim" @onclick="CloseFilterMenus"></div>
                }

                <div class="movement-filter-bar">
                    <label class="movement-search">
                        <MfIcon Name="search" Size="16" />
                        <input type="search" value="@_filterSearch" @oninput="OnSearchInput"
                               placeholder="Cerca descrizione, categoria, data o importo"
                               aria-label="Cerca movimenti" />
                    </label>

                    <div class="movement-filter-actions">
                        <div class="filter-menu-wrap">
                            <button type="button" class="filter-trigger @(HasDateFilter ? "active" : "")"
                                    @onclick="() => ToggleFilterMenu(FilterMenu.Period)"
                                    aria-expanded="@(_openFilterMenu == FilterMenu.Period)">
                                <MfIcon Name="calendar" Size="15" />
                                <span>@DateFilterLabel</span>
                                <MfIcon Name="chevron-down" Size="13" />
                            </button>
                            @if (_openFilterMenu == FilterMenu.Period)
                            {
                                <div class="filter-panel period-panel">
                                    <p class="filter-panel-title">Periodo</p>
                                    <button type="button" class="filter-option @(_periodMode == PeriodMode.All ? "selected" : "")"
                                            @onclick='() => SetDatePreset("all")'>Tutto il periodo</button>
                                    <button type="button" class="filter-option @(_datePreset == "7d" ? "selected" : "")"
                                            @onclick='() => SetDatePreset("7d")'>Ultimi 7 giorni</button>
                                    <button type="button" class="filter-option @(_datePreset == "30d" ? "selected" : "")"
                                            @onclick='() => SetDatePreset("30d")'>Ultimi 30 giorni</button>
                                    <button type="button" class="filter-option @(IsCurrentMonthSelected ? "selected" : "")"
                                            @onclick='() => SetDatePreset("currentMonth")'>Questo mese</button>
                                    <button type="button" class="filter-option @(IsLastMonthSelected ? "selected" : "")"
                                            @onclick='() => SetDatePreset("lastMonth")'>Mese scorso</button>
                                    <button type="button" class="filter-option @(IsCurrentYearSelected ? "selected" : "")"
                                            @onclick='() => SetDatePreset("currentYear")'>Quest'anno</button>
                                    <div class="filter-panel-separator"></div>
                                    <p class="filter-panel-title">Intervallo preciso</p>
                                    <div class="filter-range-grid">
                                        <label>
                                            <span>Da</span>
                                            <input type="date" @bind="_filterFrom" @bind:after="OnCustomDateChanged" />
                                        </label>
                                        <label>
                                            <span>A</span>
                                            <input type="date" @bind="_filterTo" @bind:after="OnCustomDateChanged" />
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="filter-menu-wrap">
                            <button type="button" class="filter-trigger @(_historyFilter != FilterAll ? "active" : "")"
                                    @onclick="() => ToggleFilterMenu(FilterMenu.Type)"
                                    aria-expanded="@(_openFilterMenu == FilterMenu.Type)">
                                <MfIcon Name="filter" Size="15" />
                                <span>Tipo</span>
                                <MfIcon Name="chevron-down" Size="13" />
                            </button>
                            @if (_openFilterMenu == FilterMenu.Type)
                            {
                                <div class="filter-panel">
                                    <p class="filter-panel-title">Tipo</p>
                                    <button type="button" class="filter-option @(_historyFilter == FilterAll ? "selected" : "")"
                                            @onclick="() => SetTypeFilter(FilterAll)">Tutti</button>
                                    <button type="button" class="filter-option @(_historyFilter == FilterIncome ? "selected" : "")"
                                            @onclick="() => SetTypeFilter(FilterIncome)">Entrate</button>
                                    <button type="button" class="filter-option @(_historyFilter == FilterExpense ? "selected" : "")"
                                            @onclick="() => SetTypeFilter(FilterExpense)">Uscite</button>
                                </div>
                            }
                        </div>

                        <div class="filter-menu-wrap">
                            <button type="button" class="filter-trigger @(CategoryFilterCount > 0 ? "active" : "")"
                                    @onclick="() => ToggleFilterMenu(FilterMenu.Categories)"
                                    aria-expanded="@(_openFilterMenu == FilterMenu.Categories)">
                                <MfIcon Name="grid" Size="15" />
                                <span>Categorie</span>
                                @if (CategoryFilterCount > 0)
                                {
                                    <span class="filter-count">@CategoryFilterCount</span>
                                }
                                <MfIcon Name="chevron-down" Size="13" />
                            </button>
                            @if (_openFilterMenu == FilterMenu.Categories)
                            {
                                <div class="filter-panel categories-panel">
                                    <div class="filter-panel-head">
                                        <p class="filter-panel-title">Categorie</p>
                                        @if (CategoryFilterCount > 0)
                                        {
                                            <button type="button" class="filter-link" @onclick="ClearCategoryFilters">Azzera</button>
                                        }
                                    </div>
                                    <div class="filter-check-list">
                                        @if (CategoryFilterOptions.Count == 0)
                                        {
                                            <p class="filter-empty-text">Nessuna categoria nel periodo.</p>
                                        }
                                        @foreach (var category in CategoryFilterOptions)
                                        {
                                            <label class="filter-check">
                                                <input type="checkbox" checked="@_filterCategories.Contains(category)"
                                                       @onchange="args => ToggleCategoryFilter(category, args)" />
                                                <span>@category</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="filter-menu-wrap">
                            <button type="button" class="filter-trigger @(SubcategoryFilterCount > 0 ? "active" : "")"
                                    @onclick="() => ToggleFilterMenu(FilterMenu.Subcategory)"
                                    aria-expanded="@(_openFilterMenu == FilterMenu.Subcategory)">
                                <MfIcon Name="tag" Size="15" />
                                <span>Sottocategorie</span>
                                @if (SubcategoryFilterCount > 0)
                                {
                                    <span class="filter-count">@SubcategoryFilterCount</span>
                                }
                                <MfIcon Name="chevron-down" Size="13" />
                            </button>
                            @if (_openFilterMenu == FilterMenu.Subcategory)
                            {
                                <div class="filter-panel categories-panel">
                                    <div class="filter-panel-head">
                                        <p class="filter-panel-title">Sottocategorie</p>
                                        @if (SubcategoryFilterCount > 0)
                                        {
                                            <button type="button" class="filter-link" @onclick="ClearSubcategoryFilters">Azzera</button>
                                        }
                                    </div>
                                    @if (_filterCategories.Count > 0)
                                    {
                                        <p class="filter-hint">Mostro solo le sottocategorie delle categorie selezionate.</p>
                                    }
                                    <div class="filter-check-list">
                                        @if (SubcategoryFilterOptions.Count == 0)
                                        {
                                            <p class="filter-empty-text">Nessuna sottocategoria nel periodo.</p>
                                        }
                                        @foreach (var subcategory in SubcategoryFilterOptions)
                                        {
                                            <label class="filter-check">
                                                <input type="checkbox" checked="@_filterSubcategories.Contains(subcategory)"
                                                       @onchange="args => ToggleSubcategoryFilter(subcategory, args)" />
                                                <span>@subcategory</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="filter-menu-wrap">
                            <button type="button" class="filter-trigger @(HasAmountFilter ? "active" : "")"
                                    @onclick="() => ToggleFilterMenu(FilterMenu.Amount)"
                                    aria-expanded="@(_openFilterMenu == FilterMenu.Amount)">
                                <MfIcon Name="coin" Size="15" />
                                <span>Importo</span>
                                <MfIcon Name="chevron-down" Size="13" />
                            </button>
                            @if (_openFilterMenu == FilterMenu.Amount)
                            {
                                <div class="filter-panel amount-panel">
                                    <p class="filter-panel-title">Importo</p>
                                    <div class="filter-range-grid">
                                        <label>
                                            <span>Da</span>
                                            <input type="text" value="@_filterAmountMin" @oninput="OnAmountMinInput" placeholder="0" />
                                        </label>
                                        <label>
                                            <span>A</span>
                                            <input type="text" value="@_filterAmountMax" @oninput="OnAmountMaxInput" placeholder="0" />
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (HasActiveFilters)
                        {
                            <button type="button" class="filter-reset" @onclick="ResetFilters">Azzera</button>
                        }
                    </div>
                </div>

                @if (HasActiveFilters && FilteredHistory.Count > 0)
                {
                    <div class="movement-filter-summary" role="status">
                        <span class="movement-summary-count">
                            <strong>@FilteredHistory.Count</strong> movimenti filtrati
                        </span>
                        <span class="movement-summary-item income">
                            Entrate <strong>@Format.Money(FilteredIncomeTotal)</strong>
                        </span>
                        <span class="movement-summary-item expense">
                            Uscite <strong>@Format.Money(FilteredExpenseTotal)</strong>
                        </span>
                        <span class="movement-summary-item net @Tone(FilteredNetTotal)">
                            Saldo <strong>@Format.MoneySigned(FilteredNetTotal)</strong>
                        </span>
                    </div>
                }

                @if (_historyError is not null)
                {
                    <p class="alert alert-error" role="alert">@_historyError</p>
                }
                else if (_visibleHistory.Count == 0)
                {
                    <EmptyState Title="Nessun movimento registrato"
                                Hint="Usa il pulsante + per registrare la prima entrata o uscita."
                                Icon="list" />
                }
                else if (PeriodHistory.Count == 0)
                {
                    <EmptyState Title="Nessun movimento nel periodo"
                                Hint="Seleziona un altro mese, un anno o Tutti dalla barra del periodo."
                                Icon="list" />
                }
                else
                {
                    <div class="table-scroll history-list" tabindex="0">
                        <table class="data-table operations-history-table">
                            <colgroup>
                                <col class="col-date" />
                                <col class="col-category" />
                                <col class="col-subcategory" />
                                <col class="col-description" />
                                <col class="col-amount" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <SortableTh OnSort="OnHistorySortChangedAsync" Sort="_historySort" Column="date" Label="Data" />
                                    <SortableTh OnSort="OnHistorySortChangedAsync" Sort="_historySort" Column="category" Label="Categoria" />
                                    <SortableTh OnSort="OnHistorySortChangedAsync" Sort="_historySort" Column="subcategory" Label="Sottocategoria" />
                                    <SortableTh OnSort="OnHistorySortChangedAsync" Sort="_historySort" Column="description" Label="Descrizione" />
                                    <SortableTh OnSort="OnHistorySortChangedAsync" Sort="_historySort" Column="amount" Label="Importo" Numeric="true" />
                                </tr>
                            </thead>
                            <tbody>
                                @if (PagedHistory.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="filter-empty">
                                            <EmptyState Title="@EmptyFilterTitle"
                                                        Hint="Modifica o azzera i filtri per vedere i movimenti."
                                                        Icon="list" />
                                            <div class="filter-empty-actions">
                                                <button type="button" class="secondary-button" @onclick="ResetFilters">Azzera filtri</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                                @foreach (var row in PagedHistory)
                                {
                                    <tr class="movement-row" tabindex="0"
                                        title="Apri e modifica"
                                        @onclick="() => OpenEdit(row)"
                                        @onkeydown="args => OnRowKeyDown(args, row)">
                                        <td>@Format.Date(row.OperationDate)</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(row.CategoryName))
                                            {
                                                <span class="category-chip" style="--mf-category-color: @CategoryAppearance.ColorFor(row.CategoryColor)">
                                                    <span class="category-chip-icon" aria-hidden="true">
                                                        <MfIcon Name="@CategoryAppearance.IconFor(row.CategoryIcon)" Size="14" />
                                                    </span>
                                                    @row.CategoryName
                                                </span>
                                            }
                                        </td>
                                        <td>@row.Subcategory</td>
                                        <td>
                                            @row.Description
                                            @if (row.InstrumentName is { } instrumentName)
                                            {
                                                <span class="table-hint"> · @instrumentName</span>
                                            }
                                        </td>
                                        <td class="num">
                                            @if (row.Amount is { } amount)
                                            {
                                                <AmountValue Value="@amount" Signed="true" Tone="@AmountTone(row.Kind)" />
                                            }
                                            else
                                            {
                                                <span class="amount amount-neutral">Non disponibile</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <nav class="pagination" aria-label="Paginazione dei movimenti">
                        <span class="pagination-info">@PageSummary</span>
                        <div class="pagination-actions">
                            <label class="page-size">
                                <span>Per pagina</span>
                                <select @bind="_pageSize" @bind:after="OnPageSizeChanged" aria-label="Movimenti per pagina">
                                    <option value="10">10</option>
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                            </label>
                            @if (PageCount > 1)
                            {
                                <button type="button" class="secondary-button" disabled="@(CurrentPage <= 1)" @onclick="PreviousPage" aria-label="Pagina precedente">
                                    <MfIcon Name="arrow-left" Size="16" />
                                </button>
                                <span class="pagination-page">@CurrentPage / @PageCount</span>
                                <button type="button" class="secondary-button" disabled="@(CurrentPage >= PageCount)" @onclick="NextPage" aria-label="Pagina successiva">
                                    <MfIcon Name="arrow-right" Size="16" />
                                </button>
                            }
                        </div>
                    </nav>
                }
            </section>
        </div>
    </div>

<button type="button" class="fab-add" aria-label="Nuova operazione" @onclick="OpenDialog">
        <MfIcon Name="plus" Size="24" />
    </button>

    <OperationDialog Open="_dialogOpen"
                     Categories="_categories"
                     Instruments="_instrumentOptions"
                     OnClose="CloseDialog"
                     OnSaved="OnOperationSaved" />

    <OperationEditDialog Open="_editDialogOpen"
                         Operation="_editingRow"
                         Categories="_categories"
                         Instruments="_instrumentOptions"
                         ShowTax="true"
                         OnClose="CloseEdit"
                         OnSaved="OnOperationSaved" />

    <InvestmentOperationDialog Open="_investmentDialogOpen"
                               Asset="_investmentAsset"
                               Operation="_investmentOperation"
