        ? "Nessuna entrata nel periodo"
        : "Nessuna uscita nel periodo";

    private string PieEmptyHint => _pieKind == PieKind.Income
        ? "Le entrate registrate e categorizzate compaiono qui."
        : "Le uscite registrate e categorizzate compaiono qui.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender && !_preferencesLoaded)
        {
            _preferencesLoaded = true;

            var state = await Filters.GetAsync<FilterState>("mf.filters.operations");
            if (state is not null)
            {
                _historyFilter = state.HistoryFilter;
                if (Enum.TryParse<PeriodMode>(state.PeriodMode, ignoreCase: true, out var periodMode))
                {
                    _periodMode = periodMode;
                }

                if (state.PeriodYear > 0)
                {
                    _periodYear = state.PeriodYear;
                }

                if (state.PeriodMonth is >= 1 and <= 12)
                {
                    _periodMonth = state.PeriodMonth;
                }

                _filterFrom = DateOnly.TryParse(state.FilterFrom, out var from) ? from : null;
                _filterTo = DateOnly.TryParse(state.FilterTo, out var to) ? to : null;
                _filterCategories.Clear();
                foreach (var category in state.Categories)
                {
                    _filterCategories.Add(category);
                }

                _filterSubcategories.Clear();
                foreach (var subcategory in state.Subcategories)
                {
                    _filterSubcategories.Add(subcategory);
                }

                _filterSearch = state.Search ?? "";
                _datePreset = string.IsNullOrWhiteSpace(state.DatePreset) ? "none" : state.DatePreset;
                _filterAmountMin = state.AmountMin ?? "";
                _filterAmountMax = state.AmountMax ?? "";
                _historySort = new TableSort(
                    string.IsNullOrWhiteSpace(state.SortColumn) ? "date" : state.SortColumn,
                    state.SortDescending);
                _pageSize = state.PageSize > 0 ? state.PageSize : 20;
                _page = 1;
                ComputePeriodSummary();
            }

            var storedTrend = await Preferences.GetAsync("mf.chart.operations.trend");
            if (Enum.TryParse<TrendKind>(storedTrend, out var trend))
            {
                _trendKind = trend;
            }

            var storedPie = await Preferences.GetAsync("mf.chart.operations.pie");
            if (Enum.TryParse<PieKind>(storedPie, out var pie))
            {
                _pieKind = pie;
            }

            await InvokeAsync(StateHasChanged);
        }

        if (!_loading && _loadError is null)
        {
            await JS.InvokeVoidAsync("mfScrollActiveMonth", _periodMonthsRef);
        }
    }

    private Task PersistFiltersAsync() => Filters.SetAsync(
        "mf.filters.operations",
        new FilterState
        {
            HistoryFilter = _historyFilter,
            PeriodMode = _periodMode.ToString(),
            PeriodYear = _periodYear,
            PeriodMonth = _periodMonth,
            FilterFrom = _filterFrom?.ToString("yyyy-MM-dd"),
            FilterTo = _filterTo?.ToString("yyyy-MM-dd"),
            Categories = _filterCategories.ToArray(),
            Subcategories = _filterSubcategories.ToArray(),
            Search = _filterSearch,
            DatePreset = _datePreset,
            AmountMin = _filterAmountMin,
            AmountMax = _filterAmountMax,
            SortColumn = _historySort.Column,
            SortDescending = _historySort.Descending,
            PageSize = _pageSize,
        });

    private async Task OnHistorySortChangedAsync()
    {
        await PersistFiltersAsync();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        if (IsNewOperationRequested() && _loadError is null)
        {
            _dialogOpen = true;
        }
    }

    private bool IsNewOperationRequested()
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
        return query.Contains("new=1", StringComparison.OrdinalIgnoreCase) ||
               query.Contains("new=true", StringComparison.OrdinalIgnoreCase);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        try
        {
            _categories = await CategoriesService.ListAsync();
            _workspace = await Investments.LoadAsync();
            _instrumentOptions = _workspace.Assets
                .Where(asset => !asset.IsArchived)
                .OrderBy(asset => asset.Name, StringComparer.CurrentCultureIgnoreCase)
                .Select(asset => new InvestmentOption(asset.InstrumentId, asset.Name))
                .ToArray();
            await LoadHistoryAsync();
        }
        catch (InvalidOperationException exception) when (exception.Message.Contains("connection string", StringComparison.OrdinalIgnoreCase))
        {
            _loadError = "Il database non è configurato. Impostare la connection string 'ConnectionStrings:DefaultConnection' nelle variabili d'ambiente o nei user secrets.";
        }
        catch (Exception)
        {
            _loadError = "Impossibile contattare il database. Verificare che PostgreSQL sia raggiungibile e che la connection string sia corretta.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadHistoryAsync()
    {
        try
        {
            _historyError = null;
            _history = await History.ListAsync();
            _visibleHistory = _history
                .Where(row => !row.IsReversal && !row.IsReversed)
                .Where(row => row.Kind is OperationKind.Income or OperationKind.Expense)
                .ToArray();
            EnsurePeriod();
            ComputePeriodSummary();
        }
        catch (Exception)
        {
            _historyError = "Impossibile leggere i movimenti.";
        }
    }

    private void EnsurePeriod()
    {
        var years = PeriodYears;
        if (years.Count == 0)
        {
            _periodYear = Today.Year;
            _periodMonth = Today.Month;
            return;
        }

        if (!years.Contains(_periodYear))
        {
            _periodYear = years.Contains(Today.Year) ? Today.Year : years[^1];
        }

        _periodMonth = Math.Clamp(_periodMonth, 1, 12);
    }

    private void ComputePeriodSummary()
    {
        _altHoverSlice = null;
        var rows = PeriodHistory;
        var (income, expense) = Totals(rows);

        _periodIncome = new Money(income, Currency.Euro);
        _periodExpense = new Money(expense, Currency.Euro);
        _periodNet = new Money(income - expense, Currency.Euro);
        _periodIncomeCount = rows.Count(row => row.Kind == OperationKind.Income);
        _periodExpenseCount = rows.Count(row => row.Kind == OperationKind.Expense);

        _averageDivisor = _periodMode switch
        {
            PeriodMode.Year => _periodYear == Today.Year ? Math.Max(1, Today.Month) : 12,
            PeriodMode.All => Math.Max(1, _visibleHistory
                .Select(row => row.OperationDate.Year)
                .Distinct()
                .Count()),
            _ => 1,
        };
        _averageIncome = new Money(income / _averageDivisor, Currency.Euro);
        _averageExpense = new Money(expense / _averageDivisor, Currency.Euro);
        _averageNet = new Money((income - expense) / _averageDivisor, Currency.Euro);
    }

    private void SelectMonth(int month)
    {
        _periodMode = PeriodMode.Month;
        _periodMonth = month;
        OnPeriodChanged();
    }

    private void SelectYear()
    {
        _periodMode = PeriodMode.Year;
        OnPeriodChanged();
    }

    private void SelectAll()
    {
        _periodMode = PeriodMode.All;
        OnPeriodChanged();
    }

    private void ChangePeriodYear(int delta)
    {
        var years = PeriodYears;
        if (years.Count == 0)
        {
            return;
        }

        var index = Array.IndexOf(years.ToArray(), _periodYear);
        if (index < 0)
        {
            index = years.Count - 1;
        }

        _periodYear = years[Math.Clamp(index + delta, 0, years.Count - 1)];
        if (_periodMode == PeriodMode.All)
        {
            _periodMode = PeriodMode.Year;
        }

        OnPeriodChanged();
    }

    private void OnPeriodChanged()
    {
        // La barra del periodo è il filtro data principale: azzera l'intervallo manuale
        // della tabella per evitare che i due filtri si escludano a vicenda.
        _filterFrom = null;
        _filterTo = null;
        _datePreset = "none";
        _openFilterMenu = null;
        _page = 1;
        ComputePeriodSummary();
        _ = PersistFiltersAsync();
    }

    private string MonthShortName(int month) =>
        ItalianCulture.TextInfo.ToTitleCase(
            new DateOnly(2000, month, 1).ToString("MMM", ItalianCulture));

    private string MonthFullName(int month) =>
        ItalianCulture.TextInfo.ToTitleCase(
            new DateOnly(2000, month, 1).ToString("MMMM", ItalianCulture));

    private decimal? MonthNetFor(int month)
    {
        var rows = _visibleHistory
            .Where(row => row.OperationDate.Year == _periodYear && row.OperationDate.Month == month)
            .ToArray();
        if (rows.Length == 0)
        {
            return null;
        }

        var (income, expense) = Totals(rows);
        return income - expense;
    }

    private string MonthNetLabel(int month)
    {
        var net = MonthNetFor(month);
        if (net is null)
        {
            return "—";
        }

        var money = new Money(net.Value, Currency.Euro);
        return net.Value > 0m ? "+" + Format.MoneyNoDecimals(money) : Format.MoneyNoDecimals(money);
    }

    private string MonthButtonTitle(int month)
    {
        var net = MonthNetFor(month);
        return net is null
            ? $"{MonthFullName(month)} {_periodYear}"
            : $"{MonthFullName(month)} {_periodYear} · {Format.Money(new Money(net.Value, Currency.Euro))}";
    }

