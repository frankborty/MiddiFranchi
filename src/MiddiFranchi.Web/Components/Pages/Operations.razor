    private IReadOnlyList<int> PeriodYears => _visibleHistory
        .Select(row => row.OperationDate.Year)
        .Append(Today.Year)
        .Distinct()
        .OrderBy(year => year)
        .ToArray();

    private int MinPeriodYear => PeriodYears.Count > 0 ? PeriodYears[0] : Today.Year;

    private int MaxPeriodYear => PeriodYears.Count > 0 ? PeriodYears[^1] : Today.Year;

    private DateOnly PeriodStart => _periodMode switch
    {
        PeriodMode.Month => new DateOnly(_periodYear, _periodMonth, 1),
        PeriodMode.Year => new DateOnly(_periodYear, 1, 1),
        _ => _visibleHistory.Count == 0 ? Today : _visibleHistory.Min(row => row.OperationDate),
    };

    private DateOnly PeriodEnd => _periodMode switch
    {
        PeriodMode.Month => new DateOnly(
            _periodYear, _periodMonth, DateTime.DaysInMonth(_periodYear, _periodMonth)),
        PeriodMode.Year => new DateOnly(_periodYear, 12, 31),
        _ => _visibleHistory.Count == 0 ? Today : _visibleHistory.Max(row => row.OperationDate),
    };

    private IReadOnlyList<OperationHistoryRow> PeriodHistory => _periodMode == PeriodMode.All
        ? _visibleHistory
        : _visibleHistory
            .Where(row => row.OperationDate >= PeriodStart && row.OperationDate <= PeriodEnd)
            .ToArray();

    private IReadOnlyList<OperationHistoryRow> FilteredHistory
    {
        get
        {
            IEnumerable<OperationHistoryRow> rows = _historyFilter switch
            {
                FilterIncome => PeriodHistory.Where(row => row.Kind == OperationKind.Income),
                FilterExpense => PeriodHistory.Where(row => row.Kind == OperationKind.Expense),
                _ => PeriodHistory,
            };

            if (_filterFrom is { } from)
            {
                rows = rows.Where(row => row.OperationDate >= from);
            }

            if (_filterTo is { } to)
            {
                rows = rows.Where(row => row.OperationDate <= to);
            }

            if (_filterCategories.Count > 0)
            {
                rows = rows.Where(row => row.CategoryName is not null && _filterCategories.Contains(row.CategoryName));
            }

            if (_filterSubcategories.Count > 0)
            {
                rows = rows.Where(row => row.Subcategory is not null && _filterSubcategories.Contains(row.Subcategory));
            }

            if (!string.IsNullOrWhiteSpace(_filterSearch))
            {
                var search = _filterSearch.Trim();
                rows = rows.Where(row =>
                    (row.Description ?? string.Empty).Contains(search, StringComparison.CurrentCultureIgnoreCase) ||
                    (row.CategoryName ?? string.Empty).Contains(search, StringComparison.CurrentCultureIgnoreCase) ||
                    (row.Subcategory ?? string.Empty).Contains(search, StringComparison.CurrentCultureIgnoreCase) ||
                    Format.Date(row.OperationDate).Contains(search, StringComparison.CurrentCultureIgnoreCase) ||
                    row.OperationDate.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                        .Contains(search, StringComparison.CurrentCultureIgnoreCase) ||
                    row.OperationDate.ToString("MMMM yyyy", ItalianCulture)
                        .Contains(search, StringComparison.CurrentCultureIgnoreCase) ||
                    (row.Amount is { } amount &&
                     (Format.Money(amount).Contains(search, StringComparison.CurrentCultureIgnoreCase) ||
                      amount.Amount.ToString("0.##", ItalianCulture)
                          .Contains(search, StringComparison.CurrentCultureIgnoreCase) ||
                      amount.Amount.ToString("0.##", CultureInfo.InvariantCulture)
                          .Contains(search, StringComparison.CurrentCultureIgnoreCase) ||
                      Math.Abs(amount.Amount).ToString("0.##", CultureInfo.InvariantCulture)
                          .Contains(search, StringComparison.CurrentCultureIgnoreCase))));
            }

            if (TryParseAmount(_filterAmountMin, out var minAmount))
            {
                rows = rows.Where(row => Math.Abs(row.Amount.GetValueOrDefault().Amount) >= minAmount);
            }

            if (TryParseAmount(_filterAmountMax, out var maxAmount))
            {
                rows = rows.Where(row => Math.Abs(row.Amount.GetValueOrDefault().Amount) <= maxAmount);
            }

            return SortHistory(rows).ToArray();
        }
    }

    private IEnumerable<OperationHistoryRow> SortHistory(IEnumerable<OperationHistoryRow> rows) =>
        _historySort.Column switch
        {
            "category" => _historySort.Apply(rows, row => row.CategoryName ?? "", StringComparer.CurrentCultureIgnoreCase),
            "subcategory" => _historySort.Apply(rows, row => row.Subcategory ?? "", StringComparer.CurrentCultureIgnoreCase),
            "description" => _historySort.Apply(rows, row => row.Description ?? "", StringComparer.CurrentCultureIgnoreCase),
            "amount" => _historySort.Apply(rows, row => row.Amount?.Amount ?? decimal.MinValue),
            _ => _historySort.Apply(rows, row => row.OperationDate),
        };

    private Money FilteredIncomeTotal => new(
        FilteredHistory
            .Where(row => row.Kind == OperationKind.Income)
            .Sum(row => Math.Abs(row.Amount?.Amount ?? 0m)),
