    private IReadOnlyList<TimeSeriesSeries> TrendSeries
    {
        get
        {
            if (TrendPoints.Count == 0)
            {
                return [];
            }

            if (_trendKind == TrendKind.Delta)
            {
                var deltaPoints = TrendPoints
                    .Select(point => new TimeSeriesPoint(point.Date, point.Income - point.Expense))
                    .ToArray();
                return
                [
                    new TimeSeriesSeries(
                        "Delta",
                        deltaPoints,
                        Color: null,
                        TimeSeriesSeriesKind.Bar),
                ];
            }

            var isIncome = _trendKind == TrendKind.Income;
            var points = TrendPoints
                .Select(point => new TimeSeriesPoint(point.Date, isIncome ? point.Income : point.Expense))
                .ToArray();
            return
            [
                new TimeSeriesSeries(
                    isIncome ? "Entrate" : "Uscite",
                    points,
                    isIncome ? IncomeColor : ExpenseColor,
                    TimeSeriesSeriesKind.Bar),
            ];
        }
    }

    private IReadOnlyList<CategoryBreakdownItem> PieSlices
    {
        get
        {
            var start = PeriodStart;
            var end = PeriodEnd;
            var isIncome = _pieKind == PieKind.Income;
            var rows = _visibleHistory
                .Where(row => row.Kind == PieOperationKind &&
                              row.OperationDate >= start && row.OperationDate <= end &&
                              (isIncome ? row.Amount is { Amount: > 0m } : row.Amount is { Amount: < 0m }))
                .ToArray();
            if (rows.Length == 0)
            {
                return [];
            }

            var groups = rows
                .GroupBy(row => string.IsNullOrWhiteSpace(row.CategoryName) ? "Senza categoria" : row.CategoryName)
                .Select(group => new
                {
                    Label = group.Key,
                    Amount = group.Sum(row => Math.Abs(row.Amount.GetValueOrDefault().Amount)),
                    Color = CategoryAppearance.ColorFor(
                        group.Select(row => row.CategoryColor).FirstOrDefault(color => !string.IsNullOrWhiteSpace(color))),
                })
                .OrderByDescending(item => item.Amount)
                .ToList();

            var total = groups.Sum(item => item.Amount);
            if (total <= 0m)
            {
                return [];
            }

            var slices = new List<CategoryBreakdownItem>(groups.Count);
            var offset = 0m;
            foreach (var item in groups)
            {
                var share = item.Amount / total;
                slices.Add(new CategoryBreakdownItem(
                    item.Label,
                    new Money(item.Amount, Currency.Euro),
                    share,
                    item.Color,
                    offset));
                offset += share;
            }

            return slices;
        }
    }

    private IReadOnlyList<CategoryBreakdownItem> SelectedCategorySlices
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_selectedCategory))
            {
                return [];
            }

            var start = PeriodStart;
            var end = PeriodEnd;
            var isIncome = _pieKind == PieKind.Income;
            var rows = _visibleHistory
                .Where(row => row.Kind == PieOperationKind &&
                              row.OperationDate >= start && row.OperationDate <= end &&
                              (isIncome ? row.Amount is { Amount: > 0m } : row.Amount is { Amount: < 0m }))
                .Where(row => string.Equals(
                    string.IsNullOrWhiteSpace(row.CategoryName) ? "Senza categoria" : row.CategoryName,
                    _selectedCategory,
                    StringComparison.CurrentCultureIgnoreCase))
                .ToArray();
            if (rows.Length == 0)
            {
                return [];
            }

            var groups = rows
                .GroupBy(row => string.IsNullOrWhiteSpace(row.Subcategory) ? "Generale" : row.Subcategory)
                .Select(group => new
                {
                    Label = group.Key,
                    Amount = group.Sum(row => Math.Abs(row.Amount.GetValueOrDefault().Amount)),
                })
                .OrderByDescending(item => item.Amount)
                .ToArray();

            var total = groups.Sum(item => item.Amount);
            if (total <= 0m)
            {
                return [];
            }

            var slices = new List<CategoryBreakdownItem>(groups.Length);
            var offset = 0m;
            for (var index = 0; index < groups.Length; index++)
            {
                var group = groups[index];
                var share = group.Amount / total;
                slices.Add(new CategoryBreakdownItem(
                    group.Label,
                    new Money(group.Amount, Currency.Euro),
                    share,
                    ChartPalette.Colors[index % ChartPalette.Colors.Length],
                    offset));
                offset += share;
            }

            return slices;
        }
    }

    private Money? SelectedCategoryTotal => SelectedCategorySlices.Count == 0
        ? null
        : new Money(SelectedCategorySlices.Sum(item => item.Amount.Amount), Currency.Euro);

    private Money? PieTotal => PieSlices.Count == 0
        ? null
        : new Money(PieSlices.Sum(slice => slice.Amount.Amount), Currency.Euro);

    private string PieDescription => PieSlices.Count == 0
        ? string.Empty
        : $"{(_pieKind == PieKind.Income ? "Entrate" : "Uscite")} per categoria: {string.Join(", ", PieSlices.Select(slice => $"{slice.Label} {Format.Money(slice.Amount)} ({Format.Percent(slice.Share)})"))}.";

