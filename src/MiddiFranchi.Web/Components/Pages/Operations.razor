    private IReadOnlyList<TrendPoint> TrendPoints => _periodMode switch
    {
        PeriodMode.Month => BuildDayPoints(),
        PeriodMode.Year => BuildMonthPoints(),
        _ => BuildYearPoints(),
    };

    private IReadOnlyList<TrendPoint> BuildDayPoints()
    {
        var days = DateTime.DaysInMonth(_periodYear, _periodMonth);
        var result = new List<TrendPoint>(days);
        for (var day = 1; day <= days; day++)
        {
            var rows = _visibleHistory.Where(row =>
                row.OperationDate.Year == _periodYear &&
                row.OperationDate.Month == _periodMonth &&
                row.OperationDate.Day == day);
            var (income, expense) = Totals(rows);
            result.Add(new TrendPoint(new DateOnly(_periodYear, _periodMonth, day), income, expense));
        }

        return result;
    }

    private IReadOnlyList<TrendPoint> BuildMonthPoints()
    {
        var result = new List<TrendPoint>(12);
        for (var month = 1; month <= 12; month++)
        {
            var rows = _visibleHistory.Where(row =>
                row.OperationDate.Year == _periodYear && row.OperationDate.Month == month);
            var (income, expense) = Totals(rows);
            result.Add(new TrendPoint(new DateOnly(_periodYear, month, 1), income, expense));
        }

        return result;
    }

    private IReadOnlyList<TrendPoint> BuildYearPoints()
    {
        var years = _visibleHistory
            .Select(row => row.OperationDate.Year)
            .Distinct()
            .OrderBy(year => year)
            .ToArray();
        var result = new List<TrendPoint>(years.Length);
        foreach (var year in years)
        {
            var rows = _visibleHistory.Where(row => row.OperationDate.Year == year);
            var (income, expense) = Totals(rows);
            result.Add(new TrendPoint(new DateOnly(year, 1, 1), income, expense));
        }

        return result;
    }

    private static (decimal Income, decimal Expense) Totals(IEnumerable<OperationHistoryRow> rows)
    {
        var income = rows
            .Where(row => row.Kind == OperationKind.Income && row.Amount is { Amount: > 0m })
            .Sum(row => row.Amount.GetValueOrDefault().Amount);
        var expense = rows
            .Where(row => row.Kind == OperationKind.Expense && row.Amount is { Amount: < 0m })
            .Sum(row => -row.Amount.GetValueOrDefault().Amount);
        return (income, expense);
    }

