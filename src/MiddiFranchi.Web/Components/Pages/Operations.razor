    private void SetDatePreset(string preset)
    {
        var today = Today;
        switch (preset)
        {
            case "7d":
                _filterFrom = today.AddDays(-6);
                _filterTo = today;
                break;
            case "30d":
                _filterFrom = today.AddDays(-29);
                _filterTo = today;
                break;
            case "currentMonth":
                _periodMode = PeriodMode.Month;
                _periodYear = today.Year;
                _periodMonth = today.Month;
                _filterFrom = null;
                _filterTo = null;
                break;
            case "lastMonth":
                var previous = new DateOnly(today.Year, today.Month, 1).AddMonths(-1);
                _periodMode = PeriodMode.Month;
                _periodYear = previous.Year;
                _periodMonth = previous.Month;
                _filterFrom = null;
                _filterTo = null;
                break;
            case "currentYear":
                _periodMode = PeriodMode.Year;
                _periodYear = today.Year;
                _filterFrom = null;
                _filterTo = null;
                break;
            case "all":
                _periodMode = PeriodMode.All;
                _filterFrom = null;
                _filterTo = null;
                break;
            default:
                _filterFrom = null;
                _filterTo = null;
                break;
        }

        _datePreset = preset;
        _openFilterMenu = null;
        _page = 1;
        ComputePeriodSummary();
        _ = PersistFiltersAsync();
    }

