@page "/net-worth"
@rendermode InteractiveServer
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@using MiddiFranchi.Domain.Portfolio
@using MiddiFranchi.Domain.Shared
@inject NetWorthOverviewService NetWorthService

<PageTitle>Patrimonio netto</PageTitle>
<h1>Patrimonio netto</h1>
<p class="page-intro">
    Riepilogo del patrimonio alla data scelta: conti con saldo manuale e investimenti valorizzati.
    Tutti i valori sono in EUR.
</p>

<form class="form-grid form-inline" @onsubmit="RecalculateAsync" aria-label="Data di riferimento del riepilogo">
    <label>
        <span>Data di riferimento</span>
        <input type="date" required aria-required="true" @bind="_valuationDate" />
    </label>
    <div class="form-actions">
        <button type="submit" class="primary-button" disabled="@_loading">Ricalcola</button>
    </div>
</form>

@if (_loading)
{
    <p class="page-status">Caricamento in corso…</p>
}
else if (_loadError is not null)
{
    <p class="alert alert-error" role="alert">@_loadError</p>
    <div class="form-actions">
        <button type="button" class="secondary-button" @onclick="RecalculateAsync">Riprova</button>
    </div>
}
else if (_summary is not null)
{
    <div class="bento">
        <div class="sp-8">
            @if (_summary.IsComplete)
            {
                <StatTile Hero Label="Patrimonio netto complessivo"
                          Value="@Format.Money(_summary.TotalValue!.Value)"
                          Hint="@($"calcolo completo alla data {Format.Date(_summary.ValuationDate)}")">
                    <div>
                        <StatusBadge Tone="income">Calcolo completo</StatusBadge>
                        @if (_summary.AccountsSubtotal is { } accountsSubtotal)
                        {
                            <span class="stat-hint">Conti: @Format.Money(accountsSubtotal)</span>
                        }
                        @if (_summary.InvestmentsSubtotal is { } investmentsSubtotal)
                        {
                            <span class="stat-hint">Investimenti: @Format.Money(investmentsSubtotal)</span>
                        }
                    </div>
                </StatTile>
            }
            else
            {
                <div class="stat-tile hero">
                    <span class="stat-label">Patrimonio netto complessivo</span>
                    <strong>Patrimonio non calcolabile</strong>
                    <span class="stat-hint">Alla data @Format.Date(_summary.ValuationDate) il totale non è affidabile; nessun valore è stimato.</span>
                    <div class="stat-extra">
                        @foreach (var reason in _summary.IncompletenessReasons)
                        {
                            <span class="stat-extra-item"><StatusBadge Tone="warning">@reason</StatusBadge></span>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="sp-4">
            <dl class="summary-counts">
                <div>
                    <dt>Conti valorizzati</dt>
                    <dd>@(ValuedAccountsCount(_summary))</dd>
                </div>
                <div>
                    <dt>Conti senza saldo valido</dt>
                    <dd>@(AccountsWithoutBalanceCount(_summary))</dd>
                </div>
                <div>
                    <dt>Posizioni valorizzate</dt>
                    <dd>@(ValuedPositionsCount(_summary))</dd>
                </div>
                <div>
                    <dt>Posizioni non valorizzate</dt>
                    <dd>@(UnvaluedPositionsCount(_summary))</dd>
                </div>
            </dl>
        </div>
    </div>

    <section class="card">
        <h2><MfIcon Name="wallet" Size="18" /> Conti</h2>
        @if (_summary.Accounts.Count == 0)
        {
            <EmptyState Title="Nessun conto registrato"
                        Hint="Crea un conto e registra la prima rilevazione: entra nel patrimonio alla data in cui è valida."
                        Icon="wallet" Href="accounts" ActionLabel="Vai ai conti" />
        }
        else
        {
            <div class="table-scroll" tabindex="0">
                <table class="data-table">
                    <caption class="table-hint">Il saldo manuale è la fonte autorevole; il saldo ricostruito dai movimenti non entra nel calcolo del patrimonio netto.</caption>
                    <thead>
                        <tr>
                            <th scope="col">Conto</th>
                            <th scope="col" class="num">Saldo manuale alla data</th>
                            <th scope="col">Stato</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in _summary.Accounts)
                        {
                            <tr>
                                <td>@entry.Account.Name</td>
                                <td class="num"><AmountValue Value="@entry.Balance" UnavailableText="Saldo non registrato" /></td>
                                <td><StatusBadge Tone="@(entry.IsComplete ? "income" : "warning")">@(entry.IncompletenessReason ?? "Ok")</StatusBadge></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card">
        <h2><MfIcon Name="chart" Size="18" /> Investimenti</h2>
        @if (_summary.Investments.Positions.Count == 0)
        {
            <EmptyState Title="Nessuna posizione aperta alla data di riferimento"
                        Hint="Le posizioni si costruiscono dalle operazioni d'acquisto e vendita fino alla data scelta."
                        Icon="coin" />
        }
        else
        {
            <div class="table-scroll" tabindex="0">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th scope="col">Strumento</th>
                            <th scope="col" class="num">Quantità</th>
                            <th scope="col" class="num">Valore</th>
                            <th scope="col">Stato</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var position in _summary.Investments.Positions)
                        {
                            <tr>
                                <td>@position.Position.Instrument.Name</td>
                                <td class="num">@PositionQuantity(position.Position.Quantity)</td>
                                <td class="num">
                                    @if (position.Value is { } value)
                                    {
                                        <AmountValue Value="@value" />
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td>
                                    <StatusBadge Tone="@(position.IsValuated ? "income" : "warning")">
                                        @(position.IncompletenessReason ?? "Valorizzata")
                                    </StatusBadge>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}

@code {
    private NetWorthSummary? _summary;
    private DateOnly _valuationDate = DateOnly.FromDateTime(DateTime.Today);
    private bool _loading = true;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        await RecalculateAsync();
    }

    private async Task RecalculateAsync()
    {
        _loading = true;
        _loadError = null;
        _summary = null;
        try
        {
            _summary = await NetWorthService.SummarizeAsync(_valuationDate);
        }
        catch (InvalidOperationException exception) when (exception.Message.Contains("connection string", StringComparison.OrdinalIgnoreCase))
        {
            _loadError = "Il database non è configurato. Impostare la connection string 'ConnectionStrings:DefaultConnection' nelle variabili d'ambiente o nei user secrets.";
        }
        catch (Exception)
        {
            _loadError = "Impossibile calcolare il patrimonio netto. Verificare che PostgreSQL sia raggiungibile e che la connection string sia corretta.";
        }
        finally
        {
            _loading = false;
        }
    }

    private static string PositionQuantity(Quantity quantity) =>
        quantity.Value.ToString("N8", System.Globalization.CultureInfo.InvariantCulture)
            .TrimEnd('0')
            .TrimEnd('.');

    private static int ValuedAccountsCount(NetWorthSummary summary) =>
        summary.Accounts.Count(entry => entry.IsComplete);

    private static int AccountsWithoutBalanceCount(NetWorthSummary summary) =>
        summary.Accounts.Count(entry => entry.Balance is null);

    private static int ValuedPositionsCount(NetWorthSummary summary) =>
        summary.Investments.Positions.Count(position => position.IsValuated);

    private static int UnvaluedPositionsCount(NetWorthSummary summary) =>
        summary.Investments.Positions.Count(position => position.IsIncomplete);
}
