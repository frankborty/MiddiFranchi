@page "/investments/instruments/{InstrumentId:guid}"
@rendermode InteractiveServer
@using System.Globalization
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@using MiddiFranchi.Domain.Portfolio
@using MiddiFranchi.Domain.Shared
@inject InvestmentWorkspaceService Workspace
@inject InvestmentAssetService AssetService
@inject PriceUpdateService PriceUpdates
@inject NavigationManager Navigation

<PageTitle>@(_asset?.Name ?? "Strumento") — MiddiFranchi</PageTitle>

<header class="dashboard-header">
    <div class="instrument-header-copy">
        <a class="instrument-back" href="/investments">
            <MfIcon Name="arrow-left" Size="16" /> Investimenti
        </a>
        <h1 class="account-detail-title">
            <span class="account-avatar investments" aria-hidden="true"><MfIcon Name="pie" Size="20" /></span>
            @(_asset?.Name ?? "Strumento")
        </h1>
        @if (_asset is { } headerAsset)
        {
            <div class="instrument-header-meta">
                <StatusBadge Tone="@AssetClassPalette.Tone(headerAsset.AssetClass)">
                    @Format.AssetClassLabel(headerAsset.AssetClass)
                </StatusBadge>
                @if (headerAsset.Symbol is { } symbol)
                {
                    <span class="status-chip neutral">@symbol</span>
                }
                @if (headerAsset.Isin is { } isin)
                {
                    <span class="investment-isin">@isin</span>
                }
                @if (headerAsset.ReferenceUrl is { } referenceUrl)
                {
                    <a class="investment-link" href="@referenceUrl" target="_blank" rel="noopener noreferrer">
                        <MfIcon Name="external-link" Size="14" /> Scheda
                    </a>
                }
            </div>
        }
    </div>
    @if (_asset is { } actionAsset)
    {
        <div class="instrument-header-actions">
            @if (!actionAsset.IsArchived)
            {
                <button type="button" class="primary-button"
                        @onclick="() => OpenNewOperation(actionAsset, InvestmentOperationKind.Buy)">
                    <MfIcon Name="plus" Size="16" /> Registra operazione
                </button>
            }
            <button type="button" class="secondary-button" @onclick="OpenEditAsset">
                <MfIcon Name="edit" Size="16" /> Modifica
            </button>
            @if (!string.IsNullOrWhiteSpace(actionAsset.Isin))
            {
                <button type="button" class="icon-button"
                        title="@(_priceUpdatingFromSource ? "Aggiornamento in corso" : "Aggiorna da Borsa")"
                        aria-label="Aggiorna da Borsa"
                        disabled="@_priceUpdatingFromSource"
                        @onclick="UpdateFromSourceAsync">
                    <MfIcon Name="refresh" Size="18" />
                </button>
            }
        </div>
    }
</header>

@if (_loading)
{
    <section class="card dashboard-loading" aria-live="polite">
        <p class="page-status" role="status">Caricamento dello strumento…</p>
    </section>
}
else if (_loadError is not null)
{
    <section class="card">
        <p class="alert alert-error" role="alert">@_loadError</p>
        <div class="form-actions">
            <a class="secondary-button" href="/investments">Torna agli investimenti</a>
        </div>
    </section>
}
else if (_asset is { } asset)
{
    @if (_message is not null)
    {
        <p class="alert alert-success" role="status">@_message</p>
    }
    @if (_actionError is not null)
    {
        <p class="alert alert-error" role="alert">@_actionError</p>
    }

    <div class="investments-kpi-grid detail-kpi instrument-kpi-row">
        @if (asset.AssetClass == AssetClass.Bond)
        {
            <StatTile Label="Valore attuale" Value="@MoneyText(asset.CurrentValue)" />
            <StatTile Label="Cedole totali" Value="@Format.Money(asset.Income)" />
            <StatTile Label="Cedole annuali"
                      Value="@AnnualCouponText(asset)"
                      Hint="@AnnualCouponHint(asset)" />
            <StatTile Label="Scadenza"
                      Value="@(asset.MaturityDate is { } maturity ? Format.Date(maturity) : "Non indicata")"
                      Hint="@(asset.MaturityDate is not null ? MaturityText(asset) : null)" />
            @if (asset.CouponRate is { } couponRate)
            {
                <StatTile Label="Tasso di interesse" Value="@NumberPercent(couponRate)" />
            }
        }
        else
        {
            <StatTile Label="Valore attuale" Value="@MoneyText(asset.CurrentValue)" />
            <StatTile Label="Capitale investito" Value="@MoneyText(asset.InvestedCapital)" />
            <StatTile Label="Prezzo medio" Value="@MoneyText(asset.AverageCost)" />
            <StatTile Label="Rendimento"
                      Value="@MoneySigned(asset.TotalResult)"
                      ValueClass="@ResultClass(asset.TotalResult)" />
            <StatTile Label="Rendimento %"
                      Value="@SignedPercent(asset.TotalResultPercent)"
                      ValueClass="@ResultClass(asset.TotalResultPercent)" />
        }
        <StatTile Label="Quotazione" Value="@QuoteValue(asset)" />
    </div>

    <div class="instrument-chart-controls-bar">
        <div class="investment-chart-controls" role="group" aria-label="Intervallo dei grafici">
            @foreach (var range in ChartRangeOptions)
            {
                <button type="button"
                        class="investment-chart-range @(IsChartRange(range.Value) ? "active" : "")"
                        aria-pressed="@(IsChartRange(range.Value) ? "true" : "false")"
                        @onclick="() => SetChartRange(range.Value)">@range.Label</button>
            }
        </div>
        <label class="investment-chart-year">
            <span class="visually-hidden">Anno dei grafici</span>
            <select value="@(_chartYear?.ToString() ?? "")" @onchange="OnChartYearChanged">
                <option value="">Tutti gli anni</option>
                @foreach (var year in HistoryYears)
                {
                    <option value="@year">@year</option>
                }
            </select>
        </label>
    </div>

    <div class="bento instrument-charts">
        <section class="card investment-chart-card" aria-labelledby="instrument-value-title">
            <div class="section-head">
                <div>
                    <h2 id="instrument-value-title"><MfIcon Name="trend" Size="18" /> Valore nel tempo</h2>
                </div>
                <div class="investment-chart-legend" aria-hidden="true">
                    <span><span class="investment-class-dot" style="background:#8b5cf6"></span> Valore attuale</span>
                    <span><span class="investment-class-dot" style="background:#9ca3af"></span> Capitale investito</span>
                </div>
            </div>
            @if (ValueSeries.Count > 0)
            {
                <ApexTimeSeriesChart Title=""
                                     Currency="@Currency.Euro"
                                     Series="@ValueSeries"
                                     XAxisMin="@ChartAxisMin"
                                     XAxisMax="@ChartAxisMax"
                                     XAxisLabelMode="@ChartAxisLabelMode"
                                     Height="@(260)"
                                     ShowMarkers="false"
                                     ShowHeader="false"
                                     ShowFooter="false"
                                     ShowDataTable="false" />
            }
            else
            {
                <p class="page-status">Dati insufficienti per il periodo selezionato.</p>
            }
        </section>

        <section class="card investment-chart-card" aria-labelledby="instrument-return-title">
            <div class="section-head">
                <div>
                    <h2 id="instrument-return-title"><MfIcon Name="trend" Size="18" /> Rendimento</h2>
                </div>
                <div class="investment-chart-units" role="group" aria-label="Vista del rendimento">
                    <button type="button"
                            class="investment-chart-unit @(_returnView == ReturnView.Cumulative ? "active" : "")"
                            aria-pressed="@(_returnView == ReturnView.Cumulative ? "true" : "false")"
                            @onclick="() => SetReturnView(ReturnView.Cumulative)">Cumulativo</button>
                    <button type="button"
                            class="investment-chart-unit @(_returnView == ReturnView.Period ? "active" : "")"
                            aria-pressed="@(_returnView == ReturnView.Period ? "true" : "false")"
                            @onclick="() => SetReturnView(ReturnView.Period)">Periodo</button>
                </div>
            </div>
            @if (_returnView == ReturnView.Cumulative)
            {
                @if (ReturnSeries.Count > 0)
                {
                    <ApexTimeSeriesChart Title=""
                                         Currency="@Currency.Euro"
                                         Series="@ReturnSeries"
                                         PercentageValues="true"
                                         XAxisMin="@ChartAxisMin"
                                         XAxisMax="@ChartAxisMax"
                                         XAxisLabelMode="@ChartAxisLabelMode"
                                         Height="@(260)"
                                         ShowMarkers="false"
                                         ShowHeader="false"
                                         ShowFooter="false"
                                         ShowDataTable="false" />
                }
                else
                {
                    <p class="page-status">Dati insufficienti per il periodo selezionato.</p>
                }
            }
            else
            {
                @if (PeriodReturnPoints.Count > 0)
                {
                    <ApexTimeSeriesChart Title=""
                                         Currency="@Currency.Euro"
                                         Series="@PeriodReturnSeries"
                                         Stacked="true"
                                         ShowStackedTotal="false"
                                         PercentageValues="true"
                                         ColorPointsBySign="true"
                                         TooltipDateMode="@PeriodTooltipMode"
                                         XAxisLabelMode="@PeriodAxisLabelMode"
                                         XAxisTickAmount="@PeriodTickAmount"
                                         Height="@(260)"
                                         ShowMarkers="false"
                                         ShowHeader="false"
                                         ShowFooter="false"
                                         ShowDataTable="false" />
                }
                else
                {
                    <p class="page-status">Dati insufficienti per il periodo selezionato.</p>
                }
            }
        </section>
    </div>

    <section class="card investment-operations-card" aria-labelledby="instrument-operations-title">
        <div class="section-head">
            <div>
                <h2 id="instrument-operations-title"><MfIcon Name="list" Size="18" /> Operazioni</h2>
            </div>
        </div>

        @if (asset.Operations.Count == 0)
        {
            <p class="page-status">Nessuna operazione registrata.</p>
        }
        else
        {
            <div class="table-scroll" tabindex="0">
                <table class="data-table investment-operations-table">
                    <thead>
                        <tr>
                            <th scope="col">Data</th>
                            <th scope="col">Tipo</th>
                            <th scope="col" class="num">Quantità</th>
                            <th scope="col" class="num">Prezzo</th>
                            <th scope="col" class="num">Importo</th>
                            <th scope="col" class="num">Commissioni</th>
                            <th scope="col"><span class="visually-hidden">Azioni</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var operation in asset.Operations)
                        {
                            <tr class="@(operation.IsReversed ? "investment-operation-reversed" : "")">
                                <td>@Format.Date(operation.OperationDate)</td>
                                <td>
                                    <StatusBadge Tone="@OperationTone(operation.Kind)">
                                        @Format.InvestmentOperationKindLabel(operation.Kind)
                                    </StatusBadge>
                                </td>
                                <td class="num">@(operation.Quantity is { } quantity ? Format.Quantity(quantity) : "—")</td>
                                <td class="num">@OperationPrice(operation, asset)</td>
                                <td class="num">@OperationAmount(operation)</td>
                                <td class="num">@(operation.Fees is { } fees ? Format.Money(fees) : "—")</td>
                                <td class="num investment-operation-actions">
                                    @if (operation.IsReversed)
                                    {
                                        <StatusBadge Tone="warning">Stornata</StatusBadge>
                                    }
                                    else if (CanEditOperation(operation))
                                    {
                                        <button type="button" class="icon-button"
                                                aria-label="Modifica operazione"
                                                @onclick="() => OpenEditOperation(asset, operation)">
                                            <MfIcon Name="edit" Size="16" />
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card instrument-bottom-card instrument-info-card" aria-labelledby="instrument-info-title">
            <div class="section-head">
                <div>
                    <h2 id="instrument-info-title"><MfIcon Name="info" Size="18" /> Informazioni</h2>
                </div>
                <StatusBadge Tone="@(asset.IsArchived ? "neutral" : "income")">
                    @(asset.IsArchived ? "Archiviato" : "Attivo")
                </StatusBadge>
            </div>

            <dl class="instrument-info-list">
                <div class="instrument-info-row">
                    <dt><MfIcon Name="tag" Size="15" /> Classe</dt>
                    <dd>@Format.AssetClassLabel(asset.AssetClass)</dd>
                </div>
                <div class="instrument-info-row">
                    <dt><MfIcon Name="coin" Size="15" /> Unità di prezzo</dt>
                    <dd>@Format.PriceUnitLabel(asset.PriceUnit)</dd>
                </div>
                @if (asset.Symbol is { } symbol)
                {
                    <div class="instrument-info-row">
                        <dt><MfIcon Name="chart" Size="15" /> Simbolo</dt>
                        <dd>@symbol</dd>
                    </div>
                }
                @if (asset.Isin is { } isin)
                {
                    <div class="instrument-info-row">
                        <dt><MfIcon Name="doc" Size="15" /> Codice ISIN</dt>
                        <dd>@isin</dd>
                    </div>
                }
                @if (asset.AssetClass == AssetClass.Bond)
                {
                    <div class="instrument-info-row">
                        <dt><MfIcon Name="calendar" Size="15" /> Scadenza</dt>
                        <dd>
                            @(asset.MaturityDate is { } maturity ? Format.Date(maturity) : "Non indicata")
                            @if (asset.MaturityDate is not null)
                            {
                                <span class="instrument-info-hint">@MaturityText(asset)</span>
                            }
                        </dd>
                    </div>
                    <div class="instrument-info-row">
                        <dt><MfIcon Name="trend" Size="15" /> Tasso annuo</dt>
                        <dd>@(asset.CouponRate is { } coupon ? NumberPercent(coupon) : "Non indicato")</dd>
                    </div>
                    <div class="instrument-info-row">
                        <dt><MfIcon Name="coin" Size="15" /> Nominale per unità</dt>
                        <dd>@(asset.NotionalValue is { } notional ? Format.Money(notional) : "—")</dd>
                    </div>
                }
                <div class="instrument-info-row">
                    <dt><MfIcon Name="external-link" Size="15" /> Scheda</dt>
                    <dd>
                        <span class="instrument-sheet-links">
                            @if (asset.ReferenceUrl is { } referenceUrl)
                            {
                                <a class="instrument-sheet-link" href="@referenceUrl" target="_blank"
                                   rel="noopener noreferrer">Apri scheda</a>
                            }
                            @if (asset.Isin is { } sheetIsin)
                            {
                                <a class="instrument-sheet-link" href="@JustEtfUrl(sheetIsin)"
                                   target="_blank" rel="noopener noreferrer">JustETF</a>
                            }
                            @if (asset.ReferenceUrl is null && asset.Isin is null)
                            {
                                <span class="investment-muted">Non impostato</span>
                            }
                        </span>
                    </dd>
                </div>
            </dl>

            @if (!string.IsNullOrWhiteSpace(asset.Notes))
            {
                <div class="investment-note">
                    <MfIcon Name="doc" Size="16" />
                    <p>@asset.Notes</p>
                </div>
            }

            @if (asset.Warnings.Count > 0)
            {
                <ul class="investment-reasons" aria-label="Avvisi sullo strumento">
                    @foreach (var warning in asset.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            }

            <div class="investment-actions instrument-management-actions">
                @if (asset.IsArchived)
                {
                    <button type="button" class="secondary-button" @onclick="ReactivateAssetAsync">
                        <MfIcon Name="refresh" Size="16" /> Riattiva
                    </button>
                }
                else if (asset.Quantity is null)
                {
                    <button type="button" class="secondary-button" @onclick="RequestArchive">
                        <MfIcon Name="archive" Size="16" /> Archivia
                    </button>
                }
                else
                {
                    <button type="button" class="secondary-button" @onclick="OpenFullSaleAsync">
                        <MfIcon Name="archive" Size="16" /> Vendi tutto e archivia
                    </button>
                }

                @if (CanDelete(asset))
                {
                    <button type="button" class="delete-button compact" @onclick="RequestAssetDelete">
                        <MfIcon Name="trash" Size="16" /> Elimina
                    </button>
                }

                @if (!asset.IsArchived)
                {
                    <button type="button" class="secondary-button instrument-set-value" @onclick="TogglePriceForm">
                        <MfIcon Name="edit" Size="16" /> Setta valore
                    </button>
                }
            </div>

            @if (_confirmArchive)
            {
                <div class="alert alert-warning investment-confirm" role="alert">
                    <div>Archiviare «@asset.Name»? Lo strumento resterà visibile tra gli archiviati.</div>
                    <div class="form-actions">
                        <button type="button" class="primary-button" @onclick="ArchiveAsync">Archivia</button>
                        <button type="button" class="secondary-button" @onclick="CancelArchive">Annulla</button>
                    </div>
                </div>
            }

            @if (_confirmAssetDelete)
            {
                <div class="alert alert-warning investment-confirm" role="alert">
                    <div>Eliminare definitivamente «@asset.Name»? L'operazione non è reversibile.</div>
                    <div class="form-actions">
                        <button type="button" class="danger-button" @onclick="DeleteAssetAsync">
                            <MfIcon Name="trash" Size="16" /> Elimina definitivamente
                        </button>
                        <button type="button" class="secondary-button" @onclick="CancelAssetDelete">Annulla</button>
                    </div>
                </div>
            }
        </section>

    @if (_showPriceForm)
    {
        <div class="modal-backdrop" @onclick="CancelPrice">
            <div class="modal-card" role="dialog" aria-modal="true"
                 aria-labelledby="instrument-price-dialog-title" @onclick:stopPropagation="true">
                <div class="section-head">
                    <div>
                        <h2 id="instrument-price-dialog-title">Setta valore</h2>
                        <p class="section-sub">@asset.Name</p>
                    </div>
                    <button type="button" class="icon-button" aria-label="Chiudi"
                            disabled="@_priceSaving" @onclick="CancelPrice">
                        <MfIcon Name="close" Size="18" />
                    </button>
                </div>

                @if (_priceError is not null)
                {
                    <p class="alert alert-error" role="alert">@_priceError</p>
                }

                <form class="form-grid" @onsubmit="SavePriceAsync">
                    <label>
                        <span>@(asset.PriceUnit == PriceUnit.PercentOfNominal ? "Prezzo (% del nominale)" : "Prezzo per unità (€)")</span>
                        <input type="number" inputmode="decimal" step="any" min="0"
                               required aria-required="true" @bind="_priceValueText" />
                    </label>
                    <label>
                        <span>Data</span>
                        <input type="date" required aria-required="true" @bind="_priceDate" />
                    </label>
                    <div class="form-actions">
                        <button type="submit" class="primary-button" disabled="@_priceSaving">Salva</button>
                        <button type="button" class="secondary-button" disabled="@_priceSaving" @onclick="CancelPrice">
                            Annulla
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
}

<InvestmentOperationDialog Open="_operationDialogOpen"
                           Asset="_asset"
                           Operation="_operationBeingEdited"
                           SettlementAccounts="@(_workspace?.SettlementAccounts ?? Array.Empty<InvestmentOption>())"
                           PresetKind="_operationPresetKind"
                           LockKind="_operationLockKind"
                           PresetQuantity="_operationPresetQuantity"
                           PresetPrice="_operationPresetPrice"
                           OnClose="CloseOperationDialog"
                           OnSaved="OnOperationSaved"
                           OnDeleted="OnOperationDeleted" />

<InvestmentAssetDialog Open="_assetDialogOpen"
                       Asset="_asset"
                       CanDelete="@(_asset is { } dialogAsset && CanDelete(dialogAsset))"
                       OnClose="CloseAssetDialog"
                       OnSaved="OnAssetSaved"
                       OnDeleted="OnAssetDeleted" />

@code {
    private static readonly CultureInfo ItalianCulture = CultureInfo.GetCultureInfo("it-IT");

    [Parameter]
    public Guid InstrumentId { get; set; }

    private InvestmentWorkspace? _workspace;
    private InvestmentAssetRow? _asset;
    private bool _loading = true;
    private string? _loadError;
    private string? _message;
    private string? _actionError;

    private bool _assetDialogOpen;

    private bool _operationDialogOpen;
    private InvestmentOperationRow? _operationBeingEdited;
    private InvestmentOperationKind _operationPresetKind = InvestmentOperationKind.Buy;
    private bool _operationLockKind;
    private decimal? _operationPresetQuantity;
    private decimal? _operationPresetPrice;
    private bool _archiveAfterOperation;

    private bool _showPriceForm;
    private string _priceValueText = "";
    private DateOnly _priceDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private string? _priceError;
    private bool _priceSaving;
    private bool _priceUpdatingFromSource;

    private bool _confirmArchive;
    private bool _confirmAssetDelete;

    private ChartRange _chartRange = ChartRange.Max;
    private int? _chartYear;
    private ReturnView _returnView = ReturnView.Cumulative;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;

        try
        {
            _workspace = await Workspace.LoadAsync();
            _asset = FindAsset();
            if (_asset is null)
            {
                _loadError = "Strumento non trovato.";
            }
        }
        catch (Exception)
        {
            _loadError = "Impossibile caricare lo strumento. Verificare la connessione al database.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _workspace = await Workspace.LoadAsync();
            _asset = FindAsset();
            _loadError = _asset is null ? "Strumento non trovato." : null;
        }
        catch (Exception)
        {
            _loadError = "Impossibile aggiornare lo strumento. Verificare la connessione al database.";
        }
    }

    private InvestmentAssetRow? FindAsset() =>
        _workspace?.Assets.FirstOrDefault(asset => asset.InstrumentId == InstrumentId);

    private static readonly (ChartRange Value, string Label)[] ChartRangeOptions =
    [
        (ChartRange.SevenDays, "7G"),
        (ChartRange.OneMonth, "1M"),
        (ChartRange.SixMonths, "6M"),
        (ChartRange.YearToDate, "YTD"),
        (ChartRange.OneYear, "1A"),
        (ChartRange.Max, "Max"),
    ];

    private DateOnly ValuationDate =>
        _workspace?.Overview.ValuationDate ?? DateOnly.FromDateTime(DateTime.Today);

    private IReadOnlyList<InvestmentHistoryPoint> FilteredHistory
    {
        get
        {
            var all = _asset?.History ?? [];
            if (all.Count == 0)
            {
                return all;
            }

            var (from, to) = ChartWindow();
            if (from is null && to is null)
            {
                return all;
            }

            var points = all
                .Where(point => (from is null || point.Date > from) && (to is null || point.Date <= to))
                .ToList();

            if (from is { } start)
            {
                var last = all.LastOrDefault(point => point.Date <= start);
                if (last is not null)
                {
                    points.Insert(0, new InvestmentHistoryPoint(start, last.InvestedCapital, last.CurrentValue));
                }
            }

            return points;
        }
    }

    private IReadOnlyList<TimeSeriesSeries> ValueSeries =>
        FilteredHistory.Count < 2
            ? []
            : [
                new(
                    "Valore attuale",
                    FilteredHistory
                        .Select(point => new TimeSeriesPoint(point.Date, point.CurrentValue?.Amount))
                        .ToArray(),
                    Color: "#8b5cf6"),
                new(
                    "Capitale investito",
                    FilteredHistory
                        .Select(point => new TimeSeriesPoint(point.Date, point.InvestedCapital?.Amount))
                        .ToArray(),
                    Color: "#9ca3af"),
            ];

    private IReadOnlyList<TimeSeriesSeries> ReturnSeries =>
        FilteredHistory.Count < 2
            ? []
            : [
                new(
                    "Rendimento %",
                    FilteredHistory
                        .Select(point => new TimeSeriesPoint(
                            point.Date,
                            point.CurrentValue is { } current &&
                            point.InvestedCapital is { Amount: > 0m } invested
                                ? (current.Amount - invested.Amount) / invested.Amount
                                : null))
                        .ToArray(),
                    Color: "#8b5cf6"),
            ];

    private IReadOnlyList<TimeSeriesPoint> PeriodReturnPoints
    {
        get
        {
            var all = _asset?.History;
            if (all is null || all.Count < 2)
            {
                return [];
            }

            var samples = all
                .Where(point => point.CurrentValue is not null && point.InvestedCapital is not null)
                .OrderBy(point => point.Date)
                .ToArray();
            if (samples.Length < 2)
            {
                return [];
            }

            var (from, to) = ChartWindow();
            InvestmentHistoryPoint? previous = from is { } start
                ? samples.LastOrDefault(point => point.Date <= start)
                : null;
            var granularity = ReturnGranularity;
            var results = new List<TimeSeriesPoint>();

            foreach (var group in samples
                         .Where(point => (from is null || point.Date > from) && (to is null || point.Date <= to))
                         .GroupBy(point => PeriodKey(point.Date, granularity))
                         .OrderBy(group => group.Key))
            {
                var end = group.OrderBy(point => point.Date).Last();
                if (previous is { } startPoint &&
                    startPoint.CurrentValue is { } startValue &&
                    startPoint.InvestedCapital is { Amount: > 0m } startInvested)
                {
                    var startResult = startValue.Amount - startInvested.Amount;
                    var endResult = end.CurrentValue!.Value.Amount - end.InvestedCapital!.Value.Amount;
                    results.Add(new TimeSeriesPoint(
                        group.Key,
                        (endResult - startResult) / startInvested.Amount));
                }

                previous = end;
            }

            return results;
        }
    }

