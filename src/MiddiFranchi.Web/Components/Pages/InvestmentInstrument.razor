    private static string CouponLabel(string? description) =>
        string.IsNullOrWhiteSpace(description)
            ? "Cedola"
            : description
                .Replace("Cedola/Dividendo", "Cedola", StringComparison.CurrentCultureIgnoreCase)
                .Replace("Cedola / Dividendo", "Cedola", StringComparison.CurrentCultureIgnoreCase)
                .Trim();

    private InvestmentAssetRow? FindAsset()
    {
        if (_workspace is null)
        {
            InstrumentId = Guid.Empty;
            _canonicalKey = "";
            return null;
        }

        var keys = RouteKey.BuildKeys(
            _workspace.Assets,
            asset => asset.InstrumentId,
            asset => asset.Name,
            "strumento");

        InvestmentAssetRow? asset;
        if (Guid.TryParse(InstrumentKey, out var parsed))
        {
            asset = _workspace.Assets.FirstOrDefault(candidate => candidate.InstrumentId == parsed);
        }
        else
        {
            var match = keys.FirstOrDefault(pair =>
                string.Equals(pair.Value, InstrumentKey, StringComparison.OrdinalIgnoreCase));
            asset = match.Value is null
                ? null
                : _workspace.Assets.FirstOrDefault(candidate => candidate.InstrumentId == match.Key);
        }

        InstrumentId = asset?.InstrumentId ?? Guid.Empty;
        _canonicalKey = asset is not null && keys.TryGetValue(asset.InstrumentId, out var key) ? key : "";
        return asset;
    }

    private void CanonicalizeUrl()
    {
        if (_asset is null ||
            string.IsNullOrEmpty(_canonicalKey) ||
            string.Equals(_canonicalKey, InstrumentKey, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _loadedKey = _canonicalKey;
        Navigation.NavigateTo($"/investments/instruments/{_canonicalKey}", replace: true);
    }

