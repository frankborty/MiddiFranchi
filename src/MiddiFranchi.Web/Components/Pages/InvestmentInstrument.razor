    private string MaturityText(InvestmentAssetRow asset)
    {
        if (asset.MaturityDate is not { } maturity)
        {
            return "";
        }

        var days = maturity.DayNumber - ValuationDate.DayNumber;
        return days switch
        {
            < 0 => $"Scaduta da {-days} giorni",
            0 => "Scade oggi",
            _ => $"Mancano {days} giorni",
        };
    }

