@page "/investments/instruments/{InstrumentKey}"
@rendermode InteractiveServer
@using System.Globalization
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@using MiddiFranchi.Domain.Portfolio
@using MiddiFranchi.Domain.Shared
@inject InvestmentWorkspaceService Workspace
@inject InvestmentAssetService AssetService
@inject OperationHistoryService History
@inject SectionAppearanceService Appearance
@inject CategoryService CategoriesService
@inject PriceUpdateService PriceUpdates
@inject NavigationManager Navigation
@inject NotificationService Notifications
@inject ChartPreferences Preferences

<PageTitle>@(_asset?.Name ?? "Strumento") — MiddiFranchi</PageTitle>

<header class="dashboard-header">
    <div class="instrument-header-copy">
        <a class="instrument-back" href="/investments">
            <MfIcon Name="arrow-left" Size="16" /> Investimenti
        </a>
        <h1 class="account-detail-title">
            <span class="account-avatar investments" aria-hidden="true"><MfIcon Name="@Appearance.Get(AppSection.Investments).Icon" Size="20" /></span>
            @(_asset?.Name ?? "Strumento")
        </h1>
        @if (_asset is { } headerAsset)
        {
            <div class="instrument-header-meta">
                <StatusBadge Tone="@AssetClassPalette.Tone(headerAsset.AssetClass)">
                    @Format.AssetClassLabel(headerAsset.AssetClass)
                </StatusBadge>
                @if (headerAsset.Symbol is { } symbol)
                {
                    <span class="status-chip neutral">@symbol</span>
                }
                @if (headerAsset.Isin is { } isin)
                {
                    <span class="investment-isin">@isin</span>
                }
                @if (headerAsset.ReferenceUrl is { } referenceUrl)
                {
                    <a class="investment-link" href="@referenceUrl" target="_blank" rel="noopener noreferrer">
                        <MfIcon Name="external-link" Size="14" /> Scheda
                    </a>
                }
            </div>
        }
    </div>
    @if (_asset is { } actionAsset)
    {
        <div class="instrument-header-actions">
            @if (!actionAsset.IsArchived)
            {
                <button type="button" class="primary-button"
                        @onclick="() => OpenNewOperation(actionAsset, InvestmentOperationKind.Buy)">
                    <MfIcon Name="plus" Size="16" /> Registra operazione
                </button>
            }
            <button type="button" class="secondary-button" @onclick="OpenEditAsset">
                <MfIcon Name="edit" Size="16" /> Modifica
            </button>
            @if (!string.IsNullOrWhiteSpace(actionAsset.Isin))
            {
                <button type="button" class="icon-button"
                        title="@(_priceUpdatingFromSource ? "Aggiornamento in corso" : "Aggiorna da Borsa")"
                        aria-label="Aggiorna da Borsa"
                        disabled="@_priceUpdatingFromSource"
                        @onclick="UpdateFromSourceAsync">
                    <MfIcon Name="refresh" Size="18" />
                </button>
            }
        </div>
    }
</header>

@if (_loading)
{
    <section class="card dashboard-loading" aria-live="polite">
        <p class="page-status" role="status">Caricamento dello strumento…</p>
    </section>
}
else if (_loadError is not null)
{
    <section class="card">
        <p class="alert alert-error" role="alert">@_loadError</p>
        <div class="form-actions">
            <a class="secondary-button" href="/investments">Torna agli investimenti</a>
        </div>
    </section>
}
else if (_asset is { } asset)
{
    <div class="investments-kpi-grid detail-kpi instrument-kpi-row">
        @if (asset.AssetClass == AssetClass.Bond)
        {
            <StatTile Label="Valore attuale" Value="@MoneyText(asset.CurrentValue)" />
            <StatTile Label="Capitale investito" Value="@MoneyText(asset.InvestedCapital)" />
            <StatTile Label="Quotazione" Value="@QuoteValue(asset)" />
            <StatTile Label="Cedole nette" Value="@Format.Money(NetCouponIncome)" />
        }
        else
        {
            <StatTile Label="Valore attuale" Value="@MoneyText(asset.CurrentValue)" />
            <StatTile Label="Capitale investito" Value="@MoneyText(asset.InvestedCapital)" />
            <StatTile Label="Quotazione" Value="@QuoteValue(asset)" />
            <StatTile Label="Prezzo medio" Value="@MoneyText(asset.AverageCost)" />
            <StatTile Label="Rendimento"
                      Value="@MoneySigned(asset.TotalResult)"
                      ValueClass="@ResultClass(asset.TotalResult)" />
            <StatTile Label="Rendimento %"
                      Value="@SignedPercent(asset.TotalResultPercent)"
                      ValueClass="@ResultClass(asset.TotalResultPercent)" />
        }
    </div>

    <div class="instrument-chart-controls-bar">
        <div class="investment-chart-controls" role="group" aria-label="Intervallo dei grafici">
            @foreach (var range in ChartRangeOptions)
            {
                <button type="button"
                        class="investment-chart-range @(IsChartRange(range.Value) ? "active" : "")"
                        aria-pressed="@(IsChartRange(range.Value) ? "true" : "false")"
                        @onclick="() => SetChartRange(range.Value)">@range.Label</button>
            }
        </div>
        <label class="investment-chart-year">
            <span class="visually-hidden">Anno dei grafici</span>
            <select value="@(_chartYear?.ToString() ?? "")" @onchange="OnChartYearChanged">
                <option value="">Tutti gli anni</option>
                @foreach (var year in HistoryYears)
                {
                    <option value="@year">@year</option>
                }
            </select>
        </label>
    </div>

    <div class="bento instrument-charts">
        <section class="card investment-chart-card" aria-labelledby="instrument-value-title">
            <div class="section-head">
                <div>
                    <h2 id="instrument-value-title"><MfIcon Name="trend" Size="18" /> Valore nel tempo</h2>
                </div>
                <div class="instrument-value-head">
                    @if (CanShowUnitPrice)
                    {
                        <div class="investment-chart-units" role="group" aria-label="Vista del valore">
                            <button type="button"
                                    class="investment-chart-unit @(ShowUnitPriceView ? "" : "active")"
                                    aria-pressed="@(ShowUnitPriceView ? "false" : "true")"
                                    @onclick="() => SetValueView(ValueView.Value)">Valore</button>
                            <button type="button"
                                    class="investment-chart-unit @(ShowUnitPriceView ? "active" : "")"
                                    aria-pressed="@(ShowUnitPriceView ? "true" : "false")"
                                    @onclick="() => SetValueView(ValueView.UnitPrice)">Unitario</button>
                        </div>
                    }
                    <div class="investment-chart-legend" aria-hidden="true">
                        @if (ShowUnitPriceView)
                        {
                            <span><span class="investment-class-dot" style="background:#4f5bd5"></span> Prezzo unitario</span>
                        }
                        else
                        {
                            <span><span class="investment-class-dot" style="background:#8b5cf6"></span> Valore attuale</span>
                            <span><span class="investment-class-dot" style="background:#9ca3af"></span> Capitale investito</span>
                        }
                    </div>
                </div>
            </div>
            @if (ValueChartSeries.Count > 0)
            {
                <ApexTimeSeriesChart Title=""
                                     Currency="@ValueChartCurrency"
                                     Series="@ValueChartSeries"
                                     AxisLabelDecimals="@(ShowUnitPriceView ? 2 : 0)"
                                     XAxisMin="@ChartAxisMin"
                                     XAxisMax="@ChartAxisMax"
                                     XAxisLabelMode="@ChartAxisLabelMode"
                                     Height="@(260)"
                                     ShowMarkers="false"
                                     ShowHeader="false"
                                     ShowFooter="false"
                                     ShowDataTable="false" />
            }
            else
            {
                <p class="page-status">Dati insufficienti per il periodo selezionato.</p>
            }
        </section>

        <section class="card investment-chart-card" aria-labelledby="instrument-return-title">
            <div class="section-head">
                <div>
                    <h2 id="instrument-return-title"><MfIcon Name="trend" Size="18" /> Rendimento</h2>
                </div>
                <div class="investment-chart-units" role="group" aria-label="Vista del rendimento">
                    <button type="button"
                            class="investment-chart-unit @(_returnView == ReturnView.Cumulative ? "active" : "")"
                            aria-pressed="@(_returnView == ReturnView.Cumulative ? "true" : "false")"
                            @onclick="() => SetReturnView(ReturnView.Cumulative)">Cumulativo</button>
                    <button type="button"
                            class="investment-chart-unit @(_returnView == ReturnView.Period ? "active" : "")"
                            aria-pressed="@(_returnView == ReturnView.Period ? "true" : "false")"
                            @onclick="() => SetReturnView(ReturnView.Period)">Periodo</button>
                </div>
            </div>
            @if (_returnView == ReturnView.Cumulative)
            {
                @if (ReturnSeries.Count > 0)
                {
                    <ApexTimeSeriesChart Title=""
                                         Currency="@Currency.Euro"
                                         Series="@ReturnSeries"
                                         PercentageValues="true"
                                         XAxisMin="@ChartAxisMin"
                                         XAxisMax="@ChartAxisMax"
                                         XAxisLabelMode="@ChartAxisLabelMode"
                                         Height="@(260)"
                                         ShowMarkers="false"
                                         ShowHeader="false"
                                         ShowFooter="false"
                                         ShowDataTable="false" />
                }
                else
                {
                    <p class="page-status">Dati insufficienti per il periodo selezionato.</p>
                }
            }
            else
            {
                @if (PeriodReturnPoints.Count > 0)
                {
                    <ApexTimeSeriesChart Title=""
                                         Currency="@Currency.Euro"
                                         Series="@PeriodReturnSeries"
                                         Stacked="true"
                                         ShowStackedTotal="false"
                                         PercentageValues="true"
                                         ColorPointsBySign="true"
                                         TooltipDateMode="@PeriodTooltipMode"
                                         XAxisLabelMode="@PeriodAxisLabelMode"
                                         XAxisTickAmount="@PeriodTickAmount"
                                         Height="@(260)"
                                         ShowMarkers="false"
                                         ShowHeader="false"
                                         ShowFooter="false"
                                         ShowDataTable="false" />
                }
                else
                {
                    <p class="page-status">Dati insufficienti per il periodo selezionato.</p>
                }
            }
        </section>
    </div>

    @if (asset.AssetClass == AssetClass.Bond)
    {
        <section class="card" aria-labelledby="bond-coupons-title">
            <div class="section-head">
                <div>
                    <h2 id="bond-coupons-title"><MfIcon Name="percent" Size="18" /> Cedole pagate</h2>
                </div>
            </div>

            @if (CouponPayments.Count == 0)
            {
                <p class="page-status">Nessuna cedola registrata.</p>
            }
            else
            {
                <div class="table-scroll" tabindex="0">
                    <table class="data-table instrument-coupons-table mobile-cards mobile-cards--sortable">
                        <thead>
                            <tr>
                                <SortableTh OnSort="() => StateHasChanged()" Sort="_couponSort" Column="date" Label="Data" />
                                <SortableTh OnSort="() => StateHasChanged()" Sort="_couponSort" Column="description" Label="Descrizione" />
                                <SortableTh OnSort="() => StateHasChanged()" Sort="_couponSort" Column="gross" Label="Lordo" Numeric="true" />
                                <SortableTh OnSort="() => StateHasChanged()" Sort="_couponSort" Column="tax" Label="Tasse" Numeric="true" />
                                <SortableTh OnSort="() => StateHasChanged()" Sort="_couponSort" Column="net" Label="Netto" Numeric="true" />
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var coupon in SortedCoupons)
                            {
                                <tr class="history-row" tabindex="0" title="Apri e modifica"
                                    @onclick="() => OpenCouponAsync(coupon)">
                                    <td data-label="Data">@Format.Date(coupon.Date)</td>
                                    <td data-label="Descrizione">@coupon.Description</td>
                                    <td class="num" data-label="Lordo">@Format.Money(coupon.Gross)</td>
                                    <td class="num" data-label="Tasse">@Format.Money(coupon.Tax)</td>
                                    <td class="num" data-label="Netto">@Format.Money(coupon.Net)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    <section class="card investment-operations-card" aria-labelledby="instrument-operations-title">
        <div class="section-head">
            <div>
                <h2 id="instrument-operations-title"><MfIcon Name="list" Size="18" /> Operazioni</h2>
            </div>
        </div>

        @if (VisibleOperations.Count == 0)
        {
            <p class="page-status">Nessuna operazione registrata.</p>
        }
        else
        {
            <div class="table-scroll" tabindex="0">
                <table class="data-table investment-operations-table mobile-cards mobile-cards--sortable">
                    <thead>
                        <tr>
                            <SortableTh OnSort="() => StateHasChanged()" Sort="_operationSort" Column="date" Label="Data" />
                            <SortableTh OnSort="() => StateHasChanged()" Sort="_operationSort" Column="kind" Label="Tipo" />
                            <SortableTh OnSort="() => StateHasChanged()" Sort="_operationSort" Column="quantity" Label="Quantità" Numeric="true" />
                            <SortableTh OnSort="() => StateHasChanged()" Sort="_operationSort" Column="price" Label="Prezzo" Numeric="true" />
                            <SortableTh OnSort="() => StateHasChanged()" Sort="_operationSort" Column="amount" Label="Importo" Numeric="true" />
                            <SortableTh OnSort="() => StateHasChanged()" Sort="_operationSort" Column="fees" Label="Commissioni" Numeric="true" />
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var operation in SortedOperations)
                        {
                            var editable = CanEditOperation(operation);
                            <tr class="@(operation.IsReversed ? "investment-operation-reversed" : "") @(editable ? "investment-operation-clickable" : "")"
                                tabindex="@(editable ? 0 : -1)"
                                title="@(editable ? "Apri e modifica" : null)"
                                @onclick="() => OpenEditOperation(asset, operation)">
                                <td data-label="Data">@Format.Date(operation.OperationDate)</td>
                                <td data-label="Tipo">
                                    <StatusBadge Tone="@OperationTone(operation.Kind)">
                                        @Format.InvestmentOperationKindLabel(operation.Kind)
                                    </StatusBadge>
                                    @if (operation.IsReversed)
                                    {
                                        <StatusBadge Tone="warning">Stornata</StatusBadge>
                                    }
                                </td>
                                <td class="num" data-label="Quantità">@(operation.Quantity is { } quantity ? Format.Quantity(quantity) : "—")</td>
                                <td class="num" data-label="Prezzo">@OperationPrice(operation, asset)</td>
                                <td class="num" data-label="Importo">@OperationAmount(operation)</td>
                                <td class="num" data-label="Commissioni">@(operation.Fees is { } fees ? Format.Money(fees) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card instrument-bottom-card instrument-info-card" aria-labelledby="instrument-info-title">
            <div class="section-head">
                <div>
                    <h2 id="instrument-info-title"><MfIcon Name="info" Size="18" /> Informazioni</h2>
                </div>
                <StatusBadge Tone="@(asset.IsArchived ? "neutral" : "income")">
                    @(asset.IsArchived ? "Archiviato" : "Attivo")
                </StatusBadge>
            </div>

            <dl class="instrument-info-list">
                <div class="instrument-info-row">
                    <dt><MfIcon Name="tag" Size="15" /> Classe</dt>
                    <dd>@Format.AssetClassLabel(asset.AssetClass)</dd>
                </div>
                <div class="instrument-info-row">
                    <dt><MfIcon Name="coin" Size="15" /> Unità di prezzo</dt>
                    <dd>@Format.PriceUnitLabel(asset.PriceUnit)</dd>
                </div>
                <div class="instrument-info-row">
                    <dt><MfIcon Name="percent" Size="15" /> Tassazione</dt>
                    <dd>@NumberPercent(asset.TaxRate)</dd>
                </div>
                @if (asset.Symbol is { } symbol)
                {
                    <div class="instrument-info-row">
                        <dt><MfIcon Name="chart" Size="15" /> Simbolo</dt>
                        <dd>@symbol</dd>
                    </div>
                }
                @if (asset.Isin is { } isin)
                {
                    <div class="instrument-info-row">
                        <dt><MfIcon Name="doc" Size="15" /> Codice ISIN</dt>
                        <dd>@isin</dd>
                    </div>
                }
                @if (asset.AssetClass == AssetClass.Bond)
                {
                    <div class="instrument-info-row">
                        <dt><MfIcon Name="calendar" Size="15" /> Scadenza</dt>
                        <dd>@(asset.MaturityDate is { } maturity ? Format.Date(maturity) : "Non indicata")</dd>
                    </div>
                    <div class="instrument-info-row">
                        <dt><MfIcon Name="trend" Size="15" /> Tasso annuo</dt>
                        <dd>@(asset.CouponRate is { } coupon ? NumberPercent(coupon) : "Non indicato")</dd>
                    </div>
                    <div class="instrument-info-row">
                        <dt><MfIcon Name="coin" Size="15" /> Nominale per unità</dt>
                        <dd>@(asset.NotionalValue is { } notional ? Format.Money(notional) : "—")</dd>
                    </div>
                }
                <div class="instrument-info-row">
                    <dt><MfIcon Name="external-link" Size="15" /> Scheda</dt>
                    <dd>
                        <span class="instrument-sheet-links">
                            @if (asset.ReferenceUrl is { } referenceUrl)
                            {
                                <a class="instrument-sheet-link" href="@referenceUrl" target="_blank"
                                   rel="noopener noreferrer">Apri scheda</a>
                            }
                            @if (asset.ReferenceUrl is null)
                            {
                                <span class="investment-muted">Non impostato</span>
                            }
                        </span>
                    </dd>
                </div>
            </dl>

            @if (!string.IsNullOrWhiteSpace(asset.Notes))
            {
                <div class="investment-note">
                    <MfIcon Name="doc" Size="16" />
                    <p>@asset.Notes</p>
                </div>
            }

            @if (asset.Warnings.Count > 0)
            {
                <ul class="investment-reasons" aria-label="Avvisi sullo strumento">
                    @foreach (var warning in asset.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            }

            <div class="investment-actions instrument-management-actions">
                @if (asset.IsArchived)
                {
                    <button type="button" class="secondary-button" @onclick="ReactivateAssetAsync">
                        <MfIcon Name="refresh" Size="16" /> Riattiva
                    </button>
                }
                else if (asset.Quantity is null)
                {
                    <button type="button" class="secondary-button" @onclick="RequestArchive">
                        <MfIcon Name="archive" Size="16" /> Archivia
                    </button>
                }
                else
                {
                    <button type="button" class="secondary-button" @onclick="OpenFullSaleAsync">
                        <MfIcon Name="archive" Size="16" /> Vendi tutto e archivia
                    </button>
                }

                @if (CanDelete(asset))
                {
                    <button type="button" class="delete-button compact" @onclick="RequestAssetDelete">
                        <MfIcon Name="trash" Size="16" /> Elimina
                    </button>
                }

                @if (!asset.IsArchived)
                {
                    <button type="button" class="secondary-button instrument-set-value" @onclick="TogglePriceForm">
                        <MfIcon Name="edit" Size="16" /> Setta valore
                    </button>
                }
            </div>

            @if (_confirmArchive)
            {
                <div class="alert alert-warning investment-confirm" role="alert">
                    <div>Archiviare «@asset.Name»? Lo strumento resterà visibile tra gli archiviati.</div>
                    <div class="form-actions">
                        <button type="button" class="primary-button" @onclick="ArchiveAsync">Archivia</button>
                        <button type="button" class="secondary-button" @onclick="CancelArchive">Annulla</button>
                    </div>
                </div>
            }

            @if (_confirmAssetDelete)
            {
                <div class="alert alert-warning investment-confirm" role="alert">
                    <div>Eliminare definitivamente «@asset.Name»? L'operazione non è reversibile.</div>
                    <div class="form-actions">
                        <button type="button" class="danger-button" @onclick="DeleteAssetAsync">
                            <MfIcon Name="trash" Size="16" /> Elimina definitivamente
                        </button>
                        <button type="button" class="secondary-button" @onclick="CancelAssetDelete">Annulla</button>
                    </div>
                </div>
            }
        </section>

    @if (_showPriceForm)
    {
        <div class="modal-backdrop" @onclick="CancelPrice">
            <div class="modal-card" role="dialog" aria-modal="true"
                 aria-labelledby="instrument-price-dialog-title" @onclick:stopPropagation="true">
                <div class="section-head">
                    <div>
                        <h2 id="instrument-price-dialog-title">Setta valore</h2>
                        <p class="section-sub">@asset.Name</p>
                    </div>
                    <button type="button" class="icon-button" aria-label="Chiudi"
                            disabled="@_priceSaving" @onclick="CancelPrice">
                        <MfIcon Name="close" Size="18" />
                    </button>
                </div>

                @if (_priceError is not null)
                {
                    <p class="alert alert-error" role="alert">@_priceError</p>
                }

                <form class="form-grid" @onsubmit="SavePriceAsync">
                    <label>
                        <span>@(asset.PriceUnit == PriceUnit.PercentOfNominal ? "Prezzo (% del nominale)" : "Prezzo per unità (€)")</span>
                        <input type="text" inputmode="decimal"
                               required aria-required="true" @bind="_priceValueText" />
                    </label>
                    <label>
                        <span>Data</span>
                        <input type="date" required aria-required="true" @bind="_priceDate" />
                    </label>
                    <div class="form-actions">
                        <button type="submit" class="primary-button" disabled="@_priceSaving">Salva</button>
                        <button type="button" class="secondary-button" disabled="@_priceSaving" @onclick="CancelPrice">
                            Annulla
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }
}

<InvestmentOperationDialog Open="_operationDialogOpen"
                           Asset="_asset"
                           Operation="_operationBeingEdited"
                           PresetKind="_operationPresetKind"
                           LockKind="_operationLockKind"
                           PresetQuantity="_operationPresetQuantity"
                           PresetPrice="_operationPresetPrice"
                           OnClose="CloseOperationDialog"
                           OnSaved="OnOperationSaved"
                           OnDeleted="OnOperationDeleted" />

<OperationEditDialog Open="_couponEditOpen"
                     Operation="_editingCouponIncome"
                     Categories="_categories"
                     Instruments="InstrumentOptions"
                     ShowTax="true"
                     OnClose="CloseCouponEdit"
                     OnSaved="OnCouponSaved" />

<InvestmentAssetDialog Open="_assetDialogOpen"
                       Asset="_asset"
                       CanDelete="@(_asset is { } dialogAsset && CanDelete(dialogAsset))"
                       OnClose="CloseAssetDialog"
                       OnSaved="OnAssetSaved"
                       OnDeleted="OnAssetDeleted" />

@code {
    private static readonly CultureInfo ItalianCulture = CultureInfo.GetCultureInfo("it-IT");

    [Parameter]
    public string InstrumentKey { get; set; } = "";

    private Guid InstrumentId { get; set; }
    private string _canonicalKey = "";
    private string? _loadedKey;

    private InvestmentWorkspace? _workspace;
    private IReadOnlyList<InvestmentOption> InstrumentOptions =>
        _workspace?.Assets
            .Where(asset => !asset.IsArchived)
            .OrderBy(asset => asset.Name, StringComparer.CurrentCultureIgnoreCase)
            .Select(asset => new InvestmentOption(asset.InstrumentId, asset.Name))
            .ToArray() ?? [];
    private InvestmentAssetRow? _asset;
    private IReadOnlyList<OperationHistoryRow> _couponIncomes = [];
    private IReadOnlyList<OperationHistoryRow> _couponTaxes = [];
    private IReadOnlyList<Category> _categories = [];
    private bool _couponEditOpen;
    private OperationHistoryRow? _editingCouponIncome;
    private bool _loading = true;
    private string? _loadError;
    private readonly TableSort _couponSort = new("date", descending: true);
    private readonly TableSort _operationSort = new("date", descending: true);

    private bool _assetDialogOpen;

    private bool _operationDialogOpen;
    private InvestmentOperationRow? _operationBeingEdited;
    private InvestmentOperationKind _operationPresetKind = InvestmentOperationKind.Buy;
    private bool _operationLockKind;
    private decimal? _operationPresetQuantity;
    private decimal? _operationPresetPrice;
    private bool _archiveAfterOperation;

    private bool _showPriceForm;
    private string _priceValueText = "";
    private DateOnly _priceDate = DateOnly.FromDateTime(DateTime.UtcNow);
    private string? _priceError;
    private bool _priceSaving;
    private bool _priceUpdatingFromSource;

    private bool _confirmArchive;
    private bool _confirmAssetDelete;

    private ChartRange _chartRange = ChartRange.Max;
    private int? _chartYear;
    private ReturnView _returnView = ReturnView.Cumulative;
    private ValueView _valueView = ValueView.Value;
    private bool _preferencesLoaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _preferencesLoaded)
        {
            return;
        }

        _preferencesLoaded = true;

        var range = await Preferences.GetAsync("mf.chart.instrument.range");
        if (Enum.TryParse<ChartRange>(range, out var storedRange))
        {
            _chartRange = storedRange;
        }

        var year = await Preferences.GetAsync("mf.chart.instrument.year");
        _chartYear = int.TryParse(year, out var storedYear) ? storedYear : null;

        var view = await Preferences.GetAsync("mf.chart.instrument.view");
        if (Enum.TryParse<ReturnView>(view, out var storedView))
        {
            _returnView = storedView;
        }

        var valueView = await Preferences.GetAsync("mf.chart.instrument.value-view");
        if (Enum.TryParse<ValueView>(valueView, out var storedValueView))
        {
            _valueView = storedValueView;
        }

        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_loadedKey, InstrumentKey, StringComparison.Ordinal))
        {
            return;
        }

        _loadedKey = InstrumentKey;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;

        try
        {
            _workspace = await Workspace.LoadAsync();
            _asset = FindAsset();
            if (_asset is null)
            {
                _loadError = "Strumento non trovato.";
                _couponIncomes = [];
            }
            else
            {
                await LoadCouponIncomesAsync();
                CanonicalizeUrl();
            }
        }
        catch (Exception)
        {
            _loadError = "Impossibile caricare lo strumento. Verificare la connessione al database.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _workspace = await Workspace.LoadAsync();
            _asset = FindAsset();
            _loadError = _asset is null ? "Strumento non trovato." : null;
            await LoadCouponIncomesAsync();
            CanonicalizeUrl();
        }
        catch (Exception)
        {
            _loadError = "Impossibile aggiornare lo strumento. Verificare la connessione al database.";
        }
    }

    private async Task LoadCouponIncomesAsync()
    {
        if (_asset is not { AssetClass: AssetClass.Bond } bond)
        {
            _couponIncomes = [];
            return;
        }

        var history = await History.ListAsync();
        _couponIncomes = history
            .Where(row => !row.IsInvestment &&
                row.Kind == OperationKind.Income &&
                row.InstrumentId == bond.InstrumentId)
            .ToArray();
        _couponTaxes = history
            .Where(row => row.Kind == OperationKind.Expense &&
                row.InstrumentId == bond.InstrumentId &&
                string.Equals(row.CategoryName, "Fees", StringComparison.CurrentCultureIgnoreCase) &&
                string.Equals(row.Subcategory, "Tasse Investimenti", StringComparison.CurrentCultureIgnoreCase))
            .ToArray();
    }

    private Money TotalCouponIncome =>
        _asset is { AssetClass: AssetClass.Bond } asset
            ? asset.Income + new Money(_couponIncomes.Sum(row => row.Amount?.Amount ?? 0m), Currency.Euro)
            : _asset?.Income ?? new Money(0m, Currency.Euro);

    private Money NetCouponIncome
    {
        get
        {
            var tax = CouponPayments.Sum(payment => payment.Gross.Amount - payment.Net.Amount);
            return new Money(TotalCouponIncome.Amount - tax, Currency.Euro);
        }
    }

    private IReadOnlyList<InvestmentOperationRow> VisibleOperations =>
        _asset?.Operations
            .Where(operation => operation.Kind is not (InvestmentOperationKind.Coupon or InvestmentOperationKind.Dividend))
            .ToArray() ?? [];

    private IReadOnlyList<CouponPayment> CouponPayments
    {
        get
        {
            if (_asset is not { AssetClass: AssetClass.Bond } asset)
            {
                return [];
            }

            var investmentCoupons = asset.Operations
                .Where(operation =>
                    operation.Kind == InvestmentOperationKind.Coupon &&
                    !operation.IsReversed &&
                    operation.Amount is not null)
                .Select(operation =>
                {
                    var amount = operation.Amount!.Value;
                    var tax = operation.Tax?.Amount ?? 0m;
                    return new CouponPayment(
                        operation.OperationDate,
                        CouponLabel(operation.Description),
                        amount,
                        new Money(tax, amount.Currency),
                        new Money(amount.Amount - tax, amount.Currency),
                        operation.Id,
                        true);
                });

            var incomeCoupons = _couponIncomes
                .Where(row => row.Amount is { Amount: > 0m })
                .Select(row =>
                {
                    var gross = row.Amount!.Value;
                    var tax = TaxFor(row);
                    return new CouponPayment(
                        row.OperationDate,
                        CouponLabel(row.Description),
                        gross,
                        tax,
                        new Money(gross.Amount - tax.Amount, gross.Currency),
                        row.Id,
                        false);
                });

            return investmentCoupons
                .Concat(incomeCoupons)
                .OrderByDescending(payment => payment.Date)
                .ToArray();
        }
    }

    private IReadOnlyList<CouponPayment> SortedCoupons => _couponSort.Column switch
    {
        "description" => _couponSort.Apply(
            CouponPayments,
            coupon => coupon.Description,
            StringComparer.CurrentCultureIgnoreCase).ToArray(),
        "gross" => _couponSort.Apply(CouponPayments, coupon => coupon.Gross.Amount).ToArray(),
        "tax" => _couponSort.Apply(CouponPayments, coupon => coupon.Tax.Amount).ToArray(),
        "net" => _couponSort.Apply(CouponPayments, coupon => coupon.Net.Amount).ToArray(),
        _ => _couponSort.Apply(CouponPayments, coupon => coupon.Date).ToArray(),
    };

    private IReadOnlyList<InvestmentOperationRow> SortedOperations => _operationSort.Column switch
    {
        "kind" => _operationSort.Apply(
            VisibleOperations,
            operation => Format.InvestmentOperationKindLabel(operation.Kind),
            StringComparer.CurrentCultureIgnoreCase).ToArray(),
        "quantity" => _operationSort.Apply(
            VisibleOperations,
            operation => operation.Quantity?.Value ?? decimal.MinValue).ToArray(),
        "price" => _operationSort.Apply(
            VisibleOperations,
            operation => operation.Price ?? decimal.MinValue).ToArray(),
        "amount" => _operationSort.Apply(
            VisibleOperations,
            operation => OperationSortAmount(operation)).ToArray(),
        "fees" => _operationSort.Apply(
            VisibleOperations,
            operation => operation.Fees?.Amount ?? decimal.MinValue).ToArray(),
        _ => _operationSort.Apply(VisibleOperations, operation => operation.OperationDate).ToArray(),
    };

    private static decimal OperationSortAmount(InvestmentOperationRow operation) =>
        operation.Kind is InvestmentOperationKind.Buy or InvestmentOperationKind.Sell
            ? operation.GrossAmount?.Amount ?? decimal.MinValue
            : operation.Amount?.Amount ?? decimal.MinValue;

    private Money TaxFor(OperationHistoryRow income)
    {
        if (income.Tax is { } linkedTax)
        {
            return linkedTax;
        }

        var tax = _couponTaxes
            .Where(row => row.OperationDate == income.OperationDate && row.RecordedAt == income.RecordedAt)
            .Sum(row => Math.Abs(row.Amount?.Amount ?? 0m));
        return new Money(tax, Currency.Euro);
    }

