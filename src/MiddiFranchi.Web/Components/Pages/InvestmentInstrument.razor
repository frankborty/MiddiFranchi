    private async Task UpdateFromSourceAsync()
    {
        if (_priceUpdatingFromSource || _asset is not { } asset)
        {
            return;
        }

        _priceUpdatingFromSource = true;
        try
        {
            var result = await PriceUpdates.UpdateInstrumentAsync(asset.InstrumentId);
            if (result.Success)
            {
                await Notifications.Success("Quotazione aggiornata da Borsa Italiana.");
                await ReloadAsync();
            }
            else
            {
                await Notifications.Error(result.Error ?? "Aggiornamento non riuscito.");
            }
        }
        catch (Exception)
        {
            await Notifications.Error("Impossibile aggiornare la quotazione da Borsa Italiana.");
        }
        finally
        {
            _priceUpdatingFromSource = false;
        }
    }

    private async Task SavePriceAsync()
    {
        if (_priceSaving)
        {
            return;
        }

        _priceError = null;
        if (!TryParseDecimal(_priceValueText, out var price) || price <= 0m)
        {
            _priceError = "La quotazione deve essere positiva.";
            return;
        }

        _priceSaving = true;
        try
        {
            await AssetService.RecordPriceAsync(new RecordPriceRequest(InstrumentId, price, _priceDate));
            _showPriceForm = false;
            await Notifications.Success("Quotazione aggiornata.");
            await ReloadAsync();
        }
        catch (ArgumentException exception)
        {
            _priceError = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _priceError = exception.Message;
        }
        catch (Exception)
        {
            _priceError = "Impossibile salvare la quotazione. Verificare la connessione al database e riprovare.";
        }
        finally
        {
            _priceSaving = false;
        }
    }

