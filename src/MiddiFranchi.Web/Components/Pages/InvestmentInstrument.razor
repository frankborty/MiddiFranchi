    private void TogglePriceForm()
    {
        if (_showPriceForm)
        {
            CancelPrice();
            return;
        }

        _showPriceForm = true;
        _priceValueText = _asset?.LatestPrice?.ToString(CultureInfo.InvariantCulture) ?? "";
        _priceDate = DateOnly.FromDateTime(DateTime.UtcNow);
        _priceError = null;
    }

    private void CancelPrice()
    {
        if (_priceSaving)
        {
            return;
        }

        _showPriceForm = false;
        _priceError = null;
    }

    private async Task UpdateFromSourceAsync()
    {
        if (_priceUpdatingFromSource || _asset is not { } asset)
        {
            return;
        }

        _priceUpdatingFromSource = true;
        _message = null;
        _actionError = null;
        try
        {
            var result = await PriceUpdates.UpdateInstrumentAsync(asset.InstrumentId);
            if (result.Success)
            {
                _message = "Quotazione aggiornata da Borsa Italiana.";
                await ReloadAsync();
            }
            else
            {
                _actionError = result.Error ?? "Aggiornamento non riuscito.";
            }
        }
        catch (Exception)
        {
            _actionError = "Impossibile aggiornare la quotazione da Borsa Italiana.";
        }
        finally
        {
            _priceUpdatingFromSource = false;
        }
    }

    private async Task SavePriceAsync()
    {
        if (_priceSaving)
        {
            return;
        }

        _priceError = null;
        if (!TryParseDecimal(_priceValueText, out var price) || price <= 0m)
        {
            _priceError = "La quotazione deve essere positiva.";
            return;
        }

        _priceSaving = true;
        try
        {
            await AssetService.RecordPriceAsync(new RecordPriceRequest(InstrumentId, price, _priceDate));
            _showPriceForm = false;
            _message = "Quotazione aggiornata.";
            await ReloadAsync();
        }
        catch (ArgumentException exception)
        {
            _priceError = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _priceError = exception.Message;
        }
        catch (Exception)
        {
            _priceError = "Impossibile salvare la quotazione. Verificare la connessione al database e riprovare.";
        }
        finally
        {
            _priceSaving = false;
        }
    }

