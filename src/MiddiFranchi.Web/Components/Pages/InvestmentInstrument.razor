    private IReadOnlyList<TimeSeriesPoint> PeriodReturnPoints
    {
        get
        {
            var all = _asset?.History;
            if (all is null || all.Count < 2)
            {
                return [];
            }

            var samples = all
                .Where(point => point.CurrentValue is not null && point.InvestedCapital is not null)
                .OrderBy(point => point.Date)
                .ToArray();
            if (samples.Length < 2)
            {
                return [];
            }

            var (from, to) = ChartWindow();
            InvestmentHistoryPoint? previous = from is { } start
                ? samples.LastOrDefault(point => point.Date <= start)
                : null;
            var granularity = ReturnGranularity;
            var results = new List<TimeSeriesPoint>();

            foreach (var group in samples
                         .Where(point => (from is null || point.Date > from) && (to is null || point.Date <= to))
                         .GroupBy(point => PeriodKey(point.Date, granularity))
                         .OrderBy(group => group.Key))
            {
                var end = group.OrderBy(point => point.Date).Last();
                if (previous is { } startPoint &&
                    startPoint.CurrentValue is { } startValue &&
                    startPoint.InvestedCapital is { Amount: > 0m } startInvested)
                {
                    var startResult = startValue.Amount - startInvested.Amount;
                    var endResult = end.CurrentValue!.Value.Amount - end.InvestedCapital!.Value.Amount;
                    results.Add(new TimeSeriesPoint(
                        group.Key,
                        (endResult - startResult) / startInvested.Amount));
                }

                previous = end;
            }

            return results;
        }
    }

