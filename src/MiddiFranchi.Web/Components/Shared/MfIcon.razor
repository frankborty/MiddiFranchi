@namespace MiddiFranchi.Web.Components.Shared
@* Icona SVG inline: eredita colore dal contesto (currentColor), decorativa per screen reader. *@
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
     width="@Size" height="@Size" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "dashboard":
            <rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/>
            <rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>
            break;
        case "wallet":
            <path d="M21 8V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-2"/>
            <path d="M21 8H13a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h8"/><circle cx="17.5" cy="11" r="1"/>
            break;
        case "swap":
            <path d="M16 3h5v5"/><path d="M8 21H3v-5"/>
            <path d="M21 3l-7 7"/><path d="M3 21l7-7"/>
            break;
        case "list":
            <path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/>
            <path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/>
            break;
        case "tag":
            <path d="M12.6 2.9 21 11.3a2 2 0 0 1 0 2.8l-6.9 6.9a2 2 0 0 1-2.8 0L2.9 12.6A2 2 0 0 1 2.3 11.2V4.3a2 2 0 0 1 2-2h6.9c.53 0 1.03.21 1.4.59Z"/>
            <circle cx="7.5" cy="7.5" r="1.2"/>
            break;
        case "chart":
            <path d="M3 20h18"/>
            <rect x="5" y="11" width="3.5" height="6" rx="1"/><rect x="10.5" y="7" width="3.5" height="10" rx="1"/><rect x="16" y="3" width="3.5" height="14" rx="1"/>
            break;
        case "trend":
            <path d="M3 17l6-6 4 4 8-8"/><path d="M21 12V7h-5"/>
            break;
        case "trend-down":
            <path d="M3 7l6 6 4-4 8 8"/><path d="M21 12v5h-5"/>
            break;
        case "pie":
            <path d="M21.2 15.9A10 10 0 1 1 8 2.8"/><path d="M22 12A10 10 0 0 0 12 2v10Z"/>
            break;
        case "calendar":
            <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/>
            break;
        case "clock":
            <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>
            break;
        case "plus":
            <path d="M12 5v14"/><path d="M5 12h14"/>
            break;
        case "arrow-right":
            <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
            break;
        case "menu":
            <path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/>
            break;
        case "close":
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
            break;
        case "sun":
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.9 4.9 1.4 1.4"/><path d="m17.7 17.7 1.4 1.4"/>
            <path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.3 17.7-1.4 1.4"/><path d="m19.1 4.9-1.4 1.4"/>
            break;
        case "moon":
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
            break;
        case "alert":
            <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/>
            <path d="M12 9v4"/><path d="M12 17h.01"/>
            break;
        case "info":
            <circle cx="12" cy="12" r="9"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
            break;
        case "check":
            <path d="M20 6 9 17l-5-5"/>
            break;
        case "doc":
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/>
            <path d="M14 2v6h6"/><path d="M9 15h6"/><path d="M9 11h2"/>
            break;
        case "bank":
            <path d="m2 8 10-6 10 6"/><path d="M4 8v9"/><path d="M9 8v9"/><path d="M15 8v9"/><path d="M20 8v9"/>
            <path d="M2 20h20"/><path d="M2 17h20"/>
            break;
        case "coin":
            <circle cx="12" cy="12" r="9"/><path d="M8.5 9.5 10 11l3-4"/>
            <path d="M9.5 13.5 8 15h8l-1.5-1.5"/><path d="M12 15.5V18"/>
            break;
        case "transfer":
            <path d="M17 4v13"/><path d="m13 13 4 4 4-4"/>
            <path d="M7 20V7"/><path d="m11 11-4-4-4 4" transform="scale(-1,1) translate(-14,0)"/>
            break;
        default:
            <circle cx="12" cy="12" r="9"/>
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = "dashboard";

    /// <summary>Dimensione in pixel; il colore è ereditato via currentColor.</summary>
    [Parameter]
    public int Size { get; set; } = 20;

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
