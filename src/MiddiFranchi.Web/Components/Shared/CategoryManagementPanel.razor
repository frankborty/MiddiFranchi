@namespace MiddiFranchi.Web.Components.Shared
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@inject CategoryService CategoriesService

@if (_loading)
{
    <section class="card">
        <p class="page-status" role="status">Caricamento delle categorie…</p>
    </section>
}
else if (_loadError is not null)
{
    <section class="card">
        <p class="alert alert-error" role="alert">@_loadError</p>
    </section>
}
else
{
    <div class="bento">
        <div class="sp-7">
            @if (_categories.Count == 0)
            {
                <section class="card">
                    <EmptyState Title="Nessuna categoria registrata"
                                Hint="Creane una qui accanto: servono per classificare entrate e uscite durante la registrazione."
                                Icon="tag" />
                </section>
            }
            else
            {
                <section class="card">
                    <div class="section-head">
                        <div class="section-title-row">
                            <h2>Elenco</h2>
                            <StatusBadge Tone="brand">@CategoryCountLabel</StatusBadge>
                        </div>
                    </div>
                    <div class="table-scroll" tabindex="0">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th scope="col">Categoria</th>
                                    <th scope="col">Sottocategoria</th>
                                    <th scope="col">Tipo</th>
                                    <th scope="col">Descrizione</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var category in _categories)
                                {
                                    <tr>
                                        <td>
                                            <button type="button"
                                                    class="table-link"
                                                    title="Apri impostazioni categoria"
                                                    @onclick="() => OpenSettings(category)">
                                                @category.Name
                                            </button>
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(category.Subcategory) ? "-" : category.Subcategory)</td>
                                        <td>
                                            <StatusBadge Tone="@(category.Type == CategoryType.Income ? "income" : "expense")">
                                                @Format.CategoryTypeLabel(category.Type)
                                            </StatusBadge>
                                        </td>
                                        <td>@(string.IsNullOrWhiteSpace(category.Description) ? "-" : category.Description)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </div>

        <div class="sp-5">
            <section class="card">
                <h2><MfIcon Name="plus" Size="18" /> Nuova categoria</h2>
                @if (_createdMessage is not null)
                {
                    <p class="alert alert-success" role="status">@_createdMessage</p>
                }
                @if (_createError is not null)
                {
                    <p class="alert alert-error" role="alert">@_createError</p>
                }
                <form class="form-grid" @onsubmit="CreateAsync">
                    <label>
                        <span>Categoria *</span>
                        <input type="text" maxlength="200" required aria-required="true" @bind="_name" />
                    </label>
                    <label>
                        <span>Sottocategoria *</span>
                        <input type="text" maxlength="200" required aria-required="true" @bind="_subcategory" />
                    </label>
                    <label>
                        <span>Tipo *</span>
                        <select @bind="_type" required aria-required="true">
                            <option value="@nameof(CategoryType.Income)">Entrate</option>
                            <option value="@nameof(CategoryType.Expense)">Uscite</option>
                        </select>
                    </label>
                    <label>
                        <span>Descrizione</span>
                        <input type="text" maxlength="200" @bind="_description" />
                    </label>
                    <div class="form-actions">
                        <button type="submit" class="primary-button" disabled="@_saving"><MfIcon Name="plus" Size="18" /> Crea categoria</button>
                        @if (_saving)
                        {
                            <span class="page-status">Creazione in corso…</span>
                        }
                    </div>
                </form>
            </section>
        </div>
    </div>

    @if (_settingsCategory is { } selected)
    {
        <CategorySettingsDialog Open="_settingsOpen"
                                CategoryId="@selected.Id"
                                Name="@selected.Name"
                                Subcategory="@selected.Subcategory"
                                Type="@selected.Type"
                                Description="@selected.Description"
                                OnClose="CloseSettings"
                                OnSaved="OnSettingsSaved" />
    }
}

@code {
    private IReadOnlyList<Category> _categories = [];
    private bool _loading = true;
    private bool _saving;
    private string? _loadError;
    private string? _createError;
    private string? _createdMessage;
    private string _name = "";
    private string _subcategory = "";
    private string _type = nameof(CategoryType.Income);
    private string? _description;
    private Category? _settingsCategory;
    private bool _settingsOpen;

    private string CategoryCountLabel =>
        _categories.Count == 1 ? "1 categoria" : $"{_categories.Count} categorie";

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        try
        {
            _loadError = null;
            _categories = await CategoriesService.ListAsync();
        }
        catch (InvalidOperationException exception) when (exception.Message.Contains("connection string", StringComparison.OrdinalIgnoreCase))
        {
            _loadError = "Il database non è configurato. Impostare la connection string 'ConnectionStrings:DefaultConnection' nelle variabili d'ambiente o nei user secrets.";
        }
        catch (Exception)
        {
            _loadError = "Impossibile contattare il database. Verificare che PostgreSQL sia raggiungibile e che la connection string sia corretta.";
        }
    }

    private async Task CreateAsync()
    {
        if (_saving)
        {
            return;
        }

        _createError = null;
        _createdMessage = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _createError = "La categoria è obbligatoria.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_subcategory))
        {
            _createError = "La sottocategoria è obbligatoria.";
            return;
        }

        _saving = true;
        try
        {
            var category = await CategoriesService.CreateAsync(
                new NewCategory(
                    _name.Trim(),
                    Enum.Parse<CategoryType>(_type),
                    string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                    _subcategory.Trim()));
            _createdMessage = $"Categoria «{category.Name}» registrata.";
            _name = "";
            _subcategory = "";
            _description = null;
            await ReloadAsync();
        }
        catch (ArgumentException exception)
        {
            _createError = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _createError = exception.Message;
        }
        catch (Exception)
        {
            _createError = "Creazione non riuscita: verificare la connessione al database e riprovare.";
        }
        finally
        {
            _saving = false;
        }
    }

    private void OpenSettings(Category category)
    {
        _settingsCategory = category;
        _settingsOpen = true;
    }

    private void CloseSettings()
    {
        _settingsOpen = false;
        _settingsCategory = null;
    }

    private async Task OnSettingsSaved(Category category)
    {
        _createdMessage = $"Categoria «{category.Name}» aggiornata.";
        await ReloadAsync();
    }
}
