@namespace MiddiFranchi.Web.Components.Shared
@using System.Globalization
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@using MiddiFranchi.Domain.Shared
@inject LoanService LoansService

@if (Open)
{
    <div class="modal-backdrop" @onclick="CloseAsync">
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="new-loan-dialog-title"
             @onclick:stopPropagation="true">
            <div class="section-head">
                <div>
                    <h2 id="new-loan-dialog-title">Nuovo prestito</h2>
                    <p class="section-sub">Il prestito sarà gestito con le sue rilevazioni.</p>
                </div>
                <button type="button" class="icon-button" aria-label="Chiudi" disabled="@_saving" @onclick="CloseAsync">
                    <MfIcon Name="close" Size="18" />
                </button>
            </div>

            @if (_error is not null)
            {
                <p class="alert alert-error" role="alert">@_error</p>
            }

            <form class="form-grid" @onsubmit="SaveAsync">
                <label>
                    <span>Debitore *</span>
                    <input type="text" maxlength="200" required aria-required="true" autofocus @bind="_borrower" />
                </label>
                <label>
                    <span>Importo iniziale (facoltativo)</span>
                    <input type="number" step="any" @bind="_amount" />
                </label>
                <label>
                    <span>Data</span>
                    <input type="date" @bind="_validAt" />
                </label>
                <div class="form-actions">
                    <button type="submit" class="primary-button" disabled="@_saving">
                        <MfIcon Name="plus" Size="18" /> Crea prestito
                    </button>
                    <button type="button" class="secondary-button" disabled="@_saving" @onclick="CloseAsync">Annulla</button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }

    [Parameter, EditorRequired] public Guid AccountId { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback<Loan> OnSaved { get; set; }

    private bool _wasOpen;
    private bool _saving;
    private string? _error;
    private string _borrower = "";
    private string _amount = "";
    private DateOnly? _validAt;

    protected override void OnParametersSet()
    {
        if (!Open)
        {
            _wasOpen = false;
            return;
        }

        if (_wasOpen)
        {
            return;
        }

        _wasOpen = true;
        _saving = false;
        _error = null;
        _borrower = "";
        _amount = "";
        _validAt = DateOnly.FromDateTime(DateTime.UtcNow);
    }

    private async Task CloseAsync()
    {
        if (_saving)
        {
            return;
        }

        await OnClose.InvokeAsync();
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _error = null;

        Money? initialAmount = null;
        DateOnly? initialDate = null;

        if (!string.IsNullOrWhiteSpace(_amount))
        {
            if (!TryParseAmount(_amount, out var parsed))
            {
                _error = "L'importo iniziale deve essere un numero (per esempio: 123,45).";
                return;
            }

            if (_validAt is null)
            {
                _error = "La data della rilevazione iniziale è obbligatoria.";
                return;
            }

            initialAmount = new Money(parsed, Currency.Euro);
            initialDate = _validAt;
        }

        _saving = true;
        try
        {
            var loan = await LoansService.CreateAsync(
                new NewLoan(AccountId, _borrower, initialAmount, initialDate));
            await OnSaved.InvokeAsync(loan);
            await OnClose.InvokeAsync();
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (Exception)
        {
            _error = "Registrazione non riuscita: verificare la connessione al database e riprovare.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static bool TryParseAmount(string text, out decimal amount) =>
        decimal.TryParse(text, NumberStyles.Any, CultureInfo.InvariantCulture, out amount)
        || decimal.TryParse(text, NumberStyles.Any, CultureInfo.GetCultureInfo("it-IT"), out amount);
}
