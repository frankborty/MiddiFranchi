@namespace MiddiFranchi.Web.Components.Shared

<div class="color-picker-control">
    <div class="color-swatches" role="group" aria-label="@Label">
        @foreach (var color in Palette)
        {
            <button type="button"
                    class="@(IsSelected(color.Hex) ? "color-swatch selected" : "color-swatch")"
                    style="--swatch: @color.Hex"
                    title="@color.Label"
                    aria-label="@color.Label"
                    aria-pressed="@(IsSelected(color.Hex) ? "true" : "false")"
                    disabled="@Disabled"
                    @onclick="() => SelectAsync(color.Hex)">
                @if (IsSelected(color.Hex))
                {
                    <MfIcon Name="check" Size="14" />
                }
            </button>
        }
    </div>

    <div class="color-custom-row">
        <span class="color-custom-preview" style="--swatch: @Normalized" aria-hidden="true"></span>
        <input class="color-hex-input" type="text" maxlength="7" spellcheck="false"
               @bind="_hexDraft" @bind:event="oninput" @bind:after="OnHexDraftChanged"
               disabled="@Disabled" aria-label="Codice colore esadecimale" />
    </div>
</div>

@code {
    private static readonly (string Hex, string Label)[] Palette =
    [
        ("#0ea5e9", "Azzurro"),
        ("#1d7047", "Verde bosco"),
        ("#2f6f7d", "Teal"),
        ("#4f5bd5", "Indaco"),
        ("#b86b35", "Ruggine"),
        ("#6f8f2f", "Lime scuro"),
        ("#b34432", "Terracotta"),
        ("#8a5a12", "Ambra"),
        ("#6f6b5e", "Pietra"),
        ("#7d4a7a", "Prugna"),
        ("#356b9e", "Blu"),
        ("#2f5d3a", "Foresta"),
        ("#a67c1f", "Senape"),
        ("#8f4f68", "Rosa antico"),
        ("#5d5a8a", "Lavanda scura"),
        ("#3f6f5b", "Salvia"),
        ("#8a6238", "Cuoio"),
        ("#b04a5a", "Ciliegia"),
        ("#4d6a4c", "Muschio"),
        ("#64748b", "Ardesia"),
        ("#475569", "Grigio scuro"),
        ("#166534", "Verde profondo"),
        ("#1e3a8a", "Blu navy"),
        ("#9f1239", "Bordeaux"),
        ("#78716c", "Pietra scura"),
    ];

    private string _hexDraft = "#646b60";

    [Parameter] public string Value { get; set; } = "#646b60";

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string Label { get; set; } = "Colore";

    [Parameter] public bool Disabled { get; set; }

    private string Normalized => Normalize(Value);

    protected override void OnParametersSet() => _hexDraft = Normalized;

    private bool IsSelected(string color) =>
        string.Equals(Normalized, color, StringComparison.OrdinalIgnoreCase);

    private async Task SelectAsync(string color)
    {
        if (!Disabled)
        {
            await ValueChanged.InvokeAsync(color);
        }
    }

    private async Task OnHexDraftChanged()
    {
        if (Disabled)
        {
            return;
        }

        var value = _hexDraft.Trim();
        if (value.Length > 0 && !value.StartsWith('#'))
        {
            value = "#" + value;
        }

        if (IsHex(value))
        {
            await ValueChanged.InvokeAsync(Normalize(value));
        }
    }

    private static bool IsHex(string? value) =>
        value is { Length: 7 } && value[0] == '#' && value.Skip(1).All(Uri.IsHexDigit);

    private static string Normalize(string? value) =>
        IsHex(value) ? value!.ToLowerInvariant() : "#646b60";
}
