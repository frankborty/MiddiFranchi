@namespace MiddiFranchi.Web.Components.Shared
@using System.Globalization
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@using MiddiFranchi.Domain.Portfolio
@using MiddiFranchi.Domain.Shared
@inject InvestmentAssetService AssetService
@inject InvestmentIncomeService InvestmentIncome
@inject CategoryService CategoryService

@if (Open && Asset is not null)
{
    <div class="modal-backdrop" @onclick="CloseAsync">
        <div class="modal-card investment-dialog" role="dialog" aria-modal="true"
             aria-labelledby="investment-operation-dialog-title" @onclick:stopPropagation="true">
            <div class="section-head">
                <div>
                    <h2 id="investment-operation-dialog-title">@DialogTitle</h2>
                    <p class="section-sub">@DialogSubtitle</p>
                </div>
                <button type="button" class="icon-button" aria-label="Chiudi" disabled="@_saving" @onclick="CloseAsync">
                    <MfIcon Name="close" Size="18" />
                </button>
            </div>

            @if (Operation is null && !LockKind)
            {
                <div class="investment-kind-tabs" role="group" aria-label="Tipo di operazione">
                    <button type="button" class="@KindClass(InvestmentOperationKind.Buy)"
                            aria-pressed="@AriaPressed(_kind == InvestmentOperationKind.Buy)"
                            @onclick="() => SelectKind(InvestmentOperationKind.Buy)">
                        <MfIcon Name="trend" Size="16" /> Acquisto
                    </button>
                    <button type="button" class="@KindClass(InvestmentOperationKind.Sell)"
                            aria-pressed="@AriaPressed(_kind == InvestmentOperationKind.Sell)"
                            @onclick="() => SelectKind(InvestmentOperationKind.Sell)">
                        <MfIcon Name="trend-down" Size="16" /> Vendita
                    </button>
                    <button type="button" class="@IncomeKindClass()"
                            aria-pressed="@AriaPressed(IsIncomeKind)"
                            @onclick="SelectIncomeKind">
                        <MfIcon Name="percent" Size="16" /> Cedola
                    </button>
                </div>
            }

            @if (_error is not null)
            {
                <p class="alert alert-error" role="alert">@_error</p>
            }

            @if ((_kind is InvestmentOperationKind.Buy or InvestmentOperationKind.Sell) && QuantityPreview is { } available)
            {
                <p class="table-hint">
                    Quantità detenuta: @Format.Quantity(available)
                    @if (Asset.LatestPrice is { } latest)
                    {
                        <text> · ultima quotazione @latest.ToString("N4", CultureInfo.GetCultureInfo("it-IT")) @(Asset.PriceUnit == PriceUnit.PercentOfNominal ? "% del nominale" : "€")</text>
                    }
                </p>
            }

            <form class="form-grid" @onsubmit="SaveAsync">
                <label>
                    <span>Data *</span>
                    <input type="date" required aria-required="true" @bind="_date" />
                </label>

                @if (IsCashFlow)
                {
                    <label>
                        <span>Quantità *</span>
                        <input type="text" inputmode="decimal" placeholder="0"
                               required aria-required="true" disabled="@LockQuantity" @bind="_quantityText" />
                    </label>

                    <label>
                        <span>@PriceLabel *</span>
                        <input type="text" inputmode="decimal" placeholder="0,00"
                               required aria-required="true" @bind="_priceText" />
                    </label>

                    <label>
                        <span>Commissioni (€)</span>
                        <input type="text" inputmode="decimal" placeholder="0,00"
                               @bind="_feeText" />
                    </label>

                    @if (_kind == InvestmentOperationKind.Sell)
                    {
                        <label>
                            <span>Tasse pagate (€)</span>
                            <input type="text" inputmode="decimal" placeholder="0,00" @bind="_taxText" />
                        </label>
                    }
                }
                else
                {
                    <label>
                        <span>Importo della cedola (€) *</span>
                        <input type="text" inputmode="decimal" placeholder="0,00"
                               required aria-required="true" @bind="_amountText" />
                    </label>

                    <label>
                        <span>Tasse pagate (€)</span>
                        <input type="text" inputmode="decimal" placeholder="0,00" @bind="_taxText" />
                    </label>
                }

                <label class="operation-form-wide">
                    <span>Descrizione / Nota</span>
                    <input type="text" maxlength="200" placeholder="Es. Acquisto PAC, cedola semestrale…"
                           @bind="_description" />
                </label>

                @if (Preview is not null)
                {
                    <p class="investment-operation-preview operation-form-wide">
                        <span>@PreviewLabel</span>
                        <strong>@Preview</strong>
                    </p>
                }

                <div class="form-actions">
                    <button type="submit" class="primary-button" disabled="@(_saving || _deleting)">
                        <MfIcon Name="@SaveIcon" Size="18" />
                        @SubmitLabel
                    </button>
                    <button type="button" class="secondary-button" disabled="@(_saving || _deleting)" @onclick="CloseAsync">
                        Annulla
                    </button>
                </div>
            </form>

            @if (Operation is not null)
            {
                <div class="settings-danger-zone investment-delete-zone">
                    @if (_deleteError is not null)
                    {
                        <p class="alert alert-error" role="alert">@_deleteError</p>
                    }
                    @if (_confirmingDelete)
                    {
                        <div class="alert alert-warning" role="alert">
                            <div>Eliminare questa operazione? L'operazione non è reversibile.</div>
                            <div class="form-actions">
                                <button type="button" class="danger-button" disabled="@_deleting" @onclick="DeleteAsync">
                                    <MfIcon Name="trash" Size="16" /> Elimina definitivamente
                                </button>
                                <button type="button" class="secondary-button" disabled="@_deleting" @onclick="CancelDelete">
                                    Annulla
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="delete-button" disabled="@(_saving || _deleting)" @onclick="StartDelete">
                            <MfIcon Name="trash" Size="16" /> Elimina operazione
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private static readonly CultureInfo ItalianCulture = CultureInfo.GetCultureInfo("it-IT");

    [Parameter] public bool Open { get; set; }

    [Parameter] public InvestmentAssetRow? Asset { get; set; }

    [Parameter] public InvestmentOperationRow? Operation { get; set; }

    [Parameter] public InvestmentOperationKind PresetKind { get; set; } = InvestmentOperationKind.Buy;

    [Parameter] public bool LockKind { get; set; }

    [Parameter] public decimal? PresetQuantity { get; set; }

    [Parameter] public decimal? PresetPrice { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback OnSaved { get; set; }

    [Parameter] public EventCallback OnDeleted { get; set; }

    private bool _wasOpen;
    private bool _saving;
    private bool _deleting;
    private bool _confirmingDelete;
    private string? _error;
    private string? _deleteError;
    private InvestmentOperationKind _kind = InvestmentOperationKind.Buy;
    private DateOnly _date = DateOnly.FromDateTime(DateTime.UtcNow);
    private string _quantityText = "";
    private string _priceText = "";
    private string _feeText = "";
    private string _taxText = "";
    private string _amountText = "";
    private string _description = "";

    private bool IsCashFlow =>
        _kind is InvestmentOperationKind.Buy or InvestmentOperationKind.Sell;

    private bool IsIncomeKind =>
        _kind is InvestmentOperationKind.Dividend or InvestmentOperationKind.Coupon;

    private InvestmentOperationKind IncomeKind =>
        Asset?.AssetClass == AssetClass.Bond
            ? InvestmentOperationKind.Coupon
            : InvestmentOperationKind.Dividend;

    private bool LockQuantity => LockKind && PresetQuantity is not null;

    private bool IsFullSale => Operation is null && LockKind && PresetQuantity is not null;

    private string SaveIcon => Operation is null ? "plus" : "check";

    private string DialogTitle => Operation is not null
        ? "Modifica operazione"
        : IsFullSale
            ? "Vendi tutto e archivia"
            : "Nuova operazione";

    private string DialogSubtitle => IsFullSale
        ? $"{Asset?.Name} · al salvataggio lo strumento viene archiviato."
        : $"{Asset?.Name} · {Format.AssetClassLabel(Asset?.AssetClass ?? AssetClass.Other)}";

    private string SubmitLabel => Operation is not null
        ? "Salva modifiche"
        : IsFullSale
            ? "Vendi tutto e archivia"
            : "Registra operazione";

    private string PriceLabel => Asset?.PriceUnit == PriceUnit.PercentOfNominal
        ? "Prezzo (% del nominale)"
        : "Prezzo per unità (€)";

    private Quantity? QuantityPreview => Asset?.Quantity;

    private string? PreviewLabel => IsCashFlow
        ? (_kind == InvestmentOperationKind.Sell ? "Incasso netto" : "Totale operazione")
        : "Importo incassato";

    private string? Preview
    {
        get
        {
            if (IsCashFlow)
            {
                if (!TryParseDecimal(_quantityText, out var quantity) || quantity <= 0m ||
                    !TryParseDecimal(_priceText, out var price) || price <= 0m ||
                    Asset is null)
                {
                    return null;
                }

                var effectivePrice = Asset.PriceUnit == PriceUnit.PercentOfNominal
                    ? (Asset.NotionalValue?.Amount ?? 0m) * price / 100m
                    : price;
                var total = quantity * effectivePrice;
                var sellTax = _kind == InvestmentOperationKind.Sell &&
                          TryParseDecimal(_taxText, out var parsedSellTax) &&
                          parsedSellTax > 0m
                    ? parsedSellTax
                    : 0m;
                var net = total - sellTax;
                return net > 0m ? Format.Money(new Money(net, Currency.Euro)) : null;
            }

            return TryParseDecimal(_amountText, out var amount) && amount > 0m
                ? Format.Money(new Money(
                    amount - (TryParseDecimal(_taxText, out var tax) && tax > 0m ? tax : 0m),
                    Currency.Euro))
                : null;
        }
    }

    protected override void OnParametersSet()
    {
        if (!Open || Asset is null)
        {
            _wasOpen = false;
            return;
        }

        if (_wasOpen)
        {
            return;
        }

        _wasOpen = true;
        _saving = false;
        _deleting = false;
        _confirmingDelete = false;
        _error = null;
        _deleteError = null;
        _kind = Operation?.Kind ?? PresetKind;
        _date = Operation?.OperationDate ?? DateOnly.FromDateTime(DateTime.UtcNow);
        _quantityText = DecimalText.Format(Operation?.Quantity?.Value ?? PresetQuantity);
        _priceText = DecimalText.Format(Operation?.Price ?? PresetPrice);
        _feeText = IsCashFlow ? DecimalText.Format(Operation?.Fees?.Amount) : "";
        _taxText = !IsCashFlow || _kind == InvestmentOperationKind.Sell
            ? DecimalText.Format(Operation?.Tax?.Amount)
            : "";
        _amountText = DecimalText.Format(Operation?.Amount?.Amount);
        _description = Operation?.Description ?? "";
    }

    private void SelectKind(InvestmentOperationKind kind)
    {
        if (_kind == kind)
        {
            return;
        }

        _kind = kind;
        _error = null;
    }

    private void SelectIncomeKind() => SelectKind(IncomeKind);

    private async Task SaveAsync()
    {
        if (_saving || _deleting || Asset is null)
        {
            return;
        }

        _error = null;

        decimal? quantity = null;
        decimal? price = null;
        decimal? fee = null;
        decimal? amount = null;
        decimal? tax = null;

        if (IsCashFlow)
        {
            if (!TryParseDecimal(_quantityText, out var parsedQuantity) || parsedQuantity <= 0m)
            {
                _error = "La quantità deve essere positiva.";
                return;
            }

            if (!TryParseDecimal(_priceText, out var parsedPrice) || parsedPrice <= 0m)
            {
                _error = "Il prezzo deve essere positivo.";
                return;
            }

            quantity = parsedQuantity;
            price = parsedPrice;

            if (!string.IsNullOrWhiteSpace(_feeText))
            {
                if (!TryParseDecimal(_feeText, out var parsedFee) || parsedFee < 0m)
                {
                    _error = "Le commissioni non possono essere negative.";
                    return;
                }

                fee = parsedFee;
            }

            if (_kind == InvestmentOperationKind.Sell && !string.IsNullOrWhiteSpace(_taxText))
            {
                if (!TryParseDecimal(_taxText, out var parsedTax) || parsedTax < 0m)
                {
                    _error = "Le tasse non possono essere negative.";
                    return;
                }

                tax = parsedTax;
            }
        }
        else
        {
            if (!TryParseDecimal(_amountText, out var parsedAmount) || parsedAmount <= 0m)
            {
                _error = "L'importo deve essere positivo.";
                return;
            }

            amount = parsedAmount;

            if (!string.IsNullOrWhiteSpace(_taxText))
            {
                if (!TryParseDecimal(_taxText, out var parsedTax) || parsedTax < 0m)
                {
                    _error = "Le tasse non possono essere negative.";
                    return;
                }

                if (parsedTax > parsedAmount)
                {
                    _error = "Le tasse non possono superare l'importo della cedola.";
                    return;
                }

                tax = parsedTax;
            }
        }

        var description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim();

        _saving = true;
        try
        {
            if (Operation is null && _kind is
                InvestmentOperationKind.Dividend or InvestmentOperationKind.Coupon)
            {
                await RegisterCouponIncomeAsync(amount!.Value, tax, description);
            }
            else if (Operation is null)
            {
                await AssetService.RegisterOperationAsync(new RegisterInvestmentOperationRequest(
                    Asset.InstrumentId,
                    _kind,
                    _date,
                    quantity,
                    price,
                    fee,
                    amount,
                    description,
                    tax));
            }
            else
            {
                await AssetService.UpdateOperationAsync(new UpdateInvestmentOperationRequest(
                    Operation.Id,
                    _date,
                    quantity,
                    price,
                    fee,
                    amount,
                    description,
                    tax));
            }

            await OnSaved.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (Exception)
        {
            _error = "Impossibile salvare l'operazione. Verificare i dati e riprovare.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RegisterCouponIncomeAsync(
        decimal gross,
        decimal? tax,
        string? description)
    {
        if (Asset is null)
        {
            return;
        }

        var categories = await CategoryService.ListAsync();
        var incomeCategory = categories.FirstOrDefault(category =>
            category.Type == CategoryType.Income &&
            string.Equals(category.Name, "Cedole", StringComparison.CurrentCultureIgnoreCase));
        var taxCategory = categories.FirstOrDefault(category =>
            category.Type == CategoryType.Expense &&
            string.Equals(category.Name, "Fees", StringComparison.CurrentCultureIgnoreCase) &&
            string.Equals(category.Subcategory, "Tasse Investimenti", StringComparison.CurrentCultureIgnoreCase));

        if (incomeCategory is null || taxCategory is null)
        {
            throw new InvalidOperationException(
                "Mancano le categorie Cedole e Fees/Tasse Investimenti.");
        }

        PositiveMoney? taxMoney = tax is > 0m
            ? new PositiveMoney(new Money(tax.Value, Currency.Euro))
            : null;

        await InvestmentIncome.RegisterAsync(new RegisterInvestmentIncomeRequest(
            Asset.InstrumentId,
            incomeCategory.Id,
            taxCategory.Id,
            new PositiveMoney(new Money(gross, Currency.Euro)),
            taxMoney,
            _date,
            string.IsNullOrWhiteSpace(description) ? null : description));
    }

    private void StartDelete()
    {
        _deleteError = null;
        _confirmingDelete = true;
    }

    private void CancelDelete()
    {
        _confirmingDelete = false;
        _deleteError = null;
    }

    private async Task DeleteAsync()
    {
        if (Operation is null || _deleting)
        {
            return;
        }

        _deleting = true;
        _deleteError = null;
        try
        {
            await AssetService.DeleteOperationAsync(Operation.Id);
            await OnDeleted.InvokeAsync();
            await OnClose.InvokeAsync();
        }
        catch (InvalidOperationException exception)
        {
            _deleteError = exception.Message;
        }
        catch (Exception)
        {
            _deleteError = "Impossibile eliminare l'operazione. Verificare la connessione al database e riprovare.";
        }
        finally
        {
            _deleting = false;
        }
    }

    private async Task CloseAsync()
    {
        if (_saving || _deleting)
        {
            return;
        }

        await OnClose.InvokeAsync();
    }

    private string KindClass(InvestmentOperationKind kind)
    {
        var tone = kind switch
        {
            InvestmentOperationKind.Buy => "income",
            InvestmentOperationKind.Sell => "expense",
            InvestmentOperationKind.Dividend => "brand",
            _ => "teal",
        };
        return _kind == kind
            ? $"operation-kind-tab {tone} active"
            : $"operation-kind-tab {tone}";
    }

    private string IncomeKindClass()
    {
        var tone = IncomeKind == InvestmentOperationKind.Coupon ? "teal" : "brand";
        return IsIncomeKind
            ? $"operation-kind-tab {tone} active"
            : $"operation-kind-tab {tone}";
    }

    private static string AriaPressed(bool value) => value ? "true" : "false";

    private static bool TryParseDecimal(string? text, out decimal value) =>
        DecimalText.TryParse(text, out value);
}
