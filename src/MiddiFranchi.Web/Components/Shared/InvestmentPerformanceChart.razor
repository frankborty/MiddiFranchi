@namespace MiddiFranchi.Web.Components.Shared
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@using MiddiFranchi.Domain.Shared
@inject ChartPreferences Preferences

<section class="card investment-chart-card" aria-labelledby="investment-chart-title">
    <div class="section-head">
        <div>
            <h2 id="investment-chart-title"><MfIcon Name="trend" Size="18" /> Valore nel tempo</h2>
        </div>
        <div class="investment-chart-legend" aria-hidden="true">
            <span><span class="investment-class-dot" style="background:#4f5bd5"></span> Valore attuale</span>
            <span><span class="investment-class-dot" style="background:#8f9787"></span> Capitale investito</span>
            @if (OperationAnnotations.Count > 0)
            {
                <span><span class="investment-class-dot" style="background:#1d7047"></span> Acquisti</span>
                <span><span class="investment-class-dot" style="background:#b34432"></span> Vendite</span>
            }
        </div>
    </div>
    @if (Workspace.Overview.History.Points.Count > 0)
    {
        <div class="investment-chart-controls">
            <div class="overview-ranges" role="group" aria-label="Intervallo del grafico">
                @foreach (var range in ChartRanges)
                {
                    <button type="button"
                            class="overview-range @(IsChartRange(range.Value) ? "active" : "")"
                            aria-pressed="@(IsChartRange(range.Value) ? "true" : "false")"
                            @onclick="() => SetChartRange(range.Value)">@range.Label</button>
                }
                <ChartZoomToggle Active="_zoomEnabled" OnToggle="ToggleZoom" />
            </div>
            <label class="investment-chart-year">
                <span class="visually-hidden">Anno del grafico</span>
                <select value="@(_chartYear?.ToString() ?? "")" @onchange="OnChartYearChanged">
                    <option value="">Tutti gli anni</option>
                    @foreach (var year in HistoryYears)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </label>
        </div>
    }
    @if (ChartPoints.Count >= 2)
    {
        <ApexTimeSeriesChart Title=""
                             Currency="@Workspace.Overview.History.Currency"
                             Series="@BuildHistorySeries(ChartPoints)"
                             RangeSeries="@BuildHistoryRangeSeries(ChartPoints)"
                             PointAnnotations="@OperationAnnotations"
                             XAxisMin="@ChartAxisMin"
                             XAxisMax="@ChartAxisMax"
                             XAxisLabelMode="@ChartAxisLabelMode"
                             EnableSelectionZoom="@_zoomEnabled"
                             HideZoomToolbar="true"
                             ShowMarkers="false"
                             ShowHeader="false"
                             ShowFooter="false"
                             ShowDataTable="false" />
    }
    else
    {
        <p class="page-status">Dati insufficienti per il periodo selezionato.</p>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public InvestmentWorkspace Workspace { get; set; } = default!;

    private const string RangeKey = "mf.chart.performance.range";
    private const string YearKey = "mf.chart.performance.year";

    private ChartRange _chartRange = ChartRange.Max;
    private int? _chartYear;
    private bool _zoomEnabled = true;
    private bool _preferencesLoaded;

    private static readonly (ChartRange Value, string Label)[] ChartRanges =
    [
        (ChartRange.SevenDays, "7G"),
        (ChartRange.OneMonth, "1M"),
        (ChartRange.SixMonths, "6M"),
        (ChartRange.YearToDate, "YTD"),
        (ChartRange.OneYear, "1A"),
        (ChartRange.Max, "Max"),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _preferencesLoaded)
        {
            return;
        }

        _preferencesLoaded = true;

        var range = await Preferences.GetAsync(RangeKey);
        if (Enum.TryParse<ChartRange>(range, out var storedRange))
        {
            _chartRange = storedRange;
        }

        var year = await Preferences.GetAsync(YearKey);
        _chartYear = int.TryParse(year, out var storedYear) ? storedYear : null;

        await InvokeAsync(StateHasChanged);
    }

    private IReadOnlyList<InvestmentHistoryPoint> ChartPoints
    {
        get
        {
            var all = Workspace.Overview.History.Points;
            if (all.Count == 0)
            {
                return all;
            }

            var (from, to) = ChartWindow(Workspace.Overview.ValuationDate);
            if (from is null && to is null)
            {
                return all;
            }

            var points = all
                .Where(point => (from is null || point.Date > from) && (to is null || point.Date <= to))
                .ToList();

            if (from is { } start)
            {
                var last = all.LastOrDefault(point => point.Date <= start);
                if (last is not null)
                {
                    points.Insert(0, new InvestmentHistoryPoint(start, last.InvestedCapital, last.CurrentValue));
                }
            }

            return points;
        }
    }

    private IReadOnlyList<int> HistoryYears =>
        Workspace.Overview.History.Points
            .Select(point => point.Date.Year)
            .Distinct()
            .OrderByDescending(year => year)
            .ToArray();

    private DateTime? ChartAxisMin =>
        ChartWindow(Workspace.Overview.ValuationDate).From?.ToDateTime(TimeOnly.MinValue);

    private DateTime? ChartAxisMax =>
        ChartWindow(Workspace.Overview.ValuationDate).To?.ToDateTime(TimeOnly.MinValue);

    private string ChartAxisLabelMode =>
        _chartYear is not null
            ? "month"
            : _chartRange switch
            {
                ChartRange.SevenDays or ChartRange.OneMonth => "short",
                ChartRange.SixMonths or ChartRange.YearToDate or ChartRange.OneYear => "month",
                _ => "year",
            };

    private bool IsChartRange(ChartRange range) => _chartYear is null && _chartRange == range;

    private void ToggleZoom() => _zoomEnabled = !_zoomEnabled;

    private async Task SetChartRange(ChartRange range)
    {
        _chartRange = range;
        _chartYear = null;
        await Preferences.SetAsync(RangeKey, range.ToString());
        await Preferences.SetAsync(YearKey, "");
    }

    private async Task OnChartYearChanged(ChangeEventArgs args)
    {
        _chartYear = int.TryParse(args.Value?.ToString(), out var year) ? year : null;
        await Preferences.SetAsync(YearKey, _chartYear?.ToString() ?? "");
    }

    private (DateOnly? From, DateOnly? To) ChartWindow(DateOnly valuationDate)
    {
        if (_chartYear is { } year)
        {
            var to = year == valuationDate.Year ? valuationDate : new DateOnly(year, 12, 31);
            return (new DateOnly(year, 1, 1), to);
        }

        return _chartRange switch
        {
            ChartRange.SevenDays => (valuationDate.AddDays(-7), valuationDate),
            ChartRange.OneMonth => (valuationDate.AddMonths(-1), valuationDate),
            ChartRange.SixMonths => (valuationDate.AddMonths(-6), valuationDate),
            ChartRange.YearToDate => (new DateOnly(valuationDate.Year, 1, 1), valuationDate),
            ChartRange.OneYear => (valuationDate.AddYears(-1), valuationDate),
            _ => (null, null),
        };
    }

    private IReadOnlyList<TimeSeriesPointAnnotation> OperationAnnotations
    {
        get
        {
            var points = ChartPoints
                .Where(point => point.CurrentValue is not null)
                .ToArray();
            if (points.Length == 0)
            {
                return [];
            }

            var (from, to) = ChartWindow(Workspace.Overview.ValuationDate);
            var annotations = new List<TimeSeriesPointAnnotation>();

            foreach (var asset in Workspace.Assets)
            {
                var operations = asset.Operations
                    .Where(operation => !operation.IsReversed &&
                                        operation.Kind is InvestmentOperationKind.Buy or InvestmentOperationKind.Sell)
                    .OrderBy(operation => operation.OperationDate)
                    .ThenBy(operation => operation.RecordedAt)
                    .ToArray();
                if (operations.Length == 0)
                {
                    continue;
                }

                var totalBought = operations
                    .Where(operation => operation.Kind == InvestmentOperationKind.Buy)
                    .Sum(operation => operation.Quantity?.Value ?? 0m);
                var realizedByOperation = RealizedResultsByOperation(operations);
                var ticker = string.IsNullOrWhiteSpace(asset.Symbol) ? asset.Name : asset.Symbol;

                foreach (var group in operations
                    .Where(operation =>
                        (from is null || operation.OperationDate >= from.Value) &&
                        (to is null || operation.OperationDate <= to.Value))
                    .GroupBy(operation => (operation.OperationDate, operation.Kind)))
                {
                    var point = points.LastOrDefault(item => item.Date <= group.Key.OperationDate);
                    if (point?.CurrentValue is not { } value)
                    {
                        continue;
                    }

                    var quantity = group.Sum(operation => operation.Quantity?.Value ?? 0m);
                    var gross = group.Sum(operation => operation.GrossAmount?.Amount ?? 0m);
                    var fees = group.Sum(operation => operation.Fees?.Amount ?? 0m);
                    var tax = group.Sum(operation => operation.Tax?.Amount ?? 0m);
                    var quantityText = Format.Quantity(new Quantity(quantity));
                    var isBuy = group.Key.Kind == InvestmentOperationKind.Buy;
                    string tooltip;

                    if (isBuy)
                    {
                        var spent = new Money(gross + fees + tax, Currency.Euro);
                        tooltip = $"{ticker} · Acquisto {quantityText} · Speso {Format.Money(spent)}";
                    }
                    else
                    {
                        var proceeds = new Money(gross - fees - tax, Currency.Euro);
                        var realized = group.Sum(operation => realizedByOperation.GetValueOrDefault(operation.Id));
                        var shareText = totalBought > 0m
                            ? $" ({Format.Percent(quantity / totalBought)} delle azioni acquistate)"
                            : "";
                        tooltip =
                            $"{ticker} · Vendita {quantityText}{shareText} · Incassato {Format.Money(proceeds)} · " +
                            $"Guadagno/perdita {Format.MoneySigned(new Money(realized, Currency.Euro))}";
                    }

                    annotations.Add(new TimeSeriesPointAnnotation(
                        group.Key.OperationDate,
                        value.Amount,
                        isBuy ? "#1d7047" : "#b34432",
                        Tooltip: tooltip));
                }
            }

            return annotations;
        }
    }

    private static Dictionary<Guid, decimal> RealizedResultsByOperation(
        IReadOnlyList<InvestmentOperationRow> operations)
    {
        var results = new Dictionary<Guid, decimal>();
        var quantity = 0m;
        var cost = 0m;

        foreach (var operation in operations)
        {
            var operationQuantity = operation.Quantity?.Value ?? 0m;
            var gross = operation.GrossAmount?.Amount ?? 0m;
            var fees = operation.Fees?.Amount ?? 0m;
            var tax = operation.Tax?.Amount ?? 0m;

            if (operation.Kind == InvestmentOperationKind.Buy)
            {
                quantity += operationQuantity;
                cost += gross + fees + tax;
                continue;
            }

            if (operation.Kind != InvestmentOperationKind.Sell || quantity <= 0m)
            {
                continue;
            }

            var allocatedCost = cost / quantity * operationQuantity;
            results[operation.Id] = gross - fees - tax - allocatedCost;
            quantity -= operationQuantity;
            cost -= allocatedCost;
        }

        return results;
    }

    private IReadOnlyList<TimeSeriesSeries> BuildHistorySeries(
        IReadOnlyList<InvestmentHistoryPoint> points) =>
    [
        new(
            "Valore attuale",
            points
                .Select(point => new TimeSeriesPoint(point.Date, point.CurrentValue?.Amount))
                .ToArray(),
            Color: "#4f5bd5"),
        new(
            "Capitale investito",
            points
                .Select(point => new TimeSeriesPoint(point.Date, point.InvestedCapital?.Amount))
                .ToArray(),
            Color: "#8f9787"),
    ];

    private IReadOnlyList<TimeSeriesRangeSeries> BuildHistoryRangeSeries(
        IReadOnlyList<InvestmentHistoryPoint> points)
    {
        const string green = "#1d7047";
        const string red = "#b34432";

        var values = points
            .Where(point => point.CurrentValue is not null && point.InvestedCapital is not null)
            .Select(point => (
                point.Date,
                Value: point.CurrentValue!.Value.Amount,
                Baseline: point.InvestedCapital!.Value.Amount))
            .ToArray();
        return BuildBandSeries(values, green, red, 0.22);
    }

    private static IReadOnlyList<TimeSeriesRangeSeries> BuildBandSeries(
        IReadOnlyList<(DateOnly Date, decimal Value, decimal Baseline)> samples,
        string positiveColor,
        string negativeColor,
        double opacity)
    {
        if (samples.Count < 2)
        {
            return [];
        }

        var bands = new List<TimeSeriesRangeSeries>();
        var run = new List<TimeSeriesRangePoint>();
        var previous = samples[0];
        run.Add(ToBandPoint(previous));
        var positive = previous.Value > previous.Baseline;

        for (var index = 1; index < samples.Count; index++)
        {
            var sample = samples[index];
            var sign = sample.Value > sample.Baseline;
            if (sign == positive)
            {
                run.Add(ToBandPoint(sample));
                previous = sample;
                continue;
            }

            var first = previous.Value - previous.Baseline;
            var second = sample.Value - sample.Baseline;
            var ratio = first / (first - second);
            var crossingDay = previous.Date.DayNumber +
                              ratio * (sample.Date.DayNumber - previous.Date.DayNumber);
            var crossingDate = DateOnly.FromDayNumber(
                (int)Math.Round(crossingDay, MidpointRounding.AwayFromZero));
            var crossingValue = previous.Value + ratio * (sample.Value - previous.Value);

            if (crossingDate <= previous.Date)
            {
                Flush();
                run.Add(ToBandPoint(previous));
                positive = sign;
                run.Add(ToBandPoint(sample));
            }
            else if (crossingDate >= sample.Date)
            {
                run.Add(ToBandPoint(sample));
                Flush();
                run.Add(ToBandPoint(sample));
                positive = sign;
            }
            else
            {
                var crossing = new TimeSeriesRangePoint(crossingDate, crossingValue, crossingValue);
                run.Add(crossing);
                Flush();
                run.Add(crossing);
                positive = sign;
                run.Add(ToBandPoint(sample));
            }

            previous = sample;
        }

        Flush();
        return bands;

        void Flush()
        {
            if (run.Count >= 2)
            {
                bands.Add(new TimeSeriesRangeSeries(
                    "Area",
                    run.ToArray(),
                    positive ? positiveColor : negativeColor,
                    opacity));
            }

            run.Clear();
        }

        static TimeSeriesRangePoint ToBandPoint(
            (DateOnly Date, decimal Value, decimal Baseline) sample) =>
            new(sample.Date, Math.Max(sample.Value, sample.Baseline), Math.Min(sample.Value, sample.Baseline));
    }

    private enum ChartRange
    {
        SevenDays,
        OneMonth,
        SixMonths,
        YearToDate,
        OneYear,
        Max,
    }
}
