@namespace MiddiFranchi.Web.Components.Shared
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@inject CategoryService CategoriesService

@if (Open)
{
    <div class="modal-backdrop" @onclick="CloseAsync">
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="category-settings-dialog-title"
             @onclick:stopPropagation="true">
            <div class="section-head">
                <div>
                    <h2 id="category-settings-dialog-title">Impostazioni categoria</h2>
                    <p class="section-sub">Categoria, sottocategoria, tipo e descrizione.</p>
                </div>
                <button type="button" class="icon-button" aria-label="Chiudi" disabled="@_saving" @onclick="CloseAsync">
                    <MfIcon Name="close" Size="18" />
                </button>
            </div>

            @if (_error is not null)
            {
                <p class="alert alert-error" role="alert">@_error</p>
            }

            <form class="form-grid" @onsubmit="SaveAsync">
                <label>
                    <span>Categoria *</span>
                    <input type="text" maxlength="200" required aria-required="true" @bind="_name" />
                </label>
                <label>
                    <span>@(IsExpenseType ? "Sottocategoria *" : "Sottocategoria")</span>
                    <input type="text" maxlength="200" aria-required="@AriaRequired(IsExpenseType)" @bind="_subcategory" />
                </label>
                <label>
                    <span>Tipo *</span>
                    <select @bind="_type" required aria-required="true">
                        <option value="@nameof(CategoryType.Income)">Entrate</option>
                        <option value="@nameof(CategoryType.Expense)">Uscite</option>
                    </select>
                </label>
                <label>
                    <span>Descrizione</span>
                    <input type="text" maxlength="200" @bind="_description" />
                </label>
                <label>
                    <span>Icona</span>
                    <select @bind="_icon">
                        @foreach (var option in CategoryAppearance.Icons)
                        {
                            <option value="@option.Name">@option.Label</option>
                        }
                    </select>
                </label>
                <div class="color-picker-field">
                    <span>Colore</span>
                    <ColorPicker @bind-Value="_color" Label="Colore della categoria" />
                </div>
                <div class="form-actions">
                    <button type="submit" class="primary-button" disabled="@_saving">Salva impostazioni</button>
                    <button type="button" class="secondary-button" disabled="@_saving" @onclick="CloseAsync">Annulla</button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }

    [Parameter, EditorRequired] public Guid CategoryId { get; set; }

    [Parameter] public string Name { get; set; } = "";

    [Parameter] public string? Subcategory { get; set; }

    [Parameter] public CategoryType Type { get; set; }

    [Parameter] public string? Description { get; set; }

    [Parameter] public string? Icon { get; set; }

    [Parameter] public string? ColorHex { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback<Category> OnSaved { get; set; }

    private bool _wasOpen;
    private bool _saving;
    private string? _error;
    private string _name = "";
    private string _subcategory = "";
    private string _type = nameof(CategoryType.Income);
    private string? _description;
    private string _icon = CategoryAppearance.DefaultIcon;
    private string _color = CategoryAppearance.DefaultColor;

    private bool IsExpenseType => _type == nameof(CategoryType.Expense);

    private static string AriaRequired(bool value) => value ? "true" : "false";

    protected override void OnParametersSet()
    {
        if (!Open)
        {
            _wasOpen = false;
            return;
        }

        if (_wasOpen)
        {
            return;
        }

        _wasOpen = true;
        _saving = false;
        _error = null;
        _name = Name;
        _subcategory = Subcategory ?? "";
        _type = Type.ToString();
        _description = Description;
        _icon = CategoryAppearance.IconFor(Icon);
        _color = CategoryAppearance.ColorFor(ColorHex);
    }

    private async Task CloseAsync()
    {
        if (_saving)
        {
            return;
        }

        await OnClose.InvokeAsync();
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _error = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "La categoria è obbligatoria.";
            return;
        }

        var type = Enum.Parse<CategoryType>(_type);
        if (type == CategoryType.Expense && string.IsNullOrWhiteSpace(_subcategory))
        {
            _error = "La sottocategoria è obbligatoria per le uscite.";
            return;
        }

        _saving = true;
        try
        {
            var updated = await CategoriesService.UpdateAsync(
                CategoryId,
                new NewCategory(
                    _name.Trim(),
                    type,
                    string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                    string.IsNullOrWhiteSpace(_subcategory) ? null : _subcategory.Trim(),
                    _icon,
                    _color));
            await OnSaved.InvokeAsync(updated);
            await OnClose.InvokeAsync();
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (Exception)
        {
            _error = "Salvataggio non riuscito: verificare la connessione al database e riprovare.";
        }
        finally
        {
            _saving = false;
        }
    }
}
