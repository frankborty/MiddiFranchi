@namespace MiddiFranchi.Web.Components.Shared
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@using MiddiFranchi.Domain.Shared
@inject OperationRegistrationService Registrations
@inject InvestmentIncomeService InvestmentIncome

@if (Open)
{
    <div class="modal-backdrop" @onclick="CloseAsync">
        <div class="modal-card operation-dialog" role="dialog" aria-modal="true" aria-labelledby="operation-dialog-title"
             @onclick:stopPropagation="true">
            <div class="section-head">
                <div>
                    <h2 id="operation-dialog-title">Nuova operazione</h2>
                    <p class="section-sub">Registra un'entrata o un'uscita.</p>
                </div>
                <button type="button" class="icon-button" aria-label="Chiudi" disabled="@_saving" @onclick="CloseAsync">
                    <MfIcon Name="close" Size="18" />
                </button>
            </div>

            <div class="operation-kind-tabs two" role="group" aria-label="Tipo di operazione">
                <button type="button" class="@KindTabClass(OperationFormKind.Expense)" aria-pressed="@AriaPressed(_kind == OperationFormKind.Expense)" @onclick="() => SelectKind(OperationFormKind.Expense)">
                    <MfIcon Name="trend-down" Size="16" /> Uscita
                </button>
                <button type="button" class="@KindTabClass(OperationFormKind.Income)" aria-pressed="@AriaPressed(_kind == OperationFormKind.Income)" @onclick="() => SelectKind(OperationFormKind.Income)">
                    <MfIcon Name="trend" Size="16" /> Entrata
                </button>
            </div>

            @if (_error is not null)
            {
                <p class="alert alert-error" role="alert">@_error</p>
            }

            <form class="form-grid operation-form" @onsubmit="SaveAsync">
                @if (_kind == OperationFormKind.Income)
                {
                    <label class="operation-form-wide">
                        <span>Tipo di entrata *</span>
                        <select @bind="_incomeType" @bind:after="OnIncomeTypeChanged">
                            <option value="general">Entrata</option>
                            <option value="coupon">Cedola</option>
                        </select>
                    </label>

                    @if (IsCouponDividend)
                    {
                        <label class="operation-form-wide">
                            <span>Strumento finanziario *</span>
                            <select @bind="_instrumentId" required aria-required="true">
                                <option value="">Seleziona…</option>
                                @foreach (var instrument in Instruments)
                                {
                                    <option value="@instrument.Id">@instrument.Name</option>
                                }
                            </select>
                        </label>
                    }
                    else
                    {
                        <label class="operation-form-wide">
                            <span>Categoria *</span>
                            <select @bind="_categoryId" required aria-required="true">
                                <option value="">Seleziona…</option>
                                @foreach (var category in IncomeCategories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </label>
                    }
                }
                else
                {
                    <label>
                        <span>Categoria</span>
                        <select @bind="_categoryName" @bind:after="OnCategoryGroupChanged">
                            <option value="">Tutte le categorie</option>
                            @foreach (var group in ExpenseGroups)
                            {
                                <option value="@group.Name">@group.Name</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span>Sottocategoria *</span>
                        <select @bind="_categoryId" @bind:after="OnSubcategoryChanged" required aria-required="true">
                            <option value="">Seleziona…</option>
                            @foreach (var group in VisibleExpenseGroups)
                            {
                                <optgroup label="@group.Name">
                                    @foreach (var category in group.Categories)
                                    {
                                        <option value="@category.Id">@SubcategoryLabel(category)</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </label>
                }
                <label>
                    <span>@(IsCouponDividend ? "Lordo *" : "Importo *")</span>
                    <input type="text" inputmode="decimal" placeholder="0,00" required aria-required="true" @bind="_amountText" />
                </label>
                @if (IsCouponDividend)
                {
                    <label>
                        <span>Tasse pagate (€)</span>
                        <input type="text" inputmode="decimal" placeholder="0,00" @bind="_taxText" />
                    </label>
                }
                <label>
                    <span>Data *</span>
                    <input type="date" required aria-required="true" @bind="_validAt" />
                </label>
                <label class="operation-form-wide">
                    <span>Descrizione / Nota</span>
                    <input type="text" maxlength="200"
                           placeholder="@(IsCouponDividend ? "Es. Cedola BTP giugno" : "Es. Spesa settimanale")"
                           @bind="_description" />
                </label>

                @if (IsCouponDividend && !HasCouponCategories)
                {
                    <p class="alert alert-warning operation-form-wide" role="status">
                        Mancano le categorie «Cedole &amp; Dividendi» (entrata) e «Fees · Tasse Investimenti» (uscita).
                        <a class="primary-link" href="settings/categories">Configura le categorie</a>.
                    </p>
                }
                @if (IsCouponDividend && Instruments.Count == 0)
                {
                    <p class="alert alert-warning operation-form-wide" role="status">
                        Non ci sono strumenti finanziari attivi.
                        <a class="primary-link" href="investments">Aggiungi uno strumento</a>.
                    </p>
                }

                <div class="form-actions">
                    <button type="submit" class="primary-button" disabled="@(_saving || !CanRegister)">
                        <MfIcon Name="plus" Size="18" />
                        Registra @(IsCouponDividend ? "cedola" : (_kind == OperationFormKind.Income ? "entrata" : "uscita"))
                    </button>
                    <button type="button" class="secondary-button" disabled="@_saving" @onclick="CloseAsync">Annulla</button>
                </div>
            </form>

            @if (CategoryChoices.Count == 0)
            {
                <p class="alert alert-warning" role="status">
                    @(_kind == OperationFormKind.Income
                        ? "Non ci sono categorie di tipo Entrate: la registrazione di un'entrata ne richiede una."
                        : "Non ci sono categorie di tipo Uscite: la registrazione di un'uscita ne richiede una.")
                    <a class="primary-link" href="settings">Crea una categoria nella pagina Configurazione.</a>
                </p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }

    [Parameter] public IReadOnlyList<Category> Categories { get; set; } = [];

    [Parameter] public IReadOnlyList<InvestmentOption> Instruments { get; set; } = [];

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback<string> OnSaved { get; set; }

    private bool _wasOpen;
    private bool _saving;
    private string? _error;
    private OperationFormKind _kind = OperationFormKind.Expense;
    private string _categoryId = "";
    private string _categoryName = "";
    private bool _filterByCategory;
    private string _amountText = "";
    private string _taxText = "";
    private string _incomeType = "general";
    private string _instrumentId = "";
    private DateOnly? _validAt;
    private string? _description;

    private bool IsCouponDividend =>
        _kind == OperationFormKind.Income &&
        string.Equals(_incomeType, "coupon", StringComparison.Ordinal);

    private Category? CouponIncomeCategory => Categories.FirstOrDefault(category =>
        category.Type == CategoryType.Income &&
        string.Equals(category.Name, "Cedole", StringComparison.CurrentCultureIgnoreCase));

    private Category? TaxExpenseCategory => Categories.FirstOrDefault(category =>
        category.Type == CategoryType.Expense &&
        string.Equals(category.Name, "Fees", StringComparison.CurrentCultureIgnoreCase) &&
        string.Equals(category.Subcategory, "Tasse Investimenti", StringComparison.CurrentCultureIgnoreCase));

    private bool HasCouponCategories =>
        CouponIncomeCategory is not null && TaxExpenseCategory is not null;

    private IReadOnlyList<Category> CategoryChoices => OperationForm.CategoriesFor(_kind, Categories);

    private IReadOnlyList<Category> IncomeCategories => CategoryChoices
        .OrderBy(category => category.Name, StringComparer.CurrentCultureIgnoreCase)
        .ToArray();

    private IReadOnlyList<CategoryGroup> ExpenseGroups => OperationForm.GroupCategories(CategoryChoices);

    private IReadOnlyList<CategoryGroup> VisibleExpenseGroups =>
        !_filterByCategory || string.IsNullOrWhiteSpace(_categoryName)
            ? ExpenseGroups
            : ExpenseGroups
                .Where(group => string.Equals(group.Name, _categoryName, StringComparison.CurrentCultureIgnoreCase))
                .ToArray();

    private bool CanRegister => IsCouponDividend
        ? Instruments.Count > 0 &&
          !string.IsNullOrWhiteSpace(_instrumentId) &&
          HasCouponCategories
        : CategoryChoices.Count > 0 && !string.IsNullOrWhiteSpace(_categoryId);

    protected override void OnParametersSet()
    {
        if (!Open)
        {
            _wasOpen = false;
            return;
        }

        if (_wasOpen)
        {
            return;
        }

        _wasOpen = true;
        _saving = false;
        _error = null;
        _kind = OperationFormKind.Expense;
        _categoryId = "";
        _categoryName = "";
        _filterByCategory = false;
        _amountText = "";
        _taxText = "";
        _incomeType = "general";
        _instrumentId = "";
        _validAt = DateOnly.FromDateTime(DateTime.UtcNow);
        _description = null;
    }

    private void SelectKind(OperationFormKind kind)
    {
        if (_kind == kind)
        {
            return;
        }

        _kind = kind;
        _categoryId = "";
        _categoryName = "";
        _filterByCategory = false;
        _incomeType = "general";
        _instrumentId = "";
        _taxText = "";
        _error = null;
    }

    private void OnIncomeTypeChanged()
    {
        _categoryId = "";
        _instrumentId = "";
        _taxText = "";
        _error = null;
    }

    private void OnCategoryGroupChanged()
    {
        _filterByCategory = !string.IsNullOrWhiteSpace(_categoryName);
        if (string.IsNullOrWhiteSpace(_categoryName))
        {
            _categoryId = "";
            return;
        }

        var selected = CategoryChoices.FirstOrDefault(category => category.Id.ToString() == _categoryId);
        if (selected is null ||
            !string.Equals(selected.Name, _categoryName, StringComparison.CurrentCultureIgnoreCase))
        {
            _categoryId = "";
        }
    }

    private void OnSubcategoryChanged()
    {
        if (!Guid.TryParse(_categoryId, out var id))
        {
            return;
        }

        var selected = CategoryChoices.FirstOrDefault(category => category.Id == id);
        if (selected is not null)
        {
            _categoryName = selected.Name;
        }
    }

    private async Task SaveAsync()
    {
        if (_saving || !CanRegister)
        {
            return;
        }

        _saving = true;
        _error = null;
        StateHasChanged();

        if (IsCouponDividend)
        {
            await SaveCouponDividendAsync();
            return;
        }

        try
        {
            var dispatcher = new OperationFormDispatcher(Registrations);
            var result = await dispatcher.SubmitAsync(
                new OperationFormModel
                {
                    Kind = _kind,
                    CategoryId = ParseOptionalGuid(_categoryId),
                    SourceAmountText = _amountText,
                    ValidAt = _validAt,
                    Description = string.IsNullOrWhiteSpace(_description) ? null : _description,
                });

            if (result.Succeeded)
            {
                await OnSaved.InvokeAsync(result.SuccessMessage);
                await OnClose.InvokeAsync();
            }
            else
            {
                _error = result.Error;
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveCouponDividendAsync()
    {
        try
        {
            if (CouponIncomeCategory is not { } incomeCategory ||
                TaxExpenseCategory is not { } taxCategory)
            {
                _error = "Mancano le categorie «Cedole» e «Fees · Tasse Investimenti».";
                return;
            }

            if (!Guid.TryParse(_instrumentId, out var instrumentId))
            {
                _error = "Seleziona lo strumento finanziario.";
                return;
            }

            if (!DecimalText.TryParse(_amountText, out var gross) || gross <= 0m)
            {
                _error = "Il lordo deve essere un importo positivo.";
                return;
            }

            if (_validAt is null)
            {
                _error = "La data è obbligatoria.";
                return;
            }

            PositiveMoney? tax = null;
            if (!string.IsNullOrWhiteSpace(_taxText))
            {
                if (!DecimalText.TryParse(_taxText, out var taxAmount) || taxAmount < 0m)
                {
                    _error = "Le tasse devono essere un importo non negativo.";
                    return;
                }

                if (taxAmount > 0m)
                {
                    tax = new PositiveMoney(new Money(taxAmount, Currency.Euro));
                }
            }

            var result = await InvestmentIncome.RegisterAsync(
                new RegisterInvestmentIncomeRequest(
                    instrumentId,
                    incomeCategory.Id,
                    taxCategory.Id,
                    new PositiveMoney(new Money(gross, Currency.Euro)),
                    tax,
                    _validAt.Value,
                    string.IsNullOrWhiteSpace(_description) ? null : _description));

            var message = $"Cedola di {Format.Money(result.Income.Amount.Value)} registrata.";
            if (result.TaxExpense is { } taxExpense)
            {
                message += $" Tasse: {Format.Money(taxExpense.Amount.Value)}.";
            }

            await OnSaved.InvokeAsync(message);
            await OnClose.InvokeAsync();
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (Exception)
        {
            _error = "Registrazione non riuscita: verificare la connessione al database e riprovare.";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CloseAsync()
    {
        if (_saving)
        {
            return;
        }

        await OnClose.InvokeAsync();
    }

    private static string SubcategoryLabel(Category category) =>
        string.IsNullOrWhiteSpace(category.Subcategory) ? "Generale" : category.Subcategory;

    private string KindTabClass(OperationFormKind kind)
    {
        var tone = kind == OperationFormKind.Income ? "income" : "expense";
        return _kind == kind
            ? $"operation-kind-tab {tone} active"
            : $"operation-kind-tab {tone}";
    }

    private static string AriaPressed(bool value) => value ? "true" : "false";

    private static Guid? ParseOptionalGuid(string value) =>
        Guid.TryParse(value, out var parsed) ? parsed : null;
}
