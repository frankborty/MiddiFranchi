@namespace MiddiFranchi.Web.Components.Shared
@using System.Globalization
@using MiddiFranchi.Application.Financial
@using MiddiFranchi.Domain.Financial
@using MiddiFranchi.Domain.Shared
@inject LoanService LoansService

@if (Open)
{
    <div class="modal-backdrop" @onclick="CloseAsync">
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="loan-repayment-dialog-title"
             @onclick:stopPropagation="true">
            <div class="section-head">
                <div>
                    <h2 id="loan-repayment-dialog-title">Registra restituzione</h2>
                    <p class="section-sub">
                        <MfIcon Name="loan" Size="16" /> Prestito di @Borrower
                    </p>
                </div>
                <button type="button" class="icon-button" aria-label="Chiudi" disabled="@_saving" @onclick="CloseAsync">
                    <MfIcon Name="close" Size="18" />
                </button>
            </div>

            @if (_error is not null)
            {
                <p class="alert alert-error" role="alert">@_error</p>
            }

            <form class="form-grid" @onsubmit="SaveAsync">
                <div class="loan-repayment-summary">
                    <div>
                        <span>Dovuto alla data</span>
                        <strong>@OutstandingText</strong>
                    </div>
                    <div>
                        <span>Nuovo importo dovuto</span>
                        <strong>@RemainingText</strong>
                    </div>
                </div>

                <label>
                    <span>Importo restituito in EUR *</span>
                    <input type="text" inputmode="decimal" required aria-required="true" autofocus
                           @bind="_amount" @bind:event="oninput" />
                </label>
                <label>
                    <span>Data *</span>
                    <input type="date" required aria-required="true" @bind="_validAt" @bind:event="oninput" />
                </label>
                <label class="loan-repayment-note">
                    <span>Nota (facoltativa)</span>
                    <textarea maxlength="500" @bind="_note"></textarea>
                </label>
                <div class="form-actions">
                    <button type="submit" class="primary-button" disabled="@_saving">
                        <MfIcon Name="cash" Size="18" /> Registra restituzione
                    </button>
                    <button type="button" class="secondary-button" disabled="@_saving" @onclick="CloseAsync">Annulla</button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }

    [Parameter, EditorRequired] public Guid LoanId { get; set; }

    [Parameter] public string Borrower { get; set; } = "";

    [Parameter] public Currency Currency { get; set; }

    [Parameter] public IReadOnlyList<LoanReading> Readings { get; set; } = [];

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback<LoanReading> OnSaved { get; set; }

    private bool _wasOpen;
    private bool _saving;
    private string? _error;
    private string _amount = "";
    private string _note = "";
    private DateOnly? _validAt;

    private DateOnly EffectiveDate => _validAt ?? DateOnly.FromDateTime(DateTime.UtcNow);

    private decimal? Outstanding =>
        LoanReadings.LatestOnOrBefore(Readings, LoanId, EffectiveDate)?.Amount.Amount;

    private string OutstandingText =>
        Outstanding is { } amount ? Format.Money(new Money(amount, Currency)) : "Nessuna rilevazione";

    private string RemainingText
    {
        get
        {
            if (Outstanding is not { } outstanding)
            {
                return "—";
            }

            if (!TryParseAmount(_amount, out var amount) || amount <= 0m)
            {
                return "—";
            }

            return amount > outstanding
                ? "Importo superiore al dovuto"
                : Format.Money(new Money(outstanding - amount, Currency));
        }
    }

    protected override void OnParametersSet()
    {
        if (!Open)
        {
            _wasOpen = false;
            return;
        }

        if (_wasOpen)
        {
            return;
        }

        _wasOpen = true;
        _saving = false;
        _error = null;
        _amount = "";
        _note = "";
        _validAt = DateOnly.FromDateTime(DateTime.UtcNow);
    }

    private async Task CloseAsync()
    {
        if (_saving)
        {
            return;
        }

        await OnClose.InvokeAsync();
    }

    private async Task SaveAsync()
    {
        if (_saving)
        {
            return;
        }

        _error = null;

        if (!TryParseAmount(_amount, out var amount) || amount <= 0m)
        {
            _error = "L'importo restituito è obbligatorio e deve essere un numero positivo.";
            return;
        }

        if (_validAt is null)
        {
            _error = "La data della restituzione è obbligatoria.";
            return;
        }

        if (Outstanding is not { } outstanding)
        {
            _error = "Non ci sono rilevazioni del prestito alla data indicata.";
            return;
        }

        if (amount > outstanding)
        {
            _error = "L'importo restituito supera quello ancora dovuto alla data indicata.";
            return;
        }

        _saving = true;
        try
        {
            var reading = await LoansService.RegisterRepaymentAsync(
                LoanId,
                new Money(amount, Currency),
                _validAt.Value,
                _note);
            await OnSaved.InvokeAsync(reading);
            await OnClose.InvokeAsync();
        }
        catch (ArgumentException exception)
        {
            _error = exception.Message;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
        catch (Exception)
        {
            _error = "Registrazione non riuscita: verificare la connessione al database e riprovare.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static bool TryParseAmount(string text, out decimal amount) =>
        DecimalText.TryParse(text, out amount);
}
