<!DOCTYPE html>
<html lang="it">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,700;12..96,800&family=Onest:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["redesign.css"]" />
    <link rel="stylesheet" href="@Assets["MiddiFranchi.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
    <script>
        window.mfResolveTheme = function () {
            var stored = null;
            try { stored = localStorage.getItem("mf-theme"); } catch (e) { }
            if (stored === "light" || stored === "dark") { return stored; }
            return window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        };
        window.mfApplyTheme = function () {
            document.documentElement.setAttribute("data-theme", window.mfResolveTheme());
        };
        window.mfApplyTheme();
        /* La navigazione enhanced ricostruisce il layout: riapplichiamo tema e stato della sidebar. */
        window.mfReapplyClientState = function () {
            window.mfApplyTheme();
            window.mfRestoreNavCollapsed();
            window.mfResetPageScroll();
            window.dispatchEvent(new CustomEvent("mf-theme-changed", { detail: window.mfResolveTheme() }));
        };

        window.mfResetPageScroll = function () {
            var body = document.querySelector(".page-body");
            if (body) body.scrollTop = 0;
        };
        window.mfGetTheme = function () {
            var theme = document.documentElement.getAttribute("data-theme");
            return theme === "light" || theme === "dark" ? theme : window.mfResolveTheme();
        };
        window.mfThemeListeners = window.mfThemeListeners || [];
        window.mfRegisterThemeListener = function (id, dotNetRef) {
            var listener = function (e) {
                dotNetRef.invokeMethodAsync("OnThemeChanged", e.detail);
            };
            window.mfThemeListeners.push({ id: id, listener: listener });
            window.addEventListener("mf-theme-changed", listener);
        };
        window.mfUnregisterThemeListener = function (id) {
            for (var i = window.mfThemeListeners.length - 1; i >= 0; i--) {
                var item = window.mfThemeListeners[i];
                if (item.id === id) {
                    window.removeEventListener("mf-theme-changed", item.listener);
                    window.mfThemeListeners.splice(i, 1);
                }
            }
        };

        /* Aggiunge il tooltip nativo ai marker delle annotazioni Apex. */
        window.mfBindPointAnnotationTitles = function (root, titles) {
            if (!root || !titles) return;

            function bind() {
                var tooltip = root.querySelector('.chart-annotation-tooltip');
                var markers = root.querySelectorAll('.apexcharts-point-annotations > path, .apexcharts-point-annotations > circle');

                markers.forEach(function (marker, index) {
                    var text = titles[index];
                    if (!text) return;

                    marker.style.cursor = 'pointer';

                    function position(event) {
                        if (!tooltip) return;
                        var rect = root.getBoundingClientRect();
                        var left = event.clientX - rect.left + 12;
                        var top = event.clientY - rect.top + 12;
                        if (left + tooltip.offsetWidth > root.clientWidth - 8) {
                            left = event.clientX - rect.left - tooltip.offsetWidth - 12;
                        }
                        if (top + tooltip.offsetHeight > root.clientHeight - 8) {
                            top = event.clientY - rect.top - tooltip.offsetHeight - 12;
                        }
                        tooltip.style.left = Math.max(8, left) + 'px';
                        tooltip.style.top = Math.max(8, top) + 'px';
                    }

                    marker.onmouseenter = function (event) {
                        if (!tooltip) return;
                        root.classList.add('annotation-tooltip-active');
                        tooltip.textContent = text;
                        tooltip.hidden = false;
                        position(event);
                    };
                    marker.onmousemove = position;
                    marker.onmouseleave = function () {
                        root.classList.remove('annotation-tooltip-active');
                        if (tooltip) tooltip.hidden = true;
                    };
                });
            }

            bind();
            setTimeout(bind, 80);
            setTimeout(bind, 300);
            setTimeout(bind, 900);
        };

        /* Converte una data locale (senza fuso) nel timestamp usato dall'asse datetime. */
        window.mfToTimestamp = function (iso) {
            if (!iso) return null;
            var date = new Date(iso);
            return isNaN(date.getTime()) ? null : date.getTime();
        };

        /* Formatta un istante nel fuso orario del browser (es. ultimo aggiornamento quotazione). */
        window.mfFormatLocalDateTime = function (iso) {
            if (!iso) return "";
            var date = new Date(iso);
            if (isNaN(date.getTime())) return "";
            return new Intl.DateTimeFormat("it-IT", {
                day: "2-digit",
                month: "2-digit",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit"
            }).format(date).replace(",", "");
        };

        /* Fuso orario IANA del browser, usato per pianificare gli aggiornamenti prezzi. */
        window.mfGetTimeZone = function () {
            try {
                return Intl.DateTimeFormat().resolvedOptions().timeZone || "";
            } catch (e) {
                return "";
            }
        };

        /* Modalità etichette asse temporale: short dd MMM, hour HH:mm, day, month MMM yy, month-name MMM, year. */
        window.mfSetAxisLabelMode = function (mode) {
            window.mfAxisLabelMode =
                mode === "hour" || mode === "day" || mode === "month" || mode === "month-name" || mode === "year"
                    ? mode
                    : "short";
        };
        window.mfSetAxisLabelMode("short");

        /* Su schermi stretti tiene visibile il mese selezionato nella barra del periodo. */
        window.mfScrollActiveMonth = function (container) {
            if (!container) return;
            var active = container.querySelector(".period-month.active");
            if (!active || container.scrollWidth <= container.clientWidth + 1) return;

            var containerRect = container.getBoundingClientRect();
            var activeRect = active.getBoundingClientRect();
            if (activeRect.left >= containerRect.left && activeRect.right <= containerRect.right) return;

            var target = container.scrollLeft + (activeRect.left - containerRect.left) -
                (container.clientWidth - activeRect.width) / 2;
            container.scrollTo({ left: Math.max(0, target), behavior: "auto" });
        };

        /* Sidebar comprimibile (solo icone) con persistenza su localStorage. */
        window.mfToggleNavCollapsed = function () {
            var page = document.getElementById("mf-page");
            if (!page) return;
            var collapsed = page.classList.toggle("nav-collapsed");
            try { localStorage.setItem("mf-sidebar-collapsed", collapsed ? "1" : "0"); } catch (e) { }
        };
        window.mfRestoreNavCollapsed = function () {
            try {
                if (localStorage.getItem("mf-sidebar-collapsed") === "0") {
                    var page = document.getElementById("mf-page");
                    if (page) page.classList.remove("nav-collapsed");
                }
            } catch (e) { }
        };

        /* Preferenze dell'interfaccia persistenti (localStorage). */
        window.mfGetPreference = function (key) {
            try { return localStorage.getItem(key); } catch (e) { return null; }
        };
        window.mfSetPreference = function (key, value) {
            try {
                if (value === null || value === undefined) {
                    localStorage.removeItem(key);
                } else {
                    localStorage.setItem(key, String(value));
                }
            } catch (e) { }
        };

        /* Notifiche temporanee: scompaiono da sole oppure si chiudono con il pulsante. */
        window.mfToast = function (message, tone) {
            var host = document.getElementById("mf-toast-host");
            if (!host || !message) return;

            var kind = tone === "success" || tone === "error" || tone === "warning" ? tone : "info";
            var toast = document.createElement("div");
            toast.className = "toast toast-" + kind;
            toast.setAttribute("role", kind === "error" ? "alert" : "status");

            var text = document.createElement("span");
            text.className = "toast-text";
            text.textContent = message;

            var close = document.createElement("button");
            close.type = "button";
            close.className = "toast-close";
            close.setAttribute("aria-label", "Chiudi notifica");
            close.textContent = "×";

            var dismissed = false;
            function dismiss() {
                if (dismissed) return;
                dismissed = true;
                toast.classList.add("toast-leaving");
                setTimeout(function () { toast.remove(); }, 180);
            }

            close.addEventListener("click", dismiss);
            toast.appendChild(text);
            toast.appendChild(close);
            host.appendChild(toast);
            setTimeout(dismiss, kind === "error" ? 9000 : 5000);
        };

        /* Sidebar mobile + focus back button. */
        window.mfToggleNav = function () {
            var page = document.getElementById("mf-page");
            if (!page) return;
            var open = !page.classList.contains("nav-open");
            page.classList.toggle("nav-open", open);
            var trigger = document.querySelector(".menu-toggle");
            if (trigger) {
                trigger.setAttribute("aria-expanded", open ? "true" : "false");
                trigger.setAttribute("aria-label", open ? "Chiudi il menu di navigazione" : "Apri il menu di navigazione");
            }
            if (open) {
                var first = document.querySelector(".app-sidebar .sidebar-nav a");
                if (first) first.focus({ preventScroll: true });
            } else if (trigger) {
                trigger.focus();
            }
        };
        window.mfCloseNav = function () {
            var page = document.getElementById("mf-page");
            if (!page || !page.classList.contains("nav-open")) return;
            page.classList.remove("nav-open");
            var trigger = document.querySelector(".menu-toggle");
            if (trigger) {
                trigger.setAttribute("aria-expanded", "false");
                trigger.setAttribute("aria-label", "Apri il menu di navigazione");
                trigger.focus();
            }
        };

        /* Scarica un flusso .NET come file locale. */
        window.mfDownloadFile = async function (fileName, contentStreamReference) {
            const arrayBuffer = await contentStreamReference.arrayBuffer();
            const blob = new Blob([arrayBuffer], { type: "application/octet-stream" });
            const url = URL.createObjectURL(blob);
            const anchor = document.createElement("a");
            anchor.href = url;
            anchor.download = fileName;
            document.body.appendChild(anchor);
            anchor.click();
            /* La revoca immediata può annullare il download: aspettiamo che il browser legga il blob. */
            setTimeout(function () {
                anchor.remove();
                URL.revokeObjectURL(url);
            }, 1000);
        };
        document.addEventListener("click", function (e) {
            if (e.target.closest && e.target.closest(".app-sidebar a")) {
                mfCloseNav();
            }
        });
        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") mfCloseNav();
        });

        /* Pull-to-refresh su mobile: trascina verso il basso dalla cima della pagina. */
        (function () {
            if (window.mfPullRefreshBound) return;
            window.mfPullRefreshBound = true;

            var indicator = null;
            var label = null;
            var startX = 0;
            var startY = 0;
            var active = false;
            var pulling = false;
            var distance = 0;
            var threshold = 72;
            var maxDistance = 110;

            function isMobile() {
                return window.matchMedia("(max-width: 820px)").matches;
            }

            function hasDialog() {
                return !!document.querySelector(".modal-backdrop, [role='dialog'], dialog[open]");
            }

            function blockedTarget(target) {
                if (!target || !target.closest) return true;
                return !!target.closest(
                    "input, textarea, select, button, a, .app-topbar, .app-bottomnav, " +
                    ".library-chart, .apexcharts-canvas, .table-scroll, .overview-ranges, .overview-tabs");
            }

            function ensureIndicator() {
                if (indicator) return;
                indicator = document.createElement("div");
                indicator.className = "mf-pull-indicator";
                indicator.setAttribute("aria-hidden", "true");
                var spinner = document.createElement("span");
                spinner.className = "mf-pull-spinner";
                label = document.createElement("span");
                label.className = "mf-pull-label";
                indicator.appendChild(spinner);
                indicator.appendChild(label);
                document.body.appendChild(indicator);
            }

            function reset() {
                active = false;
                pulling = false;
                distance = 0;
                if (indicator) {
                    indicator.classList.remove("visible", "ready", "releasing");
                    indicator.style.removeProperty("--mf-pull-progress");
                }
            }

            function update(dy) {
                ensureIndicator();
                distance = Math.min(maxDistance, dy);
                var progress = Math.min(1, distance / threshold);
                indicator.style.setProperty("--mf-pull-progress", progress.toFixed(3));
                indicator.classList.toggle("visible", distance > 4);
                indicator.classList.toggle("ready", distance >= threshold);
                label.textContent = distance >= threshold
                    ? "Rilascia per aggiornare"
                    : "Trascina per aggiornare";
            }

            document.addEventListener("touchstart", function (e) {
                if (!isMobile() || e.touches.length !== 1 || hasDialog()) { active = false; return; }
                var body = e.target && e.target.closest ? e.target.closest(".page-body") : null;
                if (!body || body.scrollTop > 0 || blockedTarget(e.target)) { active = false; return; }
                startX = e.touches[0].clientX;
                startY = e.touches[0].clientY;
                active = true;
                pulling = false;
                distance = 0;
            }, { passive: true });

            document.addEventListener("touchmove", function (e) {
                if (!active || e.touches.length !== 1) return;
                var dx = e.touches[0].clientX - startX;
                var dy = e.touches[0].clientY - startY;
                if (!pulling) {
                    if (dy < 0 || Math.abs(dx) > Math.abs(dy)) { active = false; return; }
                    if (dy < 6) return;
                    pulling = true;
                }
                var body = e.target && e.target.closest ? e.target.closest(".page-body") : null;
                if (!body || body.scrollTop > 0) { reset(); return; }
                if (e.cancelable) e.preventDefault();
                update(dy);
            }, { passive: false });

            document.addEventListener("touchend", function () {
                if (!active) return;
                if (pulling && distance >= threshold) {
                    ensureIndicator();
                    indicator.classList.add("releasing", "visible");
                    indicator.classList.remove("ready");
                    label.textContent = "Aggiornamento…";
                    window.setTimeout(function () { window.location.reload(); }, 220);
                } else {
                    reset();
                }
                active = false;
                pulling = false;
                distance = 0;
            }, { passive: true });

            document.addEventListener("touchcancel", reset, { passive: true });
        })();
    </script>
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>
        window.mfRestoreNavCollapsed();
        if (window.Blazor && window.Blazor.addEventListener) {
            window.Blazor.addEventListener("enhancedload", window.mfReapplyClientState);
        }
    </script>
</body>

</html>
