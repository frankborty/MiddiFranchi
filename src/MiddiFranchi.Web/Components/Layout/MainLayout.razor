@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using MiddiFranchi.Web.Components.Shared
@inject NavigationManager Navigation
@inject SectionAppearanceService Appearance

<div class="page app-shell" id="mf-page" style="@PageStyle">
    <header class="app-topbar">
        <a class="app-brand" href="" aria-label="MiddiFranchi, vai alla dashboard">
            <span class="app-brand-mark" aria-hidden="true"><MfIcon Name="coin" Size="18" /></span>
            <span class="app-brand-name">MiddiFranchi</span>
        </a>

        <nav class="app-topnav" aria-label="Navigazione principale">
            <NavLink href="" class="topnav-link nav-home" Match="NavLinkMatch.All">
                <MfIcon Name="@Appearance.Get(AppSection.Dashboard).Icon" Size="17" />
                <span>Dashboard</span>
            </NavLink>
            <NavLink href="accounts" class="topnav-link nav-accounts" Match="NavLinkMatch.Prefix">
                <MfIcon Name="@Appearance.Get(AppSection.Accounts).Icon" Size="17" />
                <span>Conti</span>
            </NavLink>
            <NavLink href="investments" class="topnav-link nav-investments" Match="NavLinkMatch.Prefix">
                <MfIcon Name="@Appearance.Get(AppSection.Investments).Icon" Size="17" />
                <span>Investimenti</span>
            </NavLink>
            <NavLink href="operations" class="topnav-link nav-operations" Match="NavLinkMatch.All">
                <MfIcon Name="@Appearance.Get(AppSection.Operations).Icon" Size="17" />
                <span>Movimenti</span>
            </NavLink>
        </nav>

        <div class="app-topbar-actions">
            <NavLink href="settings" class="topbar-icon nav-settings" Match="NavLinkMatch.Prefix"
                     aria-label="Configurazione" title="Configurazione">
                <MfIcon Name="@Appearance.Get(AppSection.Settings).Icon" Size="18" />
            </NavLink>
        </div>
    </header>

    <main class="page-body">
        @Body
    </main>

    <div id="mf-toast-host" class="toast-stack" aria-live="polite" aria-atomic="false"></div>

    @if (!IsAccountsSection && !IsSettingsSection && !IsOperationsSection && !IsInvestmentsSection)
    {
        <a class="fab-add" href="operations?new=1" aria-label="Nuova operazione">
            <MfIcon Name="plus" Size="24" />
        </a>
    }

    <nav class="app-bottomnav" aria-label="Navigazione mobile">
        <NavLink href="" class="bottomnav-link nav-home" Match="NavLinkMatch.All">
            <MfIcon Name="@Appearance.Get(AppSection.Dashboard).Icon" Size="20" />
            <span>Dashboard</span>
        </NavLink>
        <NavLink href="accounts" class="bottomnav-link nav-accounts" Match="NavLinkMatch.Prefix">
            <MfIcon Name="@Appearance.Get(AppSection.Accounts).Icon" Size="20" />
            <span>Conti</span>
        </NavLink>
        <NavLink href="investments" class="bottomnav-link nav-investments" Match="NavLinkMatch.Prefix">
            <MfIcon Name="@Appearance.Get(AppSection.Investments).Icon" Size="20" />
            <span>Investimenti</span>
        </NavLink>
        <NavLink href="operations" class="bottomnav-link nav-operations" Match="NavLinkMatch.All">
            <MfIcon Name="@Appearance.Get(AppSection.Operations).Icon" Size="20" />
            <span>Movimenti</span>
        </NavLink>
    </nav>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Si è verificato un errore imprevisto.
    <a href="." class="reload">Ricarica</a>
    <span class="dismiss" role="button" tabindex="0" aria-label="Nascondi il messaggio di errore">🗙</span>
</div>

@code {
    private bool IsAccountsSection => IsAccountsPath(Navigation.Uri);
    private bool IsSettingsSection => IsSettingsPath(Navigation.Uri);
    private bool IsOperationsSection => IsOperationsPath(Navigation.Uri);
    private bool IsInvestmentsSection => IsInvestmentsPath(Navigation.Uri);

    private string PageStyle => $"{Appearance.CssVariables}--mf-sort-color:{SortColor};";

    private string SortColor
    {
        get
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
            if (path.StartsWith("/settings/instruments", StringComparison.OrdinalIgnoreCase) ||
                path.StartsWith("/settings/price-updates", StringComparison.OrdinalIgnoreCase))
            {
                return "var(--mf-investments)";
            }

            if (path.StartsWith("/settings/accounts", StringComparison.OrdinalIgnoreCase))
            {
                return "var(--mf-accounts)";
            }

            if (path.StartsWith("/settings/categories", StringComparison.OrdinalIgnoreCase))
            {
                return "var(--mf-amber-500)";
            }

            if (path.StartsWith("/settings", StringComparison.OrdinalIgnoreCase))
            {
                return "var(--mf-nav-settings)";
            }

            if (path.StartsWith("/investments", StringComparison.OrdinalIgnoreCase))
            {
                return "var(--mf-investments)";
            }

            if (path.StartsWith("/operations", StringComparison.OrdinalIgnoreCase))
            {
                return "var(--mf-amber-500)";
            }

            if (path.StartsWith("/accounts", StringComparison.OrdinalIgnoreCase))
            {
                return "var(--mf-accounts)";
            }

            return "var(--mf-link)";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Appearance.EnsureLoadedAsync();
        Appearance.Changed += OnAppearanceChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnAppearanceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Appearance.Changed -= OnAppearanceChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private static bool IsAccountsPath(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/');
        return path.Equals("/accounts", StringComparison.OrdinalIgnoreCase) ||
               path.StartsWith("/accounts/", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsSettingsPath(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/');
        return path.Equals("/settings", StringComparison.OrdinalIgnoreCase) ||
               path.StartsWith("/settings/", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsOperationsPath(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/');
        return path.Equals("/operations", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsInvestmentsPath(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/');
        return path.StartsWith("/investments", StringComparison.OrdinalIgnoreCase);
    }
}
