@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using MiddiFranchi.Web.Components.Shared
@inject NavigationManager Navigation
@inject SectionAppearanceService Appearance

<div class="page nav-collapsed" id="mf-page" style="@PageStyle">
    <aside class="app-sidebar" id="mf-sidebar">
        <div class="sidebar-top">
            <a class="brand-mark" href="" title="MiddiFranchi" aria-label="MiddiFranchi, vai alla dashboard">
                <MfIcon Name="coin" Size="20" />
            </a>
            <span class="brand-name nav-label">MiddiFranchi</span>
            <button type="button" class="sidebar-collapse" onclick="mfToggleNavCollapsed()"
                    title="Espandi o comprimi il menu" aria-label="Espandi o comprimi il menu di navigazione">
                <MfIcon Name="arrow-right" Size="15" />
            </button>
            <button type="button" class="sidebar-close" onclick="mfCloseNav()" aria-label="Chiudi il menu di navigazione">
                <MfIcon Name="close" Size="18" />
            </button>
        </div>
        <nav class="sidebar-nav" aria-label="Navigazione principale">
            <div class="sidebar-group">
                <NavLink href="" class="nav-home" Match="NavLinkMatch.All" title="Dashboard" aria-label="Dashboard"><MfIcon Name="@Appearance.Get(AppSection.Dashboard).Icon" Size="20" /><span class="nav-label">Dashboard</span></NavLink>
                <NavLink href="accounts" class="nav-accounts" Match="NavLinkMatch.Prefix" title="Conti" aria-label="Conti"><MfIcon Name="@Appearance.Get(AppSection.Accounts).Icon" Size="20" /><span class="nav-label">Conti</span></NavLink>
                <NavLink href="investments" class="nav-investments" Match="NavLinkMatch.All" title="Investimenti" aria-label="Investimenti"><MfIcon Name="@Appearance.Get(AppSection.Investments).Icon" Size="20" /><span class="nav-label">Investimenti</span></NavLink>
                <NavLink href="operations" class="nav-operations" Match="NavLinkMatch.All" title="Movimenti" aria-label="Movimenti"><MfIcon Name="@Appearance.Get(AppSection.Operations).Icon" Size="20" /><span class="nav-label">Movimenti</span></NavLink>
            </div>
            <div class="sidebar-group sidebar-group-bottom">
                <NavLink href="settings" class="nav-settings" Match="NavLinkMatch.Prefix" title="Configurazione" aria-label="Configurazione"><MfIcon Name="@Appearance.Get(AppSection.Settings).Icon" Size="20" /><span class="nav-label">Configurazione</span></NavLink>
            </div>
        </nav>
    </aside>
    <button type="button" class="sidebar-backdrop" onclick="mfCloseNav()" aria-label="Chiudi il menu di navigazione"></button>
    <div class="app-main">
        <div class="mobile-app-bar">
            <button type="button" class="icon-button menu-toggle" onclick="mfToggleNav()"
                    aria-label="Apri il menu di navigazione" aria-expanded="false" aria-controls="mf-sidebar">
                <MfIcon Name="menu" Size="20" />
            </button>
            <a class="mobile-brand" href="" aria-label="MiddiFranchi, vai alla dashboard">
                <MfIcon Name="coin" Size="18" />
                <span>MiddiFranchi</span>
            </a>
        </div>
        <main class="page-body">
            @Body
        </main>
        <div id="mf-toast-host" class="toast-stack" aria-live="polite" aria-atomic="false"></div>
        @if (!IsAccountsSection && !IsSettingsSection && !IsOperationsSection && !IsInvestmentsSection)
        {
            <a class="fab-add" href="operations?new=1" aria-label="Nuova operazione">
                <MfIcon Name="plus" Size="24" />
            </a>
        }
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Si è verificato un errore imprevisto.
    <a href="." class="reload">Ricarica</a>
    <span class="dismiss" role="button" tabindex="0" aria-label="Nascondi il messaggio di errore">🗙</span>
</div>

@code {
    private bool IsAccountsSection => IsAccountsPath(Navigation.Uri);
    private bool IsSettingsSection => IsSettingsPath(Navigation.Uri);
    private bool IsOperationsSection => IsOperationsPath(Navigation.Uri);
    private bool IsInvestmentsSection => IsInvestmentsPath(Navigation.Uri);

    private string PageStyle => $"{Appearance.CssVariables}--mf-sort-color:{SortColor};";

    private string SortColor
    {
        get
        {
            var path = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
            if (path.StartsWith("/settings/instruments", StringComparison.OrdinalIgnoreCase) ||
                path.StartsWith("/settings/price-updates", StringComparison.OrdinalIgnoreCase))
            {
                return "var(--mf-investments)";
            }

            if (path.StartsWith("/settings/accounts", StringComparison.OrdinalIgnoreCase))
            {
                return "var(--mf-accounts)";
            }

            if (path.StartsWith("/settings/categories", StringComparison.OrdinalIgnoreCase))
            {
                return "var(--mf-amber-500)";
            }

            if (path.StartsWith("/settings", StringComparison.OrdinalIgnoreCase))
            {
                return "var(--mf-nav-settings)";
            }

            if (path.StartsWith("/investments", StringComparison.OrdinalIgnoreCase))
            {
                return "var(--mf-investments)";
            }

            if (path.StartsWith("/operations", StringComparison.OrdinalIgnoreCase))
            {
                return "var(--mf-amber-500)";
            }

            if (path.StartsWith("/accounts", StringComparison.OrdinalIgnoreCase))
            {
                return "var(--mf-accounts)";
            }

            return "var(--mf-link)";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Appearance.EnsureLoadedAsync();
        Appearance.Changed += OnAppearanceChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnAppearanceChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Appearance.Changed -= OnAppearanceChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    private static bool IsAccountsPath(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/');
        return path.Equals("/accounts", StringComparison.OrdinalIgnoreCase) ||
               path.StartsWith("/accounts/", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsSettingsPath(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/');
        return path.Equals("/settings", StringComparison.OrdinalIgnoreCase) ||
               path.StartsWith("/settings/", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsOperationsPath(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/');
        return path.Equals("/operations", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsInvestmentsPath(string uri)
    {
        var path = new Uri(uri).AbsolutePath.TrimEnd('/');
        return path.StartsWith("/investments", StringComparison.OrdinalIgnoreCase);
    }
}

