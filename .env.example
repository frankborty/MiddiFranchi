# Copiare in .env (ignorato da git) per docker compose locale.
# In Portainer impostare le stesse variabili nella sezione "Environment variables".

# Registry Docker: usare l'endpoint del Docker Registry, non l'eventuale UI web.
# Formato: <registry-host>:<porta>/middifranchi:<tag>
MIDDIFRANCHI_IMAGE=registry.example.com:5000/middifranchi:1.0.0

# Porta host. Per esporre solo in locale: 127.0.0.1:8080
MIDDIFRANCHI_PORT=8080

# PostgreSQL.
# Se il DB è installato sull'host Docker:
#   Host=host.docker.internal;Port=5432;Database=middifranchi;Username=middifranchi;Password=...
# Se il DB è un container sulla stessa rete Docker:
#   Host=<nome-container-o-servizio>;Port=5432;...
# Se il DB è su un'altra macchina:
#   Host=<ip-o-dns>;Port=5432;...
DB_CONNECTION_STRING=Host=host.docker.internal;Port=5432;Database=middifranchi;Username=middifranchi;Password=change-me

# true = applica le migrazioni EF all'avvio.
# false = lo schema è gestito separatamente (utente DB senza permessi DDL).
DB_MIGRATE_ON_STARTUP=true
